# PostgreSQL
POSTGRES_USER=heartstone
POSTGRES_PASSWORD=heartstone_dev_password
POSTGRES_DB=heartstone

# Redis
REDIS_PASSWORD=

# HeartStone API
API_PORT=8000
APP_NAME=HeartStone API
APP_VERSION=0.1.0
POSTGRES_HOST=heartstone-postgres
POSTGRES_PORT=5432
REDIS_HOST=heartstone-redis
REDIS_PORT=6379
# Application
PORT=3000

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
NODE_ENV=development

# PostgreSQL
DATABASE_URL=postgresql://heartstone:heartstone@localhost:5432/heartstone?schema=public
NODE_ENV=development
PORT=3000
APP_NAME=heartstone-backend
API_VERSION=v1
BUILD_VERSION=

# Security baseline
CORS_ENABLED=true
# Comma-separated origins. Leave empty in development to allow localhost defaults.
# Never use * in production.
CORS_ORIGINS=
CORS_CREDENTIALS=false
JSON_BODY_LIMIT=100kb
# Defaults to enabled outside production when unset.
SWAGGER_ENABLED=
TRUST_PROXY=false

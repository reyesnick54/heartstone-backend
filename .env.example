# Application
NODE_ENV=development
PORT=3000
APP_NAME=heartstone-backend
API_VERSION=v1
BUILD_VERSION=

# PostgreSQL
POSTGRES_USER=heartstone
POSTGRES_PASSWORD=heartstone_dev_password
POSTGRES_DB=heartstone
POSTGRES_PORT=5432
DATABASE_URL=postgresql://heartstone:heartstone_dev_password@localhost:5432/heartstone?schema=public

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Security baseline
CORS_ENABLED=true
# Comma-separated origins. Leave empty in development to allow localhost defaults.
# Never use * in production.
CORS_ORIGINS=
CORS_CREDENTIALS=false
JSON_BODY_LIMIT=100kb
# Defaults to enabled outside production when unset.
SWAGGER_ENABLED=
TRUST_PROXY=false

# Identity & Access (Phase 3)
SESSION_TTL_SECONDS=3600
SESSION_TOKEN_BYTES=32
SESSION_RENEWAL_THRESHOLD_SECONDS=900
# Local password auth is enabled by default in development/test only.
AUTH_LOCAL_PASSWORD_ENABLED=
SESSION_ABSOLUTE_TTL_SECONDS=43200
SESSION_IDLE_TIMEOUT_SECONDS=1800
MAX_ACTIVE_SESSIONS_PER_ACCOUNT=10
AUTH_LOCKOUT_MAX_ATTEMPTS=5
AUTH_LOCKOUT_DURATION_SECONDS=900
STEP_UP_MAX_AUTHENTICATION_AGE_SECONDS=900
# Production requires OIDC_ENABLED=true and OIDC_PROVIDERS_JSON (see env.validation).
OIDC_ENABLED=false
OIDC_PROVIDERS_JSON=
SERVICE_CREDENTIAL_PEPPER=

# Service Catalog (Phase 5)
# Comma-separated identity IDs authorized to manage eligibility rules.
SERVICE_CATALOG_ADMIN_IDENTITY_IDS=

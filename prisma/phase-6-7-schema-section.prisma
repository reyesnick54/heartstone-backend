  documentRecord           DocumentRecord?   @relation(fields: [documentRecordId], references: [id])
  evidenceRecord           EvidenceRecord?   @relation(fields: [evidenceRecordId], references: [id])
  evidencePacket           EvidencePacket?   @relation(fields: [evidencePacketId], references: [id])

  @@index([legalHoldId])
  @@index([targetType])
  @@map("legal_hold_targets")
}

model PreservationCollection {
  id            String                       @id @default(uuid()) @db.Uuid
  legalHoldId   String                       @db.Uuid
  collectionReference String                 @unique
  status        PreservationCollectionStatus @default(ACTIVE)
  description   String?
  createdAt     DateTime                     @default(now())
  updatedAt     DateTime                     @updatedAt
  legalHold     LegalHold                    @relation(fields: [legalHoldId], references: [id], onDelete: Cascade)
  archivalTransfers ArchivalTransfer[]

  @@index([legalHoldId])
  @@index([status])
  @@map("preservation_collections")
}

model ArchivalTransfer {
  id                       String                 @id @default(uuid()) @db.Uuid
  transferReference        String                 @unique
  preservationCollectionId String?                @db.Uuid
  status                   ArchivalTransferStatus @default(PENDING)
  sourceLocationRef        String?
  destinationLocationRef   String?
  transferredAt            DateTime?
  receivedAt               DateTime?
  createdAt                DateTime               @default(now())
  updatedAt                DateTime               @updatedAt
  preservationCollection   PreservationCollection? @relation(fields: [preservationCollectionId], references: [id])

  @@index([preservationCollectionId])
  @@index([status])
  @@map("archival_transfers")
}

model RecordDispositionRequest {
  id                        String                  @id @default(uuid()) @db.Uuid
  requestReference          String                  @unique
  recordRetentionAssignmentId String                @db.Uuid
  status                    RecordDispositionStatus @default(DRAFT)
  requestedAction           RetentionDispositionAction
  reason                    String
  requestedByIdentityId     String?                 @db.Uuid
  approvedByIdentityId      String?                 @db.Uuid
  requestedAt               DateTime                @default(now())
  approvedAt                DateTime?
  createdAt                 DateTime                @default(now())
  updatedAt                 DateTime                @updatedAt
  recordRetentionAssignment RecordRetentionAssignment @relation(fields: [recordRetentionAssignmentId], references: [id])
  dispositionRecord         RecordDispositionRecord?

  @@index([recordRetentionAssignmentId])
  @@index([status])
  @@map("record_disposition_requests")
}

model RecordDispositionRecord {
  id                       String                  @id @default(uuid()) @db.Uuid
  recordDispositionRequestId String                @unique @db.Uuid
  dispositionReference     String                  @unique
  status                   RecordDispositionStatus @default(EXECUTED)
  executedAt               DateTime                @default(now())
  executedByIdentityId     String?                 @db.Uuid
  executionNotes           String?
  createdAt                DateTime                @default(now())
  recordDispositionRequest RecordDispositionRequest @relation(fields: [recordDispositionRequestId], references: [id], onDelete: Cascade)

  @@map("record_disposition_records")
}

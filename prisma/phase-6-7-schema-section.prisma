model Application {
  id                         String              @id @default(uuid()) @db.Uuid
  applicationNumber          String?             @unique
  applicantIdentityId        String              @db.Uuid
  organizationId             String?             @db.Uuid
  representativeAuthorityId  String?             @db.Uuid
  governmentServiceId        String              @db.Uuid
  governmentServiceVersionId String              @db.Uuid
  formDefinitionId           String              @db.Uuid
  formVersionId              String              @db.Uuid
  configurationFingerprint   String
  applicantCategory          ApplicantCategory
  status                     ApplicationStatus   @default(DRAFT)
  draftAnswers               Json                @default("{}")
  idempotencyKey             String?
  createdAt                  DateTime            @default(now())
  updatedAt                  DateTime            @updatedAt
  applicantIdentity          Identity            @relation("ApplicationApplicant", fields: [applicantIdentityId], references: [id])
  organization               Organization?       @relation(fields: [organizationId], references: [id])
  representativeAuthority    RepresentativeAuthority? @relation(fields: [representativeAuthorityId], references: [id])
  governmentService          GovernmentService   @relation(fields: [governmentServiceId], references: [id])
  governmentServiceVersion   GovernmentServiceVersion @relation(fields: [governmentServiceVersionId], references: [id])
  formDefinition             FormDefinition      @relation(fields: [formDefinitionId], references: [id])
  formVersion                FormVersion         @relation(fields: [formVersionId], references: [id])
  submissions                ApplicationSubmission[]
  case                       Case?

  @@unique([applicantIdentityId, idempotencyKey])
  @@index([applicantIdentityId])
  @@index([governmentServiceId])
  @@index([governmentServiceVersionId])
  @@index([status])
  @@map("applications")
}

model ApplicationSubmission {
  id                         String                      @id @default(uuid()) @db.Uuid
  applicationId              String                      @db.Uuid
  submissionNumber           String                      @unique
  sequenceNumber             Int
  status                     ApplicationSubmissionStatus @default(SUBMITTED)
  answersSnapshot            Json
  configurationFingerprint   String
  governmentServiceVersionId String                      @db.Uuid
  formVersionId              String                      @db.Uuid
  submittedAt                DateTime                    @default(now())
  acknowledgedAt             DateTime?
  acknowledgmentReference    String?                     @unique
  contentHash                String
  supersededAt               DateTime?
  createdAt                  DateTime                    @default(now())
  application                Application                 @relation(fields: [applicationId], references: [id])
  governmentServiceVersion   GovernmentServiceVersion    @relation(fields: [governmentServiceVersionId], references: [id])
  formVersion                FormVersion                 @relation(fields: [formVersionId], references: [id])
  completenessReviews        CompletenessReview[]
  deficiencyNotices          DeficiencyNotice[]
  applicantInformationRequests ApplicantInformationRequest[]

  @@unique([applicationId, sequenceNumber])
  @@index([applicationId])
  @@index([status])
  @@map("application_submissions")
}

model Case {
  id                                String           @id @default(uuid()) @db.Uuid
  caseNumber                        String           @unique
  applicationId                     String           @unique @db.Uuid
  applicantIdentityId               String           @db.Uuid
  governmentServiceId               String           @db.Uuid
  governmentServiceVersionId        String           @db.Uuid
  workflowVersionId                 String           @db.Uuid
  configurationFingerprint          String
  responsibleInstitutionId          String           @db.Uuid
  responsibleDepartmentId           String           @db.Uuid
  status                            CaseStatus       @default(RECEIVED)
  legalStatus                       CaseLegalStatus  @default(NONE)
  legalStatusLabel                  String?
  priority                          CasePriority     @default(NORMAL)
  version                           Int              @default(1)
  openedAt                          DateTime         @default(now())
  closedAt                          DateTime?
  currentCaseManagerOfficeholderId  String?          @db.Uuid
  masterAdministrativeFileReference String?
  documentRegisterReference         String?
  evidencePacketReference           String?
  recordsClassificationReference    String?
  retentionLegalHoldReference       String?
  createdAt                         DateTime         @default(now())
  updatedAt                         DateTime         @updatedAt
  application                       Application      @relation(fields: [applicationId], references: [id])
  applicantIdentity                 Identity         @relation("CaseApplicant", fields: [applicantIdentityId], references: [id])
  governmentService                 GovernmentService @relation(fields: [governmentServiceId], references: [id])
  governmentServiceVersion          GovernmentServiceVersion @relation(fields: [governmentServiceVersionId], references: [id])
  workflowVersion                   WorkflowVersion  @relation(fields: [workflowVersionId], references: [id])
  responsibleInstitution            Institution      @relation(fields: [responsibleInstitutionId], references: [id])
  responsibleDepartment             Department       @relation(fields: [responsibleDepartmentId], references: [id])
  currentCaseManagerOfficeholder    Officeholder?    @relation("CaseManager", fields: [currentCaseManagerOfficeholderId], references: [id])
  statusHistory                     CaseStatusHistory[]
  workflowInstance                  CaseWorkflowInstance?
  assignments                       CaseAssignment[]
  referrals                         CaseReferral[]
  slaClocks                         CaseSlaClock[]
  escalations                       CaseEscalation[]
  issues                            CaseIssue[]
  events                            CaseEvent[]
  communications                    CaseCommunication[]
  milestones                        CaseMilestone[]
  publicStatusProjection            CasePublicStatusProjection?
  masterAdministrativeFile          MasterAdministrativeFile?

  @@index([applicantIdentityId])
  @@index([governmentServiceId])
  @@index([responsibleDepartmentId])
  @@index([status])
  @@index([governmentServiceVersionId])
  @@index([workflowVersionId])
  @@index([currentCaseManagerOfficeholderId])
  @@map("cases")
}

model CaseStatusHistory {
  id              String      @id @default(uuid()) @db.Uuid
  caseId          String      @db.Uuid
  fromStatus      CaseStatus?
  toStatus        CaseStatus
  reason          String?
  actorIdentityId String?     @db.Uuid
  recordedAt      DateTime    @default(now())
  case            Case        @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId])
  @@index([recordedAt])
  @@map("case_status_history")
}

model WorkflowDefinition {
  id                  String                   @id @default(uuid()) @db.Uuid
  code                String                   @unique
  name                String
  description         String?
  governmentServiceId String?                  @db.Uuid
  status              WorkflowDefinitionStatus @default(DRAFT)
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
  governmentService   GovernmentService?       @relation(fields: [governmentServiceId], references: [id])
  versions            WorkflowVersion[]

  @@index([governmentServiceId])
  @@index([status])
  @@map("workflow_definitions")
}

model WorkflowVersion {
  id                   String                         @id @default(uuid()) @db.Uuid
  workflowDefinitionId String                         @db.Uuid
  version              String
  status               WorkflowVersionStatus          @default(DRAFT)
  approvedAt           DateTime?
  supersededAt         DateTime?
  supersededById       String?                        @db.Uuid
  createdAt            DateTime                       @default(now())
  updatedAt            DateTime                       @updatedAt
  workflowDefinition   WorkflowDefinition             @relation(fields: [workflowDefinitionId], references: [id])
  supersededBy         WorkflowVersion?               @relation("WorkflowVersionSupersession", fields: [supersededById], references: [id])
  supersedes           WorkflowVersion[]              @relation("WorkflowVersionSupersession")
  stages               WorkflowStageDefinition[]
  steps                WorkflowStepDefinition[]
  transitions          WorkflowTransitionDefinition[]
  caseInstances        CaseWorkflowInstance[]
  cases                Case[]

  @@unique([workflowDefinitionId, version])
  @@index([workflowDefinitionId])
  @@index([status])
  @@map("workflow_versions")
}

model WorkflowStageDefinition {
  id                String                   @id @default(uuid()) @db.Uuid
  workflowVersionId String                   @db.Uuid
  stageKey          String
  label             String
  description       String?
  displayOrder      Int
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  workflowVersion   WorkflowVersion          @relation(fields: [workflowVersionId], references: [id], onDelete: Cascade)
  steps             WorkflowStepDefinition[]

  @@unique([workflowVersionId, stageKey])
  @@index([workflowVersionId])
  @@map("workflow_stage_definitions")
}

model WorkflowStepDefinition {
  id                        String                         @id @default(uuid()) @db.Uuid
  workflowVersionId         String                         @db.Uuid
  workflowStageDefinitionId String?                        @db.Uuid
  stepKey                   String
  label                     String
  description               String?
  stepType                  WorkflowStepType
  consequenceLevel          WorkflowStepConsequenceLevel   @default(ADMINISTRATIVE)
  functionAuthorityRecordId String?                        @db.Uuid
  authorityActionType       AuthorityActionType?
  displayOrder              Int
  isParallel                Boolean                        @default(false)
  parallelGroupKey          String?
  joinType                  WorkflowTransitionJoinType?
  configuration             Json                           @default("{}")
  createdAt                 DateTime                       @default(now())
  updatedAt                 DateTime                       @updatedAt
  workflowVersion           WorkflowVersion                @relation(fields: [workflowVersionId], references: [id], onDelete: Cascade)
  workflowStageDefinition   WorkflowStageDefinition?       @relation(fields: [workflowStageDefinitionId], references: [id])
  functionAuthorityRecord   FunctionAuthorityRecord?       @relation(fields: [functionAuthorityRecordId], references: [id])
  outgoingTransitions       WorkflowTransitionDefinition[] @relation("TransitionFromStep")
  incomingTransitions       WorkflowTransitionDefinition[] @relation("TransitionToStep")
  stepInstances             CaseWorkflowStepInstance[]

  @@unique([workflowVersionId, stepKey])
  @@index([workflowVersionId])
  @@index([functionAuthorityRecordId])
  @@map("workflow_step_definitions")
}

model WorkflowTransitionDefinition {
  id                String                     @id @default(uuid()) @db.Uuid
  workflowVersionId String                     @db.Uuid
  fromStepId        String                     @db.Uuid
  toStepId          String                     @db.Uuid
  transitionKey     String
  label             String?
  joinType          WorkflowTransitionJoinType @default(ALL_REQUIRED)
  isDefault         Boolean                    @default(false)
  conditionConfig   Json                       @default("{}")
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt
  workflowVersion   WorkflowVersion            @relation(fields: [workflowVersionId], references: [id], onDelete: Cascade)
  fromStep          WorkflowStepDefinition     @relation("TransitionFromStep", fields: [fromStepId], references: [id], onDelete: Cascade)
  toStep            WorkflowStepDefinition     @relation("TransitionToStep", fields: [toStepId], references: [id], onDelete: Cascade)

  @@unique([workflowVersionId, transitionKey])
  @@index([workflowVersionId])
  @@index([fromStepId])
  @@index([toStepId])
  @@map("workflow_transition_definitions")
}

model CaseWorkflowInstance {
  id                  String                     @id @default(uuid()) @db.Uuid
  caseId              String                     @unique @db.Uuid
  workflowVersionId   String                     @db.Uuid
  status              CaseWorkflowInstanceStatus @default(PENDING)
  currentStepKeys     String[]                   @default([])
  currentStageKey     String?
  currentStageLabel   String?
  startedAt           DateTime?
  completedAt         DateTime?
  pausedAt            DateTime?
  haltedAt            DateTime?
  haltReason          String?
  safeHaltActive      Boolean                    @default(false)
  safeHaltPublicLabel String?
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt
  case                Case                       @relation(fields: [caseId], references: [id], onDelete: Cascade)
  workflowVersion     WorkflowVersion            @relation(fields: [workflowVersionId], references: [id])
  stepInstances       CaseWorkflowStepInstance[]
  events              CaseEvent[]

  @@index([workflowVersionId])
  @@index([status])
  @@map("case_workflow_instances")
}

model CaseWorkflowStepInstance {
  id                       String                         @id @default(uuid()) @db.Uuid
  caseWorkflowInstanceId   String                         @db.Uuid
  workflowStepDefinitionId String                         @db.Uuid
  status                   CaseWorkflowStepInstanceStatus @default(PENDING)
  parallelGroupKey         String?
  startedAt                DateTime?
  completedAt              DateTime?
  completedByIdentityId    String?                        @db.Uuid
  outcome                  String?
  failureReason            String?
  version                  Int                            @default(1)
  createdAt                DateTime                       @default(now())
  updatedAt                DateTime                       @updatedAt
  caseWorkflowInstance     CaseWorkflowInstance           @relation(fields: [caseWorkflowInstanceId], references: [id], onDelete: Cascade)
  workflowStepDefinition   WorkflowStepDefinition         @relation(fields: [workflowStepDefinitionId], references: [id])
  completenessReviews      CompletenessReview[]
  events                   CaseEvent[]

  @@unique([caseWorkflowInstanceId, workflowStepDefinitionId])
  @@index([caseWorkflowInstanceId])
  @@index([status])
  @@map("case_workflow_step_instances")
}

model CompletenessReview {
  id                         String                    @id @default(uuid()) @db.Uuid
  applicationSubmissionId    String                    @db.Uuid
  caseWorkflowStepInstanceId String?                   @db.Uuid
  reviewerIdentityId         String?                   @db.Uuid
  outcome                    CompletenessReviewOutcome @default(PENDING)
  checklistResults           Json                      @default("[]")
  notes                      String?
  reviewedAt                 DateTime?
  createdAt                  DateTime                  @default(now())
  updatedAt                  DateTime                  @updatedAt
  applicationSubmission      ApplicationSubmission     @relation(fields: [applicationSubmissionId], references: [id])
  caseWorkflowStepInstance   CaseWorkflowStepInstance? @relation(fields: [caseWorkflowStepInstanceId], references: [id])
  deficiencyNotices          DeficiencyNotice[]

  @@index([applicationSubmissionId])
  @@index([outcome])
  @@map("completeness_reviews")
}

model DeficiencyNotice {
  id                      String                 @id @default(uuid()) @db.Uuid
  applicationSubmissionId String                 @db.Uuid
  completenessReviewId    String?                @db.Uuid
  status                  DeficiencyNoticeStatus @default(ISSUED)
  missingItems            Json                   @default("[]")
  instructions            String
  issuedAt                DateTime               @default(now())
  respondedAt             DateTime?
  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt
  applicationSubmission   ApplicationSubmission  @relation(fields: [applicationSubmissionId], references: [id])
  completenessReview      CompletenessReview?    @relation(fields: [completenessReviewId], references: [id])

  @@index([applicationSubmissionId])
  @@index([status])
  @@map("deficiency_notices")
}

model ApplicantInformationRequest {
  id                      String                            @id @default(uuid()) @db.Uuid
  applicationSubmissionId String                            @db.Uuid
  status                  ApplicantInformationRequestStatus @default(ISSUED)
  requestedItems          Json                              @default("[]")
  instructions            String
  issuedAt                DateTime                          @default(now())
  respondedAt             DateTime?
  expiresAt               DateTime?
  createdAt               DateTime                          @default(now())
  updatedAt               DateTime                          @updatedAt
  applicationSubmission   ApplicationSubmission             @relation(fields: [applicationSubmissionId], references: [id])

  @@index([applicationSubmissionId])
  @@index([status])
  @@map("applicant_information_requests")
}

model CaseAssignment {
  id                     String               @id @default(uuid()) @db.Uuid
  caseId                 String               @db.Uuid
  assigneeIdentityId     String               @db.Uuid
  assigneeOfficeholderId String?              @db.Uuid
  status                 CaseAssignmentStatus @default(ACTIVE)
  assignmentRole         String
  assignedAt             DateTime             @default(now())
  supersededAt           DateTime?
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt
  case                   Case                 @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId])
  @@index([assigneeIdentityId])
  @@index([status])
  @@map("case_assignments")
}

model CaseReferral {
  id                    String                 @id @default(uuid()) @db.Uuid
  caseId                String                 @db.Uuid
  referralType          CaseReferralType
  status                CaseReferralStatus     @default(PENDING)
  externalAuthorityId   String?                @db.Uuid
  institutionId         String?                @db.Uuid
  authorityDependencyId String?                @db.Uuid
  referralBasis         String?
  scope                 String?
  referredAt            DateTime               @default(now())
  acknowledgedAt        DateTime?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  case                  Case                   @relation(fields: [caseId], references: [id], onDelete: Cascade)
  externalAuthority     ExternalAuthority?     @relation(fields: [externalAuthorityId], references: [id])
  institution           Institution?           @relation(fields: [institutionId], references: [id])
  authorityDependency   AuthorityDependency?   @relation(fields: [authorityDependencyId], references: [id])
  responses             CaseReferralResponse[]

  @@index([caseId])
  @@index([status])
  @@map("case_referrals")
}

model CaseReferralResponse {
  id                   String                         @id @default(uuid()) @db.Uuid
  caseReferralId       String                         @db.Uuid
  responseReference    String
  responseSummary      String
  authenticationStatus CaseReferralResponseAuthStatus @default(UNAUTHENTICATED)
  receivedAt           DateTime                       @default(now())
  satisfiesDependency  Boolean                        @default(false)
  createdAt            DateTime                       @default(now())
  updatedAt            DateTime                       @updatedAt
  caseReferral         CaseReferral                   @relation(fields: [caseReferralId], references: [id], onDelete: Cascade)

  @@index([caseReferralId])
  @@map("case_referral_responses")
}

model CaseSlaClock {
  id               String             @id @default(uuid()) @db.Uuid
  caseId           String             @db.Uuid
  clockKey         String
  status           CaseSlaClockStatus @default(RUNNING)
  startedAt        DateTime           @default(now())
  pausedAt         DateTime?
  resumedAt        DateTime?
  breachedAt       DateTime?
  completedAt      DateTime?
  targetDurationMs Int?
  elapsedMs        Int                @default(0)
  pausedDurationMs Int                @default(0)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  case             Case               @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@unique([caseId, clockKey])
  @@index([caseId])
  @@index([status])
  @@map("case_sla_clocks")
}

model CaseEscalation {
  id               String               @id @default(uuid()) @db.Uuid
  caseId           String               @db.Uuid
  status           CaseEscalationStatus @default(OPEN)
  reason           String
  escalatedAt      DateTime             @default(now())
  resolvedAt       DateTime?
  retainsAuthority Boolean              @default(true)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  case             Case                 @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId])
  @@index([status])
  @@map("case_escalations")
}

model CaseIssue {
  id          String            @id @default(uuid()) @db.Uuid
  caseId      String            @db.Uuid
  severity    CaseIssueSeverity @default(MEDIUM)
  status      CaseIssueStatus   @default(OPEN)
  title       String
  description String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  resolvedAt  DateTime?
  case        Case              @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId])
  @@index([status])
  @@map("case_issues")
}

model CaseEvent {
  id                 String                    @id @default(uuid()) @db.Uuid
  caseId             String                    @db.Uuid
  eventType          CaseEventType
  payload            Json                      @default("{}")
  metadata           Json                      @default("{}")
  actorIdentityId    String?                   @db.Uuid
  officeholderId     String?                   @db.Uuid
  institutionId      String?                   @db.Uuid
  departmentId       String?                   @db.Uuid
  workflowInstanceId String?                   @db.Uuid
  stepInstanceId     String?                   @db.Uuid
  correlationId      String?
  occurredAt         DateTime                  @default(now())
  recordedAt         DateTime                  @default(now())
  publicVisibility   CaseEventPublicVisibility @default(INTERNAL)
  createdAt          DateTime                  @default(now())
  case               Case                      @relation(fields: [caseId], references: [id], onDelete: Cascade)
  actorIdentity      Identity?                 @relation("CaseEventActor", fields: [actorIdentityId], references: [id])
  officeholder       Officeholder?             @relation("CaseEventOfficeholder", fields: [officeholderId], references: [id])

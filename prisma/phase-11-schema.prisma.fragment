// Phase 11: Financial Administration, Notifications and Government Integrations
// Append to schema.prisma

// ─── Phase 11A: Fee Schedules and Assessment ───────────────────────────────

enum FeeScheduleStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  ACTIVE
  SUPERSEDED
  RETIRED
}

enum FeeAssessmentStatus {
  CALCULATED
  INVOICED
  WAIVED
  ADJUSTED
  SUPERSEDED
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
  WRITTEN_OFF
}

enum FinancialApprovalType {
  FEE_SCHEDULE_ACTIVATION
  FEE_WAIVER
  FEE_ADJUSTMENT
  REFUND_AUTHORIZATION
  RECONCILIATION_CLOSURE
  ARREARS_ACTION
}

enum FinancialApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  SUPERSEDED
}

// ─── Phase 11B: Payments ─────────────────────────────────────────────────────

enum PaymentChannelType {
  CARD
  BANK_TRANSFER
  CASH_COUNTER
  GOVERNMENT_TREASURY
  MOBILE_WALLET
  OTHER
}

enum PaymentIntentStatus {
  CREATED

  PROCESSING
  SUCCEEDED
  FAILED
  CANCELLED
  EXPIRED
}

enum PaymentTransactionStatus {
  PENDING
  AUTHORIZED
  SETTLED
  FAILED
  REVERSED
  CHARGEBACK
}

enum PaymentWebhookProcessingStatus {
  RECEIVED
  AUTHENTICATED
  PROCESSED
  DUPLICATE
  REJECTED
  FAILED
}

// ─── Phase 11C: Refunds, Adjustments, Reconciliation ─────────────────────────

enum FeeAdjustmentRequestStatus {
  PENDING
  DECIDED

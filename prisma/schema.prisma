model Application {
  id                         String                    @id @default(uuid()) @db.Uuid
  applicationNumber          String?                   @unique
  applicantIdentityId        String                    @db.Uuid
  organizationId             String?                   @db.Uuid
  representativeAuthorityId  String?                   @db.Uuid
  governmentServiceId        String                    @db.Uuid
  governmentServiceVersionId String                    @db.Uuid
  formDefinitionId           String                    @db.Uuid
  formVersionId              String                    @db.Uuid
  configurationFingerprint   String
  applicantCategory          ApplicantCategory
  status                     ApplicationStatus         @default(DRAFT)
  draftAnswers               Json                      @default("{}")
  idempotencyKey             String?
  createdAt                  DateTime                  @default(now())
  updatedAt                  DateTime                  @updatedAt
  applicantIdentity          Identity                  @relation(fields: [applicantIdentityId], references: [id])
  organization               Organization?             @relation(fields: [organizationId], references: [id])
  representativeAuthority    RepresentativeAuthority?  @relation(fields: [representativeAuthorityId], references: [id])
  governmentService          GovernmentService         @relation(fields: [governmentServiceId], references: [id])
  governmentServiceVersion   GovernmentServiceVersion  @relation(fields: [governmentServiceVersionId], references: [id])
  formDefinition             FormDefinition            @relation(fields: [formDefinitionId], references: [id])
  formVersion                FormVersion               @relation(fields: [formVersionId], references: [id])
  submissions                ApplicationSubmission[]
  case                       Case?
  masterAdministrativeFile   MasterAdministrativeFile?
  feeAssessments             FeeAssessment[]
  serviceAppointments        ServiceAppointment[]
  civilRegistryEventSubmissions CivilRegistryEventSubmission[]
  visaApplicationProfile     VisaApplicationProfile?
  residencyApplicationProfile ResidencyApplicationProfile?
  citizenshipApplicationProfile CitizenshipApplicationProfile?
  vitalEvents                VitalEvent[]
  workPermitApplicationProfile WorkPermitApplicationProfile?
  driverLicenseApplicationProfile DriverLicenseApplicationProfile?

  @@unique([applicantIdentityId, idempotencyKey])
  @@index([applicantIdentityId])
  @@index([governmentServiceId])
  @@index([governmentServiceVersionId])
  @@index([status])
  @@map("applications")
}

model ApplicationSubmission {
  id                           String                        @id @default(uuid()) @db.Uuid
  applicationId                String                        @db.Uuid
  submissionNumber             String                        @unique
  sequenceNumber               Int
  status                       ApplicationSubmissionStatus   @default(SUBMITTED)
  answersSnapshot              Json
  configurationFingerprint     String
  governmentServiceVersionId   String                        @db.Uuid
  formVersionId                String                        @db.Uuid
  submittedAt                  DateTime                      @default(now())
  acknowledgedAt               DateTime?
  acknowledgmentReference      String?                       @unique
  contentHash                  String
  supersededAt                 DateTime?
  createdAt                    DateTime                      @default(now())
  application                  Application                   @relation(fields: [applicationId], references: [id])
  governmentServiceVersion     GovernmentServiceVersion      @relation(fields: [governmentServiceVersionId], references: [id])
  formVersion                  FormVersion                   @relation(fields: [formVersionId], references: [id])
  completenessReviews          CompletenessReview[]
  deficiencyNotices            DeficiencyNotice[]
  applicantInformationRequests ApplicantInformationRequest[]

  @@unique([applicationId, sequenceNumber])
  @@index([applicationId])
  @@index([status])
  @@map("application_submissions")
}

model Case {

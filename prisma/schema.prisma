}

model GovernmentServiceChecklistItem {
  id                         String                   @id @default(uuid()) @db.Uuid
  governmentServiceVersionId String                   @db.Uuid
  itemCode                   String
  label                      String
  description                String?
  conditionExpression        Json?
  sortOrder                  Int                      @default(0)
  isRequired                 Boolean                  @default(true)
  createdAt                  DateTime                 @default(now())
  updatedAt                  DateTime                 @updatedAt
  governmentServiceVersion   GovernmentServiceVersion @relation(fields: [governmentServiceVersionId], references: [id], onDelete: Cascade)

  @@unique([governmentServiceVersionId, itemCode])
  @@index([governmentServiceVersionId])
  @@map("government_service_checklist_items")
}

model GovernmentServiceOutputDefinition {
  id                         String                   @id @default(uuid()) @db.Uuid
  governmentServiceVersionId String                   @db.Uuid
  outputCode                 String
  label                      String
  description                String?
  validityLabel              String?
  sortOrder                  Int                      @default(0)
  createdAt                  DateTime                 @default(now())
  updatedAt                  DateTime                 @updatedAt
  governmentServiceVersion   GovernmentServiceVersion @relation(fields: [governmentServiceVersionId], references: [id], onDelete: Cascade)

  @@unique([governmentServiceVersionId, outputCode])
  @@index([governmentServiceVersionId])
  @@map("government_service_output_definitions")
}

model GovernmentServiceRedressRoute {
  id                         String                   @id @default(uuid()) @db.Uuid
  governmentServiceVersionId String                   @db.Uuid
  routeCode                  String
  label                      String
  description                String?
  contactReference           String?
  sortOrder                  Int                      @default(0)
  createdAt                  DateTime                 @default(now())
  updatedAt                  DateTime                 @updatedAt
  governmentServiceVersion   GovernmentServiceVersion @relation(fields: [governmentServiceVersionId], references: [id], onDelete: Cascade)

  @@unique([governmentServiceVersionId, routeCode])

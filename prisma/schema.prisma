// ─── Phase 6E: Application case completeness loop (isolated tables) ─────────

enum ApplicationCaseStatus {
  OPEN
  CLOSED
  SAFE_HALTED
}

enum ApplicationCaseWorkflowStage {
  SUBMITTED
  COMPLETENESS_REVIEW
  INCOMPLETE
  WAITING_APPLICANT
  RESUBMITTED
  ADMINISTRATIVELY_COMPLETE
  SUBSTANTIVE_REVIEW
  SAFE_HALTED
}

enum ApplicationCaseCompletenessReviewStatus {
  PENDING
  IN_REVIEW
  INCOMPLETE
  COMPLETE
  UNRESOLVED
  SAFE_HALTED
}

enum ApplicationCaseCompletenessReviewItemStatus {
  PRESENT
  MISSING
  ILLEGIBLE
  CORRUPTED
  APPARENTLY_INCONSISTENT
  SUBSTITUTION_PENDING
  NOT_APPLICABLE
  UNRESOLVED
}

enum ApplicationCaseDeficiencyNoticeStatus {
  DRAFT
  ISSUED
  RESPONDED
  EXPIRED
  SUPERSEDED
  WITHDRAWN
}

enum ApplicationCaseInformationRequestStatus {
  OPEN
  RESPONDED
  CLOSED
  EXPIRED
}

enum ApplicationCaseNotificationOutboxStatus {
  PENDING
  DISPATCHED
  FAILED
}

model ApplicationCase {
  id                         String                              @id @default(uuid()) @db.Uuid
  caseReference              String                              @unique
  governmentServiceId        String                              @db.Uuid
  governmentServiceVersionId String                              @db.Uuid
  configurationFingerprint   String
  applicantIdentityId        String                              @db.Uuid
  status                     ApplicationCaseStatus               @default(OPEN)
  currentWorkflowStage       ApplicationCaseWorkflowStage        @default(SUBMITTED)
  workflowStageEnteredAt     DateTime                            @default(now())
  createdAt                  DateTime                            @default(now())
  updatedAt                  DateTime                            @updatedAt
  governmentService          GovernmentService                   @relation(fields: [governmentServiceId], references: [id])
  governmentServiceVersion   GovernmentServiceVersion            @relation(fields: [governmentServiceVersionId], references: [id])
  applicantIdentity          Identity                            @relation("ApplicationCaseApplicant", fields: [applicantIdentityId], references: [id])
  submissions                ApplicationCaseSubmission[]
  completenessReviews        ApplicationCaseCompletenessReview[]
  deficiencyNotices          ApplicationCaseDeficiencyNotice[]
  applicantInformationRequests ApplicationCaseInformationRequest[]
  workflowTransitions        ApplicationCaseWorkflowTransition[]
  notificationOutbox         ApplicationCaseNotificationOutbox[]

  @@index([governmentServiceId])
  @@index([governmentServiceVersionId])
  @@index([applicantIdentityId])
  @@index([currentWorkflowStage])
  @@map("application_cases")
}

model ApplicationCaseSubmission {
  id                            String              @id @default(uuid()) @db.Uuid
  caseId                        String              @db.Uuid
  submissionSequence            Int
  governmentServiceVersionId    String              @db.Uuid
  formVersionId                 String?             @db.Uuid
  configurationFingerprint      String
  pinnedChecklistItemIds        Json
  pinnedChecklistFingerprint    String
  answers                       Json                @default("{}")
  submittedAt                   DateTime
  submittedByIdentityId         String              @db.Uuid
  priorSubmissionId             String?             @db.Uuid
  triggeredByDeficiencyNoticeId String?             @db.Uuid
  createdAt                     DateTime            @default(now())
  case                          ApplicationCase     @relation(fields: [caseId], references: [id])
  governmentServiceVersion      GovernmentServiceVersion @relation(fields: [governmentServiceVersionId], references: [id])
  submittedByIdentity           Identity            @relation("ApplicationCaseSubmissionSubmitter", fields: [submittedByIdentityId], references: [id])
  priorSubmission               ApplicationCaseSubmission? @relation("ApplicationCaseSubmissionCorrectionChain", fields: [priorSubmissionId], references: [id])
  correctionSubmissions         ApplicationCaseSubmission[] @relation("ApplicationCaseSubmissionCorrectionChain")
  triggeredByDeficiencyNotice   ApplicationCaseDeficiencyNotice? @relation("ApplicationCaseDeficiencyNoticeCorrectionSubmission", fields: [triggeredByDeficiencyNoticeId], references: [id])
  completenessReviews           ApplicationCaseCompletenessReview[]
  deficiencyNotices             ApplicationCaseDeficiencyNotice[]
  originalInformationRequests   ApplicationCaseInformationRequest[] @relation("ApplicationCaseInformationRequestOriginalSubmission")
  responseInformationRequests   ApplicationCaseInformationRequest[] @relation("ApplicationCaseInformationRequestResponseSubmission")

  @@unique([caseId, submissionSequence])
  @@index([caseId])
  @@index([governmentServiceVersionId])
  @@index([submittedByIdentityId])
  @@index([priorSubmissionId])
  @@map("application_case_submissions")
}

model ApplicationCaseWorkflowTransition {
  id              String                       @id @default(uuid()) @db.Uuid
  caseId          String                       @db.Uuid
  fromStage       ApplicationCaseWorkflowStage
  toStage         ApplicationCaseWorkflowStage
  reason          String?
  actorIdentityId String?                      @db.Uuid
  createdAt       DateTime                     @default(now())
  case            ApplicationCase              @relation(fields: [caseId], references: [id])

  @@index([caseId])
  @@index([createdAt])
  @@map("application_case_workflow_transitions")
}

model ApplicationCaseCompletenessReview {
  id                                String                                  @id @default(uuid()) @db.Uuid
  caseId                            String                                  @db.Uuid
  applicationSubmissionId           String                                  @db.Uuid
  governmentServiceVersionId        String                                  @db.Uuid
  checklistConfigurationFingerprint String
  reviewerIdentityId                String?                                 @db.Uuid
  reviewerOfficeholderId            String?                                 @db.Uuid
  status                            ApplicationCaseCompletenessReviewStatus @default(PENDING)
  reviewSequence                    Int                                     @default(1)
  startedAt                         DateTime?
  completedAt                       DateTime?
  authorityEvaluationRecordId       String?                                 @db.Uuid
  createdAt                         DateTime                                @default(now())
  updatedAt                         DateTime                                @updatedAt
  case                              ApplicationCase                         @relation(fields: [caseId], references: [id])
  applicationSubmission             ApplicationCaseSubmission               @relation(fields: [applicationSubmissionId], references: [id])
  governmentServiceVersion          GovernmentServiceVersion                @relation(fields: [governmentServiceVersionId], references: [id])
  reviewerIdentity                  Identity?                               @relation("ApplicationCaseCompletenessReviewReviewer", fields: [reviewerIdentityId], references: [id])
  reviewerOfficeholder              Officeholder?                           @relation("ApplicationCaseCompletenessReviewReviewerOfficeholder", fields: [reviewerOfficeholderId], references: [id])
  authorityEvaluationRecord         AuthorityEvaluationRecord?              @relation(fields: [authorityEvaluationRecordId], references: [id])
  items                             ApplicationCaseCompletenessReviewItem[]
  deficiencyNotices                 ApplicationCaseDeficiencyNotice[]

  @@index([caseId])
  @@index([applicationSubmissionId])
  @@index([governmentServiceVersionId])
  @@index([status])
  @@map("application_case_completeness_reviews")
}

model ApplicationCaseCompletenessReviewItem {
  id                    String                                      @id @default(uuid()) @db.Uuid
  completenessReviewId  String                                      @db.Uuid
  checklistItemId       String                                      @db.Uuid
  checklistItemCode     String
  label                 String
  isRequired            Boolean                                     @default(true)
  status                ApplicationCaseCompletenessReviewItemStatus @default(UNRESOLVED)
  reviewerNotes         String?
  createdAt             DateTime                                    @default(now())
  updatedAt             DateTime                                    @updatedAt
  completenessReview    ApplicationCaseCompletenessReview           @relation(fields: [completenessReviewId], references: [id], onDelete: Cascade)
  deficiencyNoticeItems ApplicationCaseDeficiencyNoticeItem[]

  @@unique([completenessReviewId, checklistItemCode])
  @@index([completenessReviewId])
  @@index([checklistItemId])
  @@map("application_case_completeness_review_items")
}

model ApplicationCaseDeficiencyNotice {
  id                         String                                @id @default(uuid()) @db.Uuid
  reference                  String                                @unique
  caseId                     String                                @db.Uuid
  applicationSubmissionId    String                                @db.Uuid
  completenessReviewId       String                                @db.Uuid
  requiredApplicantAction    String
  responseDeadline           DateTime
  departmentContactReference String
  issuedByIdentityId         String                                @db.Uuid
  issuedByOfficeholderId     String?                               @db.Uuid
  issuedAt                   DateTime
  status                     ApplicationCaseDeficiencyNoticeStatus @default(ISSUED)
  isProceduralNotice         Boolean                               @default(true)
  createdAt                  DateTime                              @default(now())
  case                       ApplicationCase                       @relation(fields: [caseId], references: [id])
  applicationSubmission      ApplicationCaseSubmission             @relation(fields: [applicationSubmissionId], references: [id])
  completenessReview         ApplicationCaseCompletenessReview     @relation(fields: [completenessReviewId], references: [id])
  issuedByIdentity           Identity                              @relation("ApplicationCaseDeficiencyNoticeIssuer", fields: [issuedByIdentityId], references: [id])
  issuedByOfficeholder       Officeholder?                         @relation("ApplicationCaseDeficiencyNoticeIssuerOfficeholder", fields: [issuedByOfficeholderId], references: [id])
  items                      ApplicationCaseDeficiencyNoticeItem[]
  applicantInformationRequests ApplicationCaseInformationRequest[]
  correctionSubmissions      ApplicationCaseSubmission[]           @relation("ApplicationCaseDeficiencyNoticeCorrectionSubmission")

  @@index([caseId])
  @@index([applicationSubmissionId])
  @@index([completenessReviewId])
  @@index([status])
  @@map("application_case_deficiency_notices")
}

model ApplicationCaseDeficiencyNoticeItem {
  id                       String                                @id @default(uuid()) @db.Uuid
  deficiencyNoticeId       String                                @db.Uuid
  completenessReviewItemId String                                @db.Uuid
  checklistItemCode        String
  deficiencyDescription    String
  requiredAction           String
  createdAt                DateTime                              @default(now())
  deficiencyNotice         ApplicationCaseDeficiencyNotice       @relation(fields: [deficiencyNoticeId], references: [id], onDelete: Cascade)
  completenessReviewItem   ApplicationCaseCompletenessReviewItem @relation(fields: [completenessReviewItemId], references: [id])

  @@index([deficiencyNoticeId])
  @@index([completenessReviewItemId])
  @@map("application_case_deficiency_notice_items")
}

model ApplicationCaseInformationRequest {
  id                   String                                  @id @default(uuid()) @db.Uuid
  caseId               String                                  @db.Uuid
  deficiencyNoticeId   String                                  @db.Uuid
  originalSubmissionId String                                  @db.Uuid
  responseSubmissionId String?                                 @db.Uuid
  requestedAt          DateTime                                @default(now())
  responseDeadline     DateTime
  status               ApplicationCaseInformationRequestStatus @default(OPEN)
  createdAt            DateTime                                @default(now())
  updatedAt            DateTime                                @updatedAt
  case                 ApplicationCase                         @relation(fields: [caseId], references: [id])
  deficiencyNotice     ApplicationCaseDeficiencyNotice         @relation(fields: [deficiencyNoticeId], references: [id])
  originalSubmission   ApplicationCaseSubmission               @relation("ApplicationCaseInformationRequestOriginalSubmission", fields: [originalSubmissionId], references: [id])
  responseSubmission   ApplicationCaseSubmission?              @relation("ApplicationCaseInformationRequestResponseSubmission", fields: [responseSubmissionId], references: [id])

  @@index([caseId])
  @@index([deficiencyNoticeId])
  @@index([originalSubmissionId])
  @@index([status])
  @@map("application_case_information_requests")
}

model ApplicationCaseNotificationOutbox {
  id        String                                  @id @default(uuid()) @db.Uuid
  caseId    String                                  @db.Uuid
  eventType String
  payload   Json                                    @default("{}")
  status    ApplicationCaseNotificationOutboxStatus @default(PENDING)
  createdAt DateTime                                @default(now())
  case      ApplicationCase                         @relation(fields: [caseId], references: [id])

  @@index([caseId])
  @@index([status])
  @@map("application_case_notification_outbox")
}

// ─── Phase 6D: Runtime workflow orchestration (isolated tables) ───────────────

enum RuntimeCaseRecordStatus {
  OPEN
  IN_PROGRESS
  DECISION_PENDING
  AWAITING_ISSUANCE
  CLOSED
  CANCELLED
}

enum RuntimeWorkflowVersionStatus {
  DRAFT
  ACTIVE
  SUSPENDED
  SUPERSEDED
  ARCHIVED
}

enum RuntimeWorkflowStepType {
  ADMINISTRATIVE
  DECISION_GATE
  ISSUANCE_GATE
  PARALLEL_FORK
  PARALLEL_JOIN
  WAITING_APPLICANT
  WAITING_EXTERNAL
  WAITING_PROFESSIONAL
}

enum RuntimeWorkflowTransitionConditionType {
  ALWAYS
  STEP_COMPLETED
  ALL_JOIN_BRANCHES_COMPLETE
  CORRECTION_RETURN
  ESCALATION
}

enum RuntimeCaseWorkflowInstanceStatus {
  NOT_STARTED
  ACTIVE
  WAITING_APPLICANT
  WAITING_EXTERNAL
  WAITING_PROFESSIONAL
  PAUSED
  SAFE_HALTED
  SUSPENDED
  COMPLETED
  CANCELLED
}

enum RuntimeCaseWorkflowStepInstanceStatus {
  PENDING
  READY
  IN_PROGRESS
  WAITING
  BLOCKED
  COMPLETED
  SKIPPED_AUTHORIZED
  SAFE_HALTED
  CANCELLED
}

enum RuntimeCaseWorkflowTransitionEventType {
  WORKFLOW_STARTED
  STEP_STARTED
  STEP_COMPLETED
  TRANSITION_EVALUATED
  PARALLEL_FORK
  PARALLEL_JOIN
  PAUSE
  RESUME
  RETURN_FOR_CORRECTION
  ESCALATION
  SAFE_HALT
  WORKFLOW_COMPLETED
  WORKFLOW_CANCELLED
}

model CaseRecord {
  id                         String                   @id @default(uuid()) @db.Uuid
  caseReference              String                   @unique
  governmentServiceVersionId String                   @db.Uuid
  status                     RuntimeCaseRecordStatus  @default(OPEN)
  createdAt                  DateTime                 @default(now())
  updatedAt                  DateTime                 @updatedAt
  governmentServiceVersion   GovernmentServiceVersion @relation(fields: [governmentServiceVersionId], references: [id])
  workflowInstances          RuntimeCaseWorkflowInstance[]

  @@index([governmentServiceVersionId])
  @@index([status])
  @@map("case_records")
}

model RuntimeWorkflowDefinition {
  id                         String                   @id @default(uuid()) @db.Uuid
  code                       String                   @unique
  name                       String
  governmentServiceVersionId String                   @db.Uuid
  createdAt                  DateTime                 @default(now())
  updatedAt                  DateTime                 @updatedAt
  governmentServiceVersion   GovernmentServiceVersion @relation(fields: [governmentServiceVersionId], references: [id])
  versions                   RuntimeWorkflowVersion[]

  @@index([governmentServiceVersionId])
  @@map("runtime_workflow_definitions")
}

model RuntimeWorkflowVersion {
  id                    String                       @id @default(uuid()) @db.Uuid
  workflowDefinitionId  String                       @db.Uuid
  version               Int
  status                RuntimeWorkflowVersionStatus @default(DRAFT)
  effectiveFrom         DateTime?
  effectiveUntil        DateTime?
  suspendedAt           DateTime?
  supersededByVersionId String?                      @db.Uuid
  createdAt             DateTime                     @default(now())
  updatedAt             DateTime                     @updatedAt
  workflowDefinition    RuntimeWorkflowDefinition    @relation(fields: [workflowDefinitionId], references: [id])
  supersededByVersion   RuntimeWorkflowVersion?      @relation("RuntimeWorkflowVersionSupersession", fields: [supersededByVersionId], references: [id])
  supersededVersions    RuntimeWorkflowVersion[]     @relation("RuntimeWorkflowVersionSupersession")
  steps                 RuntimeWorkflowStep[]
  transitions           RuntimeWorkflowTransition[]
  caseInstances         RuntimeCaseWorkflowInstance[]

  @@unique([workflowDefinitionId, version])
  @@index([workflowDefinitionId])
  @@index([status])
  @@map("runtime_workflow_versions")
}

model RuntimeWorkflowStep {
  id                        String                   @id @default(uuid()) @db.Uuid
  workflowVersionId         String                   @db.Uuid
  stepKey                   String
  label                     String
  stepType                  RuntimeWorkflowStepType
  stageKey                  String
  sequenceOrder             Int                      @default(0)
  functionAuthorityRecordId String?                  @db.Uuid
  authorityAction           AuthorityActionType?
  isConsequential           Boolean                  @default(false)
  isHumanRequired           Boolean                  @default(true)
  parallelGroupKey          String?
  requiredJoinBranchKeys    Json                     @default("[]")
  dependsOnStepKeys         Json                     @default("[]")
  createdAt                 DateTime                 @default(now())
  updatedAt                 DateTime                 @updatedAt
  workflowVersion           RuntimeWorkflowVersion   @relation(fields: [workflowVersionId], references: [id], onDelete: Cascade)
  functionAuthorityRecord   FunctionAuthorityRecord? @relation(fields: [functionAuthorityRecordId], references: [id])
  stepInstances             RuntimeCaseWorkflowStepInstance[]

  @@unique([workflowVersionId, stepKey])
  @@index([workflowVersionId])
  @@index([functionAuthorityRecordId])
  @@map("runtime_workflow_steps")
}

model RuntimeWorkflowTransition {
  id                String                                 @id @default(uuid()) @db.Uuid
  workflowVersionId String                                 @db.Uuid
  fromStepKey       String
  toStepKey         String
  transitionKey     String
  conditionType     RuntimeWorkflowTransitionConditionType @default(ALWAYS)
  conditionRules    Json                                   @default("{}")
  isDefault         Boolean                                @default(false)
  createdAt         DateTime                               @default(now())
  updatedAt         DateTime                               @updatedAt
  workflowVersion   RuntimeWorkflowVersion                 @relation(fields: [workflowVersionId], references: [id], onDelete: Cascade)

  @@unique([workflowVersionId, transitionKey])
  @@index([workflowVersionId])
  @@index([fromStepKey])
  @@map("runtime_workflow_transitions")
}

model RuntimeCaseWorkflowInstance {
  id                 String                            @id @default(uuid()) @db.Uuid
  caseId             String                            @db.Uuid
  workflowVersionId  String                            @db.Uuid
  status             RuntimeCaseWorkflowInstanceStatus @default(NOT_STARTED)
  currentStepKey     String?
  startedAt          DateTime?
  completedAt        DateTime?
  pausedAt           DateTime?
  safeHaltActive     Boolean                           @default(false)
  createdAt          DateTime                          @default(now())
  updatedAt          DateTime                          @updatedAt
  case               CaseRecord                        @relation(fields: [caseId], references: [id])
  workflowVersion    RuntimeWorkflowVersion            @relation(fields: [workflowVersionId], references: [id])
  stepInstances      RuntimeCaseWorkflowStepInstance[]
  transitionEvents   RuntimeCaseWorkflowTransitionEvent[]

  @@index([caseId])
  @@index([workflowVersionId])
  @@index([status])
  @@map("runtime_case_workflow_instances")
}

model RuntimeCaseWorkflowStepInstance {
  id                 String                              @id @default(uuid()) @db.Uuid
  workflowInstanceId String                              @db.Uuid
  workflowStepId     String                              @db.Uuid
  stepKey            String
  status             RuntimeCaseWorkflowStepInstanceStatus @default(PENDING)
  startedAt          DateTime?
  completedAt        DateTime?
  authorityEvaluationRecordId String?                    @db.Uuid
  createdAt          DateTime                            @default(now())
  updatedAt          DateTime                            @updatedAt
  workflowInstance   RuntimeCaseWorkflowInstance         @relation(fields: [workflowInstanceId], references: [id], onDelete: Cascade)
  workflowStep       RuntimeWorkflowStep                 @relation(fields: [workflowStepId], references: [id])
  authorityEvaluationRecord AuthorityEvaluationRecord?   @relation(fields: [authorityEvaluationRecordId], references: [id])

  @@unique([workflowInstanceId, stepKey])
  @@index([workflowInstanceId])
  @@index([workflowStepId])
  @@map("runtime_case_workflow_step_instances")
}

model RuntimeCaseWorkflowTransitionEvent {
  id                          String                               @id @default(uuid()) @db.Uuid
  workflowInstanceId          String                               @db.Uuid
  eventType                   RuntimeCaseWorkflowTransitionEventType
  fromStepKey                 String?
  toStepKey                   String?
  actorIdentityId             String?                              @db.Uuid
  authorityEvaluationRecordId String?                              @db.Uuid
  metadata                    Json                                 @default("{}")
  occurredAt                  DateTime                             @default(now())
  workflowInstance            RuntimeCaseWorkflowInstance          @relation(fields: [workflowInstanceId], references: [id], onDelete: Cascade)

  @@index([workflowInstanceId])
  @@index([occurredAt])
  @@map("runtime_case_workflow_transition_events")
}

// ─── Phase 7C: Evidence Registry and Verification Engine ────────────────────

enum EvidenceRecordStatus {
  REQUESTED
  RECEIVED
  UNREADABLE
  INCOMPLETE
  DUPLICATE
  APPLICANT_ASSERTED
  EXTERNALLY_ISSUED
  PENDING_VERIFICATION
  VERIFIED
  PARTIALLY_VERIFIED
  DISPUTED
  EXPIRED
  SUPERSEDED
  WITHDRAWN
  REJECTED_FOR_STATED_PURPOSE
  ACCEPTED_FOR_LIMITED_RELIANCE
  ACCEPTED_FOR_ADMINISTRATIVE_PURPOSE
}

enum EvidenceType {
  DOCUMENT
  DATA_EXTRACT
  REGISTRY_RECORD
  PROFESSIONAL_CERTIFICATION
  PHOTOGRAPH
  STATEMENT
  OTHER
}

enum EvidenceSource {
  APPLICANT
  THIRD_PARTY
  GOVERNMENT_REGISTRY
  PROFESSIONAL_BODY
  INTERNAL
  OTHER
}

enum EvidenceVerificationCategory {
  INTEGRITY
  ISSUER
  SIGNATURE
  SEAL
  IDENTITY
  DATE
  REGISTRY_MATCH
  CONTENT_FACT
  PROFESSIONAL
  OTHER_CONTROLLED_METHOD
}

enum EvidenceVerificationResult {
  CONFIRMED
  NOT_CONFIRMED
  INCONCLUSIVE
  COULD_NOT_VERIFY
}

enum EvidenceVerificationMethod {
  CHECKSUM_MATCH
  DIGITAL_SIGNATURE_VALIDATION
  REGISTRY_LOOKUP
  ISSUER_CONFIRMATION
  PROFESSIONAL_REGISTER_LOOKUP
  VISUAL_INSPECTION
  OTHER_CONTROLLED_METHOD
  UNKNOWN
}

enum EvidenceRequirementRelationship {
  SATISFIES
  PARTIALLY_SATISFIES
  DOES_NOT_SATISFY
  UNDER_REVIEW
  NOT_APPLICABLE
}

enum EvidenceRequirementLinkStatus {
  LINKED
  UNDER_REVIEW
  SATISFIED
  PARTIALLY_SATISFIED
  NOT_SATISFIED
  SUPERSEDED
  WITHDRAWN
}

enum EvidenceAcceptancePurpose {
  COMPLETENESS
  SUBSTANTIVE_REVIEW
  PROFESSIONAL_REVIEW
  INSPECTION
  EXTERNAL_REFERRAL
  FUTURE_DECISION_PACKET
  COMPLIANCE
  OTHER_APPROVED_PURPOSE
}

enum EvidenceAcceptanceDecision {
  ACCEPTED
  REJECTED
  LIMITED
}

enum EvidenceQualityCriterion {
  RELEVANCE
  PROVENANCE
  AUTHENTICITY
  COMPLETENESS
  CURRENCY
  INDEPENDENCE
  RELIABILITY
  INTEGRITY
  SCOPE
  FITNESS_FOR_PURPOSE
}

enum EvidenceQualityRating {
  STRONG
  ADEQUATE
  WEAK
  INSUFFICIENT
  UNASSESSED
}

enum EvidenceQualityAssessmentSource {
  OFFICIAL
  AI_PROPOSED
}

model MasterAdministrativeFile {
  id               String            @id @default(uuid()) @db.Uuid
  fileReference    String            @unique
  caseId           String            @unique @db.Uuid
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  case             Case              @relation(fields: [caseId], references: [id])
  documentVersions DocumentVersion[]
  evidenceRecords  EvidenceRecord[]

  @@index([caseId])
  @@map("master_administrative_files")
}

model DocumentVersion {
  id                         String                   @id @default(uuid()) @db.Uuid
  masterAdministrativeFileId String                   @db.Uuid
  documentReference          String
  versionNumber              Int
  integrityHash              String
  createdAt                  DateTime                 @default(now())
  masterAdministrativeFile   MasterAdministrativeFile @relation(fields: [masterAdministrativeFileId], references: [id])
  evidenceRecords            EvidenceRecord[]

  @@unique([masterAdministrativeFileId, documentReference, versionNumber])
  @@index([masterAdministrativeFileId])
  @@map("document_versions")
}

model EvidenceRecord {
  id                            String               @id @default(uuid()) @db.Uuid
  evidenceNumber                String               @unique
  masterAdministrativeFileId    String               @db.Uuid
  caseId                        String               @db.Uuid
  documentVersionId             String?              @db.Uuid
  externalRecordReference       String?
  title                         String
  description                   String?
  evidenceType                  EvidenceType
  source                        EvidenceSource
  submittingParty               String
  authorOrIssuingBody           String?
  dateCreated                   DateTime?
  dateReceived                  DateTime
  periodCovered                 String?
  status                        EvidenceRecordStatus @default(RECEIVED)
  validFrom                     DateTime?
  validUntil                    DateTime?
  confidentialityClassification String
  integrityReference            String
  limitations                   String?
  retentionRuleReference        String?
  supersededByEvidenceId        String?              @db.Uuid
  createdAt                     DateTime             @default(now())
  updatedAt                     DateTime             @updatedAt
  masterAdministrativeFile      MasterAdministrativeFile @relation(fields: [masterAdministrativeFileId], references: [id])
  case                          Case                 @relation(fields: [caseId], references: [id])
  documentVersion               DocumentVersion?     @relation(fields: [documentVersionId], references: [id])
  supersededByEvidence          EvidenceRecord?      @relation("EvidenceSupersession", fields: [supersededByEvidenceId], references: [id])
  supersededEvidence            EvidenceRecord[]     @relation("EvidenceSupersession")
  verifications                 EvidenceVerification[]
  requirementLinks              EvidenceRequirementLink[]
  purposeAcceptances            EvidencePurposeAcceptance[]
  qualityAssessments            EvidenceQualityAssessment[]

  @@index([masterAdministrativeFileId])
  @@index([caseId])
  @@index([documentVersionId])
  @@index([status])
  @@index([supersededByEvidenceId])
  @@map("evidence_records")
}

model EvidenceVerification {
  id                          String                       @id @default(uuid()) @db.Uuid
  evidenceId                  String                       @db.Uuid
  category                    EvidenceVerificationCategory
  whatWasVerified             String
  verificationMethod          EvidenceVerificationMethod
  verificationSource          String
  result                      EvidenceVerificationResult
  verifiedByIdentityId        String                       @db.Uuid
  verifiedByOfficeholderId    String?                      @db.Uuid
  professionalReference       String?
  externalAuthorityReference  String?
  performedAt                 DateTime
  limitations                 String?
  expiresAt                   DateTime?
  authorityEvaluationRecordId String?                      @db.Uuid
  isAiProposed                Boolean                      @default(false)
  finalizedAt                 DateTime?
  createdAt                   DateTime                     @default(now())
  evidence                    EvidenceRecord               @relation(fields: [evidenceId], references: [id])
  verifiedByIdentity          Identity                     @relation("EvidenceVerificationVerifier", fields: [verifiedByIdentityId], references: [id])
  verifiedByOfficeholder      Officeholder?                @relation("EvidenceVerificationVerifierOfficeholder", fields: [verifiedByOfficeholderId], references: [id])
  authorityEvaluationRecord   AuthorityEvaluationRecord?   @relation(fields: [authorityEvaluationRecordId], references: [id])

  @@index([evidenceId])
  @@index([category])
  @@index([verifiedByIdentityId])
  @@index([performedAt])
  @@map("evidence_verifications")
}

model EvidenceRequirementLink {
  id                String                          @id @default(uuid()) @db.Uuid
  evidenceId        String                          @db.Uuid
  checklistItemId   String                          @db.Uuid
  relationship      EvidenceRequirementRelationship
  status            EvidenceRequirementLinkStatus   @default(LINKED)
  effectiveFrom     DateTime                        @default(now())
  effectiveUntil    DateTime?
  limitations       String?
  createdAt         DateTime                        @default(now())
  updatedAt         DateTime                        @updatedAt
  evidence          EvidenceRecord                  @relation(fields: [evidenceId], references: [id])
  checklistItem     GovernmentServiceChecklistItem  @relation(fields: [checklistItemId], references: [id])

  @@index([evidenceId])
  @@index([checklistItemId])
  @@index([status])
  @@map("evidence_requirement_links")
}

model EvidencePurposeAcceptance {
  id                       String                    @id @default(uuid()) @db.Uuid
  evidenceId               String                    @db.Uuid
  purpose                  EvidenceAcceptancePurpose
  decision                 EvidenceAcceptanceDecision
  reviewerIdentityId       String                    @db.Uuid
  reviewerOfficeholderId   String?                   @db.Uuid
  decidedAt                DateTime
  reason                   String?
  scope                    String?
  limitations              String?
  isAiProposed             Boolean                   @default(false)
  finalizedAt              DateTime?
  createdAt                DateTime                  @default(now())
  evidence                 EvidenceRecord            @relation(fields: [evidenceId], references: [id])
  reviewerIdentity         Identity                  @relation("EvidencePurposeAcceptanceReviewer", fields: [reviewerIdentityId], references: [id])
  reviewerOfficeholder     Officeholder?             @relation("EvidencePurposeAcceptanceReviewerOfficeholder", fields: [reviewerOfficeholderId], references: [id])

  @@index([evidenceId])
  @@index([purpose])
  @@index([reviewerIdentityId])
  @@map("evidence_purpose_acceptances")
}

model EvidenceQualityAssessment {
  id                     String                          @id @default(uuid()) @db.Uuid
  evidenceId             String                          @db.Uuid
  criterion              EvidenceQualityCriterion
  rating                 EvidenceQualityRating
  notes                  String?
  assessedByIdentityId   String                          @db.Uuid
  assessedByOfficeholderId String?                       @db.Uuid
  assessmentSource       EvidenceQualityAssessmentSource @default(OFFICIAL)
  assessedAt             DateTime
  limitations            String?
  finalizedAt            DateTime?
  createdAt              DateTime                        @default(now())
  evidence               EvidenceRecord                  @relation(fields: [evidenceId], references: [id])
  assessedByIdentity     Identity                        @relation("EvidenceQualityAssessor", fields: [assessedByIdentityId], references: [id])
  assessedByOfficeholder Officeholder?                   @relation("EvidenceQualityAssessorOfficeholder", fields: [assessedByOfficeholderId], references: [id])

  @@unique([evidenceId, criterion, assessmentSource, assessedAt])
  @@index([evidenceId])
  @@index([criterion])
  @@map("evidence_quality_assessments")
}

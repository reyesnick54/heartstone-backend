// ─── Vehicle, Driver & Transportation Registry ─────────────────────────────

enum TransportationDataClassification {
  PUBLIC_VERIFICATION
  STANDARD_TRANSPORT
  PROTECTED_DRIVER
  PROTECTED_MEDICAL_REFERENCE
  RESTRICTED_ENFORCEMENT
}

enum TransportationRegistryLifecycleStatus {
  ACTIVE
  EXPIRED
  SUSPENDED
  REVOKED
  TRANSFERRED
  RETIRED
  PENDING
}

enum TransportationApplicationProfileStatus {
  LINKED
  WITHDRAWN
  CLOSED
}

enum DriverLicenseLifecycleStatus {
  NOT_ISSUED
  PENDING_ISSUANCE
  EFFECTIVE
  EXPIRED
  SUSPENDED
  REVOKED
  SUPERSEDED
}

enum VehicleIdentifierType {
  VIN_CHASSIS
  REGISTRATION_NUMBER
  LICENSE_PLATE
  ENGINE_REFERENCE
  EXTERNAL_REGISTRY_REFERENCE
  OTHER_CONFIGURED
}

enum VehicleIdentifierStatus {
  ACTIVE
  SUPERSEDED
  RETIRED
}

enum VehicleOwnershipPartyType {
  IDENTITY
  ORGANIZATION
}

enum VehicleOwnershipRecordStatus {
  CURRENT
  SUPERSEDED
  TRANSFERRED_OUT
}

enum TransportationActorPersona {
  DRIVER
  VEHICLE_OWNER
  FLEET_MANAGER
  TRANSPORT_OPERATOR
  AUTHORIZED_REPRESENTATIVE
  TRANSPORTATION_OFFICER
  SENIOR_DECISION_OFFICER
  EXTERNAL_PROFESSIONAL_LIAISON
  TECHNICAL_ADMIN
  AI_ASSISTANCE
  PAYMENT_SYSTEM
  SYSTEM
}

enum DriverTestRecordOutcome {
  PASSED
  FAILED
  INCOMPLETE
  CANCELLED
  WAIVED_CONFIGURED
}

enum TransportationProfessionalDeterminationStatus {
  PENDING
  SATISFIED
  UNSATISFIED
  WAIVED_CONFIGURED
}

enum FleetVehicleLinkStatus {
  ACTIVE
  REMOVED
  SUSPENDED
}

enum TransportPermitLifecycleStatus {
  NOT_ISSUED
  PENDING_ISSUANCE
  EFFECTIVE
  EXPIRED
  SUSPENDED
  REVOKED
  SUPERSEDED
}

enum TransportationRegistryEntryKind {
  DRIVER
  VEHICLE
  TRANSPORT_OPERATOR
  FLEET
}

enum TransportationRegistrySubjectStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  RETIRED
}

model TransportationRegistryEntry {
  id                            String                            @id @default(uuid()) @db.Uuid
  registryNumber                String                            @unique
  entryKind                     TransportationRegistryEntryKind
  jurisdictionId                String?                           @db.Uuid
  subjectStatus                 TransportationRegistrySubjectStatus @default(ACTIVE)
  driverProfileId               String?                           @unique @db.Uuid
  vehicleRecordId               String?                           @unique @db.Uuid
  transportOperatorRecordId     String?                           @unique @db.Uuid
  fleetRecordId                 String?                           @unique @db.Uuid
  masterAdministrativeFileId    String?                           @db.Uuid
  dataClassification            TransportationDataClassification  @default(STANDARD_TRANSPORT)
  createdAt                     DateTime                          @default(now())
  updatedAt                     DateTime                          @updatedAt
  jurisdiction                  Jurisdiction?                     @relation(fields: [jurisdictionId], references: [id])
  masterAdministrativeFile      MasterAdministrativeFile?           @relation(fields: [masterAdministrativeFileId], references: [id])
  driverProfile                 DriverProfile?                      @relation(fields: [driverProfileId], references: [id])
  vehicleRecord                 VehicleRecord?                      @relation(fields: [vehicleRecordId], references: [id])
  transportOperatorRecord       TransportOperatorRecord?            @relation(fields: [transportOperatorRecordId], references: [id])
  fleetRecord                   FleetRecord?                        @relation(fields: [fleetRecordId], references: [id])
  statusHistory                 TransportationStatusHistory[]

  @@index([entryKind, subjectStatus])
  @@index([jurisdictionId])
  @@map("transportation_registry_entries")
}

model DriverProfile {
  id                            String                      @id @default(uuid()) @db.Uuid
  profileNumber                 String                      @unique
  subjectIdentityId             String                      @db.Uuid
  jurisdictionId                String?                     @db.Uuid

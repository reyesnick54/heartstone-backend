  createdAt             DateTime           @default(now())
  twinVersion           DigitalTwinVersion @relation(fields: [twinVersionId], references: [id], onDelete: Cascade)
  recordedByIdentity    Identity?          @relation("DigitalTwinModeRecorder", fields: [recordedByIdentityId], references: [id])

  @@index([twinVersionId])
  @@index([mode])
  @@map("digital_twin_mode_records")
}

model DigitalTwinSnapshot {
  id              String             @id @default(uuid()) @db.Uuid
  twinVersionId   String             @db.Uuid
  snapshotAt      DateTime           @default(now())
  snapshotPayload Json
  snapshotHash    String
  isImmutable     Boolean            @default(true)
  createdAt       DateTime           @default(now())
  twinVersion     DigitalTwinVersion @relation(fields: [twinVersionId], references: [id], onDelete: Cascade)
  scenarios       SimulationScenario[] @relation("ScenarioInputSnapshot")
  simulationRuns  SimulationRun[]    @relation("RunInputSnapshot")
  simulationInputs SimulationInput[]

  @@index([twinVersionId])
  @@index([snapshotAt])
  @@map("digital_twin_snapshots")
}

model SimulationScenario {
  id                    String                   @id @default(uuid()) @db.Uuid
  scenarioCode          String                   @unique
  purpose               String
  scenarioDescription   String
  twinVersionId         String                   @db.Uuid

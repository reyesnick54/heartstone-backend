generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum StructuralLifecycleStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  ARCHIVED
}

enum JurisdictionType {
  NATIONAL
  SUBNATIONAL
  MUNICIPAL
  SPECIAL_ECONOMIC_ZONE
  REGULATORY
  SUBJECT_MATTER
  OTHER
}

enum InstitutionType {
  GOVERNMENT
  MINISTRY
  AGENCY
  AUTHORITY
  REGULATOR
  STATUTORY_BODY
  SPECIAL_ECONOMIC_ZONE_AUTHORITY
  PUBLIC_BODY
  OTHER
}

enum GovernmentBodyType {
  GOVERNING
  SUPERVISORY
  ADVISORY
  ADMINISTRATIVE
  DECISION_MAKING
  OTHER
}

enum AppointmentStatus {
  PENDING
  ACTIVE
  SUSPENDED
  ENDED
  REVOKED
}

enum DelegationStatus {
  PENDING
  ACTIVE
  SUSPENDED
  REVOKED
  ENDED
}

enum ExternalAuthorityType {
  GOVERNMENT
  REGULATORY
  JUDICIAL
  PROFESSIONAL
  INSTITUTIONAL
  OTHER
}

model SystemMetadata {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("system_metadata")
}

model Jurisdiction {
  id           String                    @id @default(uuid()) @db.Uuid
  code         String                    @unique
  name         String
  description  String?
  type         JurisdictionType
  status       StructuralLifecycleStatus @default(ACTIVE)
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt
  institutions Institution[]

  @@map("jurisdictions")
}

model Institution {
  id                         String                        @id @default(uuid()) @db.Uuid
  jurisdictionId             String                        @db.Uuid
  code                       String
  name                       String
  description                String?
  type                       InstitutionType
  status                     StructuralLifecycleStatus     @default(ACTIVE)
  createdAt                  DateTime                      @default(now())
  updatedAt                  DateTime                      @updatedAt
  jurisdiction               Jurisdiction                  @relation(fields: [jurisdictionId], references: [id])
  governmentBodies           GovernmentBody[]
  departments                Department[]
  delegations                Delegation[]
  externalAuthorityRelations InstitutionExternalAuthority[]

  @@unique([jurisdictionId, code])
  @@index([jurisdictionId])
  @@map("institutions")
}

model GovernmentBody {
  id            String                    @id @default(uuid()) @db.Uuid
  institutionId String                    @db.Uuid
  code          String
  name          String
  description   String?
  type          GovernmentBodyType
  status        StructuralLifecycleStatus @default(ACTIVE)
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt
  institution   Institution               @relation(fields: [institutionId], references: [id])

  @@unique([institutionId, code])
  @@index([institutionId])
  @@map("government_bodies")
}

model Department {
  id            String                    @id @default(uuid()) @db.Uuid
  institutionId String                    @db.Uuid
  code          String
  name          String
  description   String?
  status        StructuralLifecycleStatus @default(ACTIVE)
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt
  institution   Institution               @relation(fields: [institutionId], references: [id])
  offices       Office[]

  @@unique([institutionId, code])
  @@index([institutionId])
  @@map("departments")
}

model Office {
  id           String                    @id @default(uuid()) @db.Uuid
  departmentId String                    @db.Uuid
  code         String
  name         String
  description  String?
  status       StructuralLifecycleStatus @default(ACTIVE)
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt
  department   Department                @relation(fields: [departmentId], references: [id])
  appointments Appointment[]
  delegationsAsDelegator Delegation[] @relation("DelegationDelegatorOffice")
  delegationsAsRecipient Delegation[] @relation("DelegationRecipientOffice")

  @@unique([departmentId, code])
  @@index([departmentId])
  @@map("offices")
}

model Officeholder {
  id           String                    @id @default(uuid()) @db.Uuid
  code         String                    @unique
  name         String
  description  String?
  status       StructuralLifecycleStatus @default(ACTIVE)
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt
  appointments Appointment[]
  delegationsAsDelegator Delegation[] @relation("DelegationDelegatorOfficeholder")
  delegationsAsRecipient Delegation[] @relation("DelegationRecipientOfficeholder")

  @@map("officeholders")
}

model Appointment {
  id             String            @id @default(uuid()) @db.Uuid
  officeId       String            @db.Uuid
  officeholderId String            @db.Uuid
  status         AppointmentStatus @default(PENDING)
  effectiveFrom  DateTime
  effectiveUntil DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  office         Office            @relation(fields: [officeId], references: [id])
  officeholder   Officeholder      @relation(fields: [officeholderId], references: [id])

  @@index([officeId])
  @@index([officeholderId])
  @@map("appointments")
}

model Delegation {
  id                       String           @id @default(uuid()) @db.Uuid
  institutionId            String           @db.Uuid
  delegatorOfficeId        String?          @db.Uuid
  delegatorOfficeholderId  String?          @db.Uuid
  recipientOfficeId        String?          @db.Uuid
  recipientOfficeholderId  String?          @db.Uuid
  scopeDescription         String
  status                   DelegationStatus @default(PENDING)
  effectiveFrom            DateTime
  effectiveUntil           DateTime?
  createdAt                DateTime         @default(now())
  updatedAt                DateTime         @updatedAt
  institution              Institution      @relation(fields: [institutionId], references: [id])
  delegatorOffice          Office?          @relation("DelegationDelegatorOffice", fields: [delegatorOfficeId], references: [id])
  delegatorOfficeholder    Officeholder?    @relation("DelegationDelegatorOfficeholder", fields: [delegatorOfficeholderId], references: [id])
  recipientOffice          Office?          @relation("DelegationRecipientOffice", fields: [recipientOfficeId], references: [id])
  recipientOfficeholder    Officeholder?    @relation("DelegationRecipientOfficeholder", fields: [recipientOfficeholderId], references: [id])

  @@index([institutionId])
  @@map("delegations")
}

model ExternalAuthority {
  id            String                        @id @default(uuid()) @db.Uuid
  code          String                        @unique
  name          String
  description   String?
  type          ExternalAuthorityType
  status        StructuralLifecycleStatus     @default(ACTIVE)
  createdAt     DateTime                      @default(now())
  updatedAt     DateTime                      @updatedAt
  institutionRelations InstitutionExternalAuthority[]

  @@map("external_authorities")
}

model InstitutionExternalAuthority {
  id                  String                    @id @default(uuid()) @db.Uuid
  institutionId       String                    @db.Uuid
  externalAuthorityId String                    @db.Uuid
  relationshipLabel   String?
  status              StructuralLifecycleStatus @default(ACTIVE)
  effectiveFrom       DateTime?
  effectiveUntil      DateTime?
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt
  institution         Institution               @relation(fields: [institutionId], references: [id])
  externalAuthority   ExternalAuthority         @relation(fields: [externalAuthorityId], references: [id])

  @@unique([institutionId, externalAuthorityId])
  @@index([institutionId])
  @@index([externalAuthorityId])
  @@map("institution_external_authorities")
}

  holderIdentityId                  String?                           @db.Uuid
  holderOfficeholderId              String?                           @db.Uuid
  holderOrganizationId              String?                           @db.Uuid
  governmentServiceVersionId        String?                           @db.Uuid
  issuerInstitutionId               String                            @db.Uuid
  issuerOfficeholderId              String?                           @db.Uuid

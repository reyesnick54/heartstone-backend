  vitalEventId                String?                           @unique @db.Uuid
  civilPersonRecordId         String?                           @db.Uuid
  jurisdictionId              String                            @db.Uuid
  institutionId               String                            @db.Uuid
  caseId                      String                            @db.Uuid
  governmentDecisionId        String                            @db.Uuid
  authorityEvaluationRecordId String                            @db.Uuid
  status                      CivilRegistryEntryStatus          @default(OFFICIAL)
  currentVersionNumber        Int                               @default(1)
  accessClassification        CivilRegistryAccessClassification @default(SUBJECT_ACCESS)
  registeredAt                DateTime                          @default(now())
  createdAt                   DateTime                          @default(now())
  updatedAt                   DateTime                          @updatedAt
  vitalEvent                  VitalEvent?                       @relation(fields: [vitalEventId], references: [id])
  civilPersonRecord           CivilPersonRecord?                @relation(fields: [civilPersonRecordId], references: [id])
  jurisdiction                Jurisdiction                      @relation(fields: [jurisdictionId], references: [id])
  institution                 Institution                       @relation(fields: [institutionId], references: [id])
  case                        Case                              @relation(fields: [caseId], references: [id])
  governmentDecision          GovernmentDecision                @relation("CivilRegistryEntryDecision", fields: [governmentDecisionId], references: [id])
  authorityEvaluationRecord   AuthorityEvaluationRecord         @relation("CivilRegistryEntryAuthority", fields: [authorityEvaluationRecordId], references: [id])
  versions                    CivilRegistryVersion[]
  amendments                  CivilRecordAmendment[]
  restrictions                CivilRegistryRestriction[]
  verifications               CivilRegistryVerification[]
  sourceReferences            CivilRegistrySourceReference[]
  certificateExtracts         CivilRegistryCertificateExtract[]
  auditEvents                 CivilRegistryAuditEvent[]
  correctionRequests          CivilRecordCorrectionRequest[]

  @@index([civilPersonRecordId])
  @@index([caseId])
  @@index([status])
  @@index([accessClassification])
  @@index([governmentDecisionId])
  @@map("civil_registry_entries")
}

model CivilRegistryVersion {

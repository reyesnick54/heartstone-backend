  REVIEW
  VERIFY
  CHECK
  RECOMMEND
  CONCUR
  APPROVE
  DECIDE
  SIGN
  ISSUE
  INSPECT
  ENFORCE
  SUSPEND
  REVOKE
  HEAR_REVIEW
  ADMINISTER
  AUDIT
  CONSULT
  SUPERVISE
  LIAISE
}

enum GoverningSourceStatus {
  DRAFT
  AUTHENTICATED
  REVOKED
  SUPERSEDED
  CONFLICT_DETECTED
}

enum GoverningSourceRelationshipType {
  SUPERSEDES
  AMENDS
  IMPLEMENTS
  COORDINATES_WITH
  CONFLICTS_WITH
}

enum AuthorityConditionType {
  EVIDENCE_REQUIRED
  QUALIFICATION_REQUIRED
  TRANSACTION_LIMIT
  SCOPE_LIMIT
  SECOND_APPROVAL_REQUIRED
  CONSULTATION_REQUIRED
  SUPERVISION_REQUIRED
  LIAISON_BOUNDARY
  SELF_APPROVAL_PROHIBITED
  CONFLICT_CHECK
  RECUSAL_CHECK
}

enum AuthorityDependencyType {
  RETAINED_NATIONAL_DETERMINATION
  PROFESSIONAL_QUALIFICATION
  EXTERNAL_DATA_ACCESS
  EXPRESSLY_RETAINED_NATIONAL_DETERMINATION
  GOVERNMENT_CONCURRENCE
  MANDATORY_CONSULTATION
  SHARED_COORDINATED_ACTION
  PROFESSIONAL_REVIEW
  SUPERVISORY_REVIEW
  INSPECTION_DEPENDENCY
  LIAISON
  OTHER_AUTHENTICATED_DEPENDENCY
}

enum AuthorityDependencyBlockingStatus {
  BLOCKING
  NON_BLOCKING
}

enum AuthorityDependencyStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum ExternalDeterminationStatus {
  PENDING
  GRANTED
  DENIED
  PARTIALLY_GRANTED
  WITHDRAWN
  EXPIRED
}

enum InstitutionalActType {
  DECISION
  CONCURRENCE
  CONSULTATION
  SUPERVISION
  LIAISON
  PROFESSIONAL_DETERMINATION
  COORDINATED_ACTION
  DATA_EXCHANGE
}

enum ProfessionalAttestationSource {
  QUALIFIED_PROFESSIONAL
  AI_ASSISTANCE
  ADMINISTRATOR
  GOVERNMENT_OFFICIAL
  OTHER
}

enum AuthorityEvaluationOutcome {
  ALLOW
  DENY
  BLOCKED
  REQUIRES_EXTERNAL_DETERMINATION
  SAFE_HALT
}

enum SodRuleType {
  SEGREGATION_OF_DUTY
  SELF_APPROVAL
  MISSING_SECOND_APPROVAL
}

enum FunctionAssignmentStatus {
  PENDING
  ACTIVE
  SUSPENDED
  REVOKED
  ENDED
}

enum RetainedNationalDeterminationStatus {
  PENDING
  ACTIVE
  REVOKED
  EXPIRED
}

model FunctionAuthorityRecord {
  id                     String                           @id @default(uuid()) @db.Uuid
  code                   String                           @unique
  name                   String
  description            String?
  classification         AuthorityClassification
  functionClass          ControlledFunctionClass
  lifecycleStatus        FunctionAuthorityLifecycleStatus @default(DRAFT)
  institutionId          String?                          @db.Uuid
  officeId               String?                          @db.Uuid
  requiresDelegation     Boolean                          @default(false)
  requiresAppointment    Boolean                          @default(true)
  activatedAt            DateTime?
  activatedByIdentityId  String?                          @db.Uuid
  suspendedAt            DateTime?
  createdAt              DateTime                         @default(now())
  updatedAt              DateTime                         @updatedAt
  institution            Institution?                     @relation(fields: [institutionId], references: [id])
  office                 Office?                          @relation(fields: [officeId], references: [id])
  governingSources       FunctionGoverningSource[]
  assignments            FunctionAuthorityAssignment[]
  actionRights           AuthorityActionRight[]
  conditions             AuthorityCondition[]
  dependencies           AuthorityDependency[]
  sodRules               SegregationOfDutyRule[]
  evaluations            AuthorityEvaluationRecord[]
  activationAudits       FunctionActivationAudit[]
  retainedDeterminations RetainedNationalDetermination[]
  delegationScopes       DelegationStructuredScope[]
  institutionalActs      InstitutionalAuthorityAct[]

  @@index([classification])
  @@index([lifecycleStatus])
  @@index([institutionId])
  @@index([officeId])
  @@map("function_authority_records")
}

model GoverningSource {
  id                        String                        @id @default(uuid()) @db.Uuid
  code                      String                        @unique
  title                     String
  versionLabel              String
  status                    GoverningSourceStatus         @default(DRAFT)
  effectiveFrom             DateTime
  effectiveUntil            DateTime?
  authenticatedAt           DateTime?
  authenticatedByIdentityId String?                       @db.Uuid
  revokedAt                 DateTime?
  contentHash               String
  createdAt                 DateTime                      @default(now())
  updatedAt                 DateTime                      @updatedAt
  versions                  GoverningSourceVersion[]
  outgoingRelationships     GoverningSourceRelationship[] @relation("SourceRelationshipFrom")
  incomingRelationships     GoverningSourceRelationship[] @relation("SourceRelationshipTo")
  functionLinks             FunctionGoverningSource[]

  @@index([status])
  @@index([effectiveFrom])
  @@map("governing_sources")
}

model GoverningSourceVersion {
  id                   String          @id @default(uuid()) @db.Uuid
  governingSourceId    String          @db.Uuid
  versionLabel         String
  contentHash          String
  recordedAt           DateTime        @default(now())
  recordedByIdentityId String?         @db.Uuid
  governingSource      GoverningSource @relation(fields: [governingSourceId], references: [id])

  @@unique([governingSourceId, versionLabel])
  @@index([governingSourceId])
  @@map("governing_source_versions")
}

model GoverningSourceRelationship {
  id               String                          @id @default(uuid()) @db.Uuid
  fromSourceId     String                          @db.Uuid
  toSourceId       String                          @db.Uuid
  relationshipType GoverningSourceRelationshipType
  effectiveFrom    DateTime                        @default(now())
  effectiveUntil   DateTime?
  createdAt        DateTime                        @default(now())
  fromSource       GoverningSource                 @relation("SourceRelationshipFrom", fields: [fromSourceId], references: [id])
  toSource         GoverningSource                 @relation("SourceRelationshipTo", fields: [toSourceId], references: [id])

  @@index([fromSourceId])
  @@index([toSourceId])
  @@map("governing_source_relationships")
}

model FunctionGoverningSource {
  id                        String                  @id @default(uuid()) @db.Uuid
  functionAuthorityRecordId String                  @db.Uuid
  governingSourceId         String                  @db.Uuid
  isPrimary                 Boolean                 @default(true)
  createdAt                 DateTime                @default(now())
  functionAuthorityRecord   FunctionAuthorityRecord @relation(fields: [functionAuthorityRecordId], references: [id])
  governingSource           GoverningSource         @relation(fields: [governingSourceId], references: [id])

  @@unique([functionAuthorityRecordId, governingSourceId])
  @@index([functionAuthorityRecordId])
  @@index([governingSourceId])
  @@map("function_governing_sources")
}

model FunctionAuthorityAssignment {
  id                        String                   @id @default(uuid()) @db.Uuid
  functionAuthorityRecordId String                   @db.Uuid
  officeholderId            String?                  @db.Uuid
  officeId                  String?                  @db.Uuid
  institutionId             String?                  @db.Uuid
  status                    FunctionAssignmentStatus @default(PENDING)
  effectiveFrom             DateTime
  effectiveUntil            DateTime?
  createdAt                 DateTime                 @default(now())
  updatedAt                 DateTime                 @updatedAt
  functionAuthorityRecord   FunctionAuthorityRecord  @relation(fields: [functionAuthorityRecordId], references: [id])
  officeholder              Officeholder?            @relation(fields: [officeholderId], references: [id])
  office                    Office?                  @relation(fields: [officeId], references: [id])
  institution               Institution?             @relation(fields: [institutionId], references: [id])

  @@index([functionAuthorityRecordId])
  @@index([officeholderId])
  @@index([officeId])
  @@index([institutionId])
  @@map("function_authority_assignments")
}

model AuthorityActionRight {
  id                        String                  @id @default(uuid()) @db.Uuid
  functionAuthorityRecordId String                  @db.Uuid
  action                    AuthorityActionType
  permitted                 Boolean                 @default(false)
  requiresHumanActor        Boolean                 @default(true)
  createdAt                 DateTime                @default(now())
  updatedAt                 DateTime                @updatedAt
  functionAuthorityRecord   FunctionAuthorityRecord @relation(fields: [functionAuthorityRecordId], references: [id])

  @@unique([functionAuthorityRecordId, action])
  @@index([functionAuthorityRecordId])
  @@map("authority_action_rights")
}

model AuthorityCondition {
  id                        String                  @id @default(uuid()) @db.Uuid
  functionAuthorityRecordId String                  @db.Uuid
  conditionType             AuthorityConditionType
  configuration             Json                    @default("{}")
  isRequired                Boolean                 @default(true)
  createdAt                 DateTime                @default(now())
  updatedAt                 DateTime                @updatedAt
  functionAuthorityRecord   FunctionAuthorityRecord @relation(fields: [functionAuthorityRecordId], references: [id])

  @@index([functionAuthorityRecordId])
  @@map("authority_conditions")
}

model AuthorityDependency {
  id                        String                          @id @default(uuid()) @db.Uuid
  functionAuthorityRecordId String                          @db.Uuid
  dependencyType            AuthorityDependencyType
  externalAuthorityId       String?                         @db.Uuid
  competentAuthorityLabel   String?
  triggerCondition          String?
  requiredOutcome           String?
  blockingStatus            AuthorityDependencyBlockingStatus @default(BLOCKING)
  sourceProvision           String?
  requiredEvidenceReference String?
  status                    AuthorityDependencyStatus       @default(ACTIVE)
  effectiveFrom             DateTime?
  effectiveUntil            DateTime?
  configuration             Json                            @default("{}")
  createdAt                 DateTime                        @default(now())
  updatedAt                 DateTime                        @updatedAt
  functionAuthorityRecord   FunctionAuthorityRecord         @relation(fields: [functionAuthorityRecordId], references: [id])
  externalAuthority         ExternalAuthority?              @relation(fields: [externalAuthorityId], references: [id])
  externalDeterminations    ExternalDependencyDetermination[]

  @@index([functionAuthorityRecordId])
  @@index([externalAuthorityId])
  @@index([dependencyType])
  @@map("authority_dependencies")
}

model ExternalDependencyDetermination {
  id                     String                       @id @default(uuid()) @db.Uuid
  authorityDependencyId    String                       @db.Uuid
  externalAuthorityId    String                       @db.Uuid
  determinationReference String
  determinationStatus    ExternalDeterminationStatus
  effectiveDate          DateTime?
  expiryDate             DateTime?
  isAuthenticated        Boolean                      @default(false)
  scope                  String?
  receivedAt             DateTime                     @default(now())
  retainedQuestion       String?
  requiredDetermination  String?
  referralBasis          String?
  effectOnAbsezAction    String?
  createdAt              DateTime                     @default(now())
  updatedAt              DateTime                     @updatedAt
  authorityDependency    AuthorityDependency          @relation(fields: [authorityDependencyId], references: [id])
  externalAuthority      ExternalAuthority            @relation(fields: [externalAuthorityId], references: [id])

  @@index([authorityDependencyId])
  @@index([externalAuthorityId])
  @@map("external_dependency_determinations")
}

model InstitutionalAuthorityAct {
  id                        String                  @id @default(uuid()) @db.Uuid
  functionAuthorityRecordId String                  @db.Uuid
  institutionId             String?                 @db.Uuid
  externalAuthorityId       String?                 @db.Uuid
  actorOfficeholderId       String?                 @db.Uuid
  actorIdentityId           String?                 @db.Uuid
  actType                   InstitutionalActType
  decisionOrAction          String
  evidenceReference         String?
  legalEffect               String?
  performedAt               DateTime                @default(now())
  createdAt                 DateTime                @default(now())
  updatedAt                 DateTime                @updatedAt
  functionAuthorityRecord   FunctionAuthorityRecord @relation(fields: [functionAuthorityRecordId], references: [id])
  institution               Institution?            @relation(fields: [institutionId], references: [id])
  externalAuthority         ExternalAuthority?      @relation(fields: [externalAuthorityId], references: [id])

  @@index([functionAuthorityRecordId])
  @@map("institutional_authority_acts")
}

model SegregationOfDutyRule {
  id                        String                  @id @default(uuid()) @db.Uuid
  functionAuthorityRecordId String                  @db.Uuid
  ruleType                  SodRuleType
  conflictingAction         AuthorityActionType?
  configuration             Json                    @default("{}")
  createdAt                 DateTime                @default(now())
  updatedAt                 DateTime                @updatedAt
  functionAuthorityRecord   FunctionAuthorityRecord @relation(fields: [functionAuthorityRecordId], references: [id])

  @@index([functionAuthorityRecordId])
  @@map("segregation_of_duty_rules")
}

model RetainedNationalDetermination {
  id                        String                              @id @default(uuid()) @db.Uuid
  functionAuthorityRecordId String                              @db.Uuid
  determinedByIdentityId    String                              @db.Uuid
  status                    RetainedNationalDeterminationStatus @default(PENDING)
  effectiveFrom             DateTime
  effectiveUntil            DateTime?
  createdAt                 DateTime                            @default(now())
  updatedAt                 DateTime                            @updatedAt
  functionAuthorityRecord   FunctionAuthorityRecord             @relation(fields: [functionAuthorityRecordId], references: [id])

  @@index([functionAuthorityRecordId])
  @@map("retained_national_determinations")
}

model AuthorityEvaluationRecord {
  id                        String                     @id @default(uuid()) @db.Uuid
  functionAuthorityRecordId String                     @db.Uuid
  identityId                String                     @db.Uuid
  officeholderId            String?                    @db.Uuid
  appointmentId             String?                    @db.Uuid
  delegationId              String?                    @db.Uuid
  action                    AuthorityActionType
  outcome                   AuthorityEvaluationOutcome
  evaluatedAt               DateTime                   @default(now())
  contextSnapshot           Json
  explanationCodes          Json                       @default("[]")
  requestHash               String
  functionAuthorityRecord   FunctionAuthorityRecord    @relation(fields: [functionAuthorityRecordId], references: [id])

  @@index([functionAuthorityRecordId])
  @@index([identityId])
  @@index([evaluatedAt])
  @@index([requestHash])
  @@map("authority_evaluation_records")
}

model FunctionActivationAudit {
  id                        String                           @id @default(uuid()) @db.Uuid
  functionAuthorityRecordId String                           @db.Uuid
  previousStatus            FunctionAuthorityLifecycleStatus
  newStatus                 FunctionAuthorityLifecycleStatus
  actorIdentityId           String                           @db.Uuid
  reason                    String?
  createdAt                 DateTime                         @default(now())
  functionAuthorityRecord   FunctionAuthorityRecord          @relation(fields: [functionAuthorityRecordId], references: [id])

  @@index([functionAuthorityRecordId])
  @@map("function_activation_audits")
}

model DelegationStructuredScope {
  id                        String                  @id @default(uuid()) @db.Uuid
  delegationId              String                  @db.Uuid
  functionAuthorityRecordId String                  @db.Uuid
  allowedActionTypes        AuthorityActionType[]
  createdAt                 DateTime                @default(now())
  updatedAt                 DateTime                @updatedAt
  delegation                Delegation              @relation(fields: [delegationId], references: [id], onDelete: Cascade)
  functionAuthorityRecord   FunctionAuthorityRecord @relation(fields: [functionAuthorityRecordId], references: [id])

  @@unique([delegationId, functionAuthorityRecordId])
  @@index([delegationId])
  @@index([functionAuthorityRecordId])
  @@map("delegation_structured_scopes")
}

  outcome               ServicePackValidationOutcome
  issues                Json                         @default("[]")
  manifestVersion       String
  manifestChecksum      String
  validatedAt           DateTime                     @default(now())
  validatedByIdentityId String?                      @db.Uuid
  servicePackVersion    ServicePackVersion           @relation(fields: [servicePackVersionId], references: [id], onDelete: Cascade)
  import                ServicePackImport?           @relation(fields: [importId], references: [id])

model AnalysisRequest {
  id                    String                @id @default(uuid()) @db.Uuid
  requestNumber         String                @unique
  question              String
  functionType          AnalysisFunctionType
  status                AnalysisRequestStatus @default(DRAFT)
  institutionId         String?               @db.Uuid
  caseId                String?               @db.Uuid
  requestedByIdentityId String                @db.Uuid
  outputClassification  String                @default("NOT_LEGAL_ADVICE;NOT_PROFESSIONAL_CERTIFICATION;NOT_GOVERNMENT_DETERMINATION;NOT_FINAL_DECISION")
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  institution           Institution?          @relation(fields: [institutionId], references: [id])
  case                  Case?                 @relation(fields: [caseId], references: [id])
  requestedBy           Identity              @relation("AnalysisRequestRequester", fields: [requestedByIdentityId], references: [id])
  runs                  AnalysisRun[]

  @@index([status])
  @@index([institutionId])
  @@index([caseId])
  @@map("analysis_requests")
}

model AnalysisRun {
  id                    String            @id @default(uuid()) @db.Uuid
  runNumber             String            @unique
  requestId             String            @db.Uuid
  status                AnalysisRunStatus @default(PENDING)
  method                String
  assumptions           Json              @default("[]")
  limitations           String
  outputReplayHash      String?
  startedAt             DateTime?
  completedAt           DateTime?
  executedByIdentityId  String?           @db.Uuid
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  request               AnalysisRequest   @relation(fields: [requestId], references: [id], onDelete: Cascade)
  executedBy            Identity?         @relation("AnalysisRunExecutor", fields: [executedByIdentityId], references: [id])
  sources               AnalysisSource[]
  findings              AnalysisFinding[]
  options               AnalysisOption[]
  uncertainties         AnalysisUncertainty[]
  humanReviews          AnalysisHumanReview[]

  @@index([requestId])
  @@index([status])
  @@map("analysis_runs")
}

model AnalysisSource {
  id               String               @id @default(uuid()) @db.Uuid
  runId            String               @db.Uuid
  sourceReference  String
  sourceLabel      String
  sourceStatus     AnalysisSourceStatus
  exactValue       Json
  retrievedAt      DateTime?
  stalenessNotedAt DateTime?
  conflictGroupId  String?
  preservedConflict Boolean             @default(false)
  createdAt        DateTime             @default(now())
  run              AnalysisRun          @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId])
  @@index([conflictGroupId])
  @@map("analysis_sources")
}

model AnalysisFinding {
  id              String      @id @default(uuid()) @db.Uuid
  runId           String      @db.Uuid

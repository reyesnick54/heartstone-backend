  @@index([runId])
  @@map("analysis_findings")
}

model AnalysisOption {
  id          String      @id @default(uuid()) @db.Uuid
  runId       String      @db.Uuid
  optionLabel String
  description String
  tradeoffs   String?
  createdAt   DateTime    @default(now())
  run         AnalysisRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId])
  @@map("analysis_options")
}

model AnalysisUncertainty {
  id              String      @id @default(uuid()) @db.Uuid
  runId           String      @db.Uuid
  uncertaintyText String
  severity        String?
  createdAt       DateTime    @default(now())
  run             AnalysisRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId])
  @@map("analysis_uncertainties")
}

model AnalysisHumanReview {
  id                         String      @id @default(uuid()) @db.Uuid
  runId                      String      @db.Uuid
  reviewerIdentityId         String      @db.Uuid
  reviewNotes                String?
  professionalReviewRequired Boolean     @default(false)
  reviewedAt                 DateTime    @default(now())
  createdAt                  DateTime    @default(now())
  run                        AnalysisRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  reviewer                   Identity    @relation("AnalysisHumanReviewer", fields: [reviewerIdentityId], references: [id])

  @@index([runId])
  @@index([reviewerIdentityId])
  @@map("analysis_human_reviews")
}

model IntelligenceMonitoringRule {
  id                     String                           @id @default(uuid()) @db.Uuid
  code                   String                           @unique
  name                   String
  objectType             IntelligenceMonitoringObjectType
  objectReference        String
  approvedSourceReference String
  approvedSourceLabel    String
  conditionDescription   String
  detectionRule          Json                             @default("{}")
  thresholdConfig        Json                             @default("{}")
  ownerIdentityId        String                           @db.Uuid
  purpose                String
  reviewerIdentityId     String                           @db.Uuid
  frequency              IntelligenceMonitoringFrequency
  effectiveFrom          DateTime
  effectiveUntil         DateTime?
  institutionId          String?                          @db.Uuid
  lawfulBasis            String?
  accessApprovalRef      String?
  status                 IntelligenceMonitoringRuleStatus @default(DRAFT)
  createdAt              DateTime                         @default(now())
  updatedAt              DateTime                         @updatedAt

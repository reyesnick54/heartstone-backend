  TESTS_IN_PROGRESS
  TECHNICAL_TESTS_PASSED
  INSTITUTIONAL_REVIEW_PENDING
  INSTITUTIONAL_REVIEW_PASSED
}

enum ServiceReadinessLevel {
  NOT_READY
  TECHNICALLY_READY
  INSTITUTIONALLY_ACCEPTED
  OPERATIONALLY_ACTIVE
}

enum ServiceReadinessCheckOutcome {
  PASS
  FAIL
  REQUIRES_CONFIGURATION
  BLOCKED
}

enum ServiceActivationOutcome {
  ACTIVATED
  BLOCKED
  REQUIRES_CONFIGURATION
  REQUIRES_READINESS
  DENIED
}

model ServiceActivationRecord {
  id                          String                              @id @default(uuid()) @db.Uuid
  governmentServiceVersionId  String                              @db.Uuid
  priorMaturityStatus         GovernmentServiceMaturityStatus
  newMaturityStatus           GovernmentServiceMaturityStatus
  priorPublicAvailability     GovernmentServicePublicAvailability
  newPublicAvailability       GovernmentServicePublicAvailability
  actorIdentityId             String                              @db.Uuid
  officeholderId              String?                             @db.Uuid
  authorityEvaluationRecordId String?                             @db.Uuid
  activationBasis             String
  effectiveAt                 DateTime
  scopeLimitations            Json                                @default("[]")
  reason                      String?
  outcome                     ServiceActivationOutcome
  createdAt                   DateTime                            @default(now())
  governmentServiceVersion    GovernmentServiceVersion            @relation(fields: [governmentServiceVersionId], references: [id])
  authorityEvaluationRecord   AuthorityEvaluationRecord?          @relation(fields: [authorityEvaluationRecordId], references: [id])

  @@index([governmentServiceVersionId])
  @@index([actorIdentityId])
  @@index([createdAt])
  @@map("service_activation_records")
}

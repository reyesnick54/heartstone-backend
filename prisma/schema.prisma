  previousVersion             CivilRegistryVersion      @relation("AmendmentPreviousVersion", fields: [previousVersionId], references: [id])
  newVersion                  CivilRegistryVersion      @relation("AmendmentNewVersion", fields: [newVersionId], references: [id])

  @@index([civilRegistryEntryId])
  @@index([governmentDecisionId])

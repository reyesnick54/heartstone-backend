// ─── Corporate Registry / Business Formation ─────────────────────────────────

enum CorporateEntityType {
  COMPANY
  SOLE_TRADER
  FOREIGN_COMPANY
  BRANCH
}

enum CorporateRegistrationStatus {
  DRAFT
  PENDING_DECISION
  ACTIVE
  DISSOLVED
  RESTORED
  SUSPENDED
}

enum CorporateRegistryRecordStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  REJECTED
  SUPERSEDED
}

enum CorporateFilingType {
  ANNUAL
  AMENDMENT
  BENEFICIAL_OWNERSHIP
  INITIAL
  OTHER
}

enum CorporateFilingStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  ACCEPTED
  REJECTED
  OVERDUE
}

enum CorporateOfficerRole {
  DIRECTOR
  OFFICER
  SECRETARY
  OTHER
}

enum CorporateRegistryActionType {
  NAME_RESERVATION
  INCORPORATION
  AMENDMENT
  ANNUAL_FILING
  BENEFICIAL_OWNERSHIP_REVIEW
  DISSOLUTION
  RESTORATION
  CERTIFICATE_ISSUANCE
  RECORD_CORRECTION
  COMPLIANCE
  OTHER
}

enum CorporateRegistryActionStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum CorporateCertificateStatus {
  DRAFT
  PENDING_ISSUANCE
  ISSUED
  REVOKED
}

enum CorporateRegistryDecisionType {
  INCORPORATION
  REGISTRATION
  AMENDMENT
  DISSOLUTION
  RESTORATION
  CERTIFICATE_ISSUANCE
  RECORD_CORRECTION
  NAME_RESERVATION
}

enum CorporateRegistryStatusEventType {
  STATUS_CHANGE
  DISSOLUTION
  RESTORATION
  PAYMENT_RECEIVED
  OFFICIAL_DECISION
}

enum CorporatePublicVerificationMode {
  DISABLED
  MINIMAL_FACTS
}

model CorporateRegistryConfiguration {
  id                              String                        @id @default(uuid()) @db.Uuid
  configurationKey                  String                        @unique
  publicVerificationMode          CorporatePublicVerificationMode @default(DISABLED)
  exposeRegisteredOfficePublicly    Boolean                       @default(false)
  createdAt                         DateTime                      @default(now())
  updatedAt                         DateTime                      @updatedAt

  @@map("corporate_registry_configurations")
}

model CorporateRegistryProfile {
  id                         String                      @id @default(uuid()) @db.Uuid
  organizationId             String                      @unique @db.Uuid
  registeredName             String?
  registrationReference      String?                     @unique
  registrationStatus         CorporateRegistrationStatus @default(DRAFT)
  entityType                 CorporateEntityType?
  registrationDate           DateTime?
  jurisdictionCode           String?
  filingStatusSummary        String?
  publicVerificationReference String?                    @unique
  recordApprovalStatus       CorporateRegistryRecordStatus @default(DRAFT)
  createdAt                  DateTime                    @default(now())
  updatedAt                  DateTime                    @updatedAt
  organization               Organization                @relation(fields: [organizationId], references: [id])
  registeredOffices          CorporateRegisteredOffice[]
  officers                   CorporateOfficerDisclosure[]
  filings                    CorporateFiling[]
  beneficialOwnershipDeclarations CorporateBeneficialOwnershipDeclaration[]
  certificates               CorporateCertificate[]
  actions                    CorporateRegistryAction[]
  statusHistory              CorporateRegistryStatusHistory[]
  officialDecisions          CorporateRegistryOfficialDecision[]
  paymentEvents              CorporateRegistryPaymentEvent[]

  @@index([registrationStatus])
  @@index([registrationReference])
  @@map("corporate_registry_profiles")
}


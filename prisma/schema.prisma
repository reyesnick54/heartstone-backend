generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RecordStatus {
  ACTIVE
  SUSPENDED
  INACTIVE
  HISTORICAL
}

enum GovernmentBodyType {
  GOVERNING_BOARD
  COMMISSION
  COUNCIL
  COMMITTEE
  PANEL
  ADVISORY_BODY
  SUPERVISORY_BODY
  ADMINISTRATIVE_BODY
  OTHER
}

model SystemMetadata {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("system_metadata")
}

model Jurisdiction {
  id          String       @id @default(cuid())
  code        String       @unique
  name        String
  description String?
  status      RecordStatus @default(ACTIVE)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  institutions Institution[]

  @@map("jurisdictions")
}

model Institution {
  id             String       @id @default(cuid())
  jurisdictionId String
  code           String
  name           String
  description    String?
  status         RecordStatus @default(ACTIVE)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  jurisdiction    Jurisdiction     @relation(fields: [jurisdictionId], references: [id])
  governmentBodies GovernmentBody[]
  departments     Department[]

  @@unique([jurisdictionId, code])
  @@index([jurisdictionId])
  @@map("institutions")
}

model GovernmentBody {
  id            String             @id @default(cuid())
  institutionId String
  code          String
  name          String
  description   String?
  type          GovernmentBodyType
  status        RecordStatus       @default(ACTIVE)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  institution Institution @relation(fields: [institutionId], references: [id])

  @@unique([institutionId, code])
  @@index([institutionId])
  @@index([status])
  @@index([type])
  @@map("government_bodies")
}

model Department {
  id            String       @id @default(cuid())
  institutionId String
  code          String
  name          String
  description   String?
  status        RecordStatus @default(ACTIVE)
  createdAt     DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  institution Institution @relation(fields: [institutionId], references: [id])

  @@unique([institutionId, code])
  @@index([institutionId])
  @@index([status])
  @@map("departments")
}

  referralType          CaseReferralType
  status                CaseReferralStatus @default(PENDING)
  externalAuthorityId   String?            @db.Uuid
  institutionId         String?            @db.Uuid
  authorityDependencyId String?            @db.Uuid
  referralBasis         String?
  scope                 String?
  referredAt            DateTime           @default(now())
  acknowledgedAt        DateTime?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  case                  Case               @relation(fields: [caseId], references: [id], onDelete: Cascade)
  externalAuthority     ExternalAuthority? @relation(fields: [externalAuthorityId], references: [id])
  institution           Institution?       @relation(fields: [institutionId], references: [id])
  authorityDependency   AuthorityDependency? @relation(fields: [authorityDependencyId], references: [id])
  responses             CaseReferralResponse[]
  governmentCommunications GovernmentCommunicationRecord[]

  @@index([caseId])
  @@index([status])
  @@map("case_referrals")
}

model CaseReferralResponse {
  id                   String                         @id @default(uuid()) @db.Uuid
  caseReferralId       String                         @db.Uuid
  responseReference    String
  responseSummary      String
  authenticationStatus CaseReferralResponseAuthStatus @default(UNAUTHENTICATED)
  receivedAt           DateTime                       @default(now())
  satisfiesDependency  Boolean                        @default(false)
  createdAt            DateTime                       @default(now())
  updatedAt            DateTime                       @updatedAt
  caseReferral         CaseReferral                   @relation(fields: [caseReferralId], references: [id], onDelete: Cascade)

  @@index([caseReferralId])
  @@map("case_referral_responses")
}

model CaseSlaClock {
  id               String             @id @default(uuid()) @db.Uuid
  caseId           String             @db.Uuid
  clockKey         String
  status           CaseSlaClockStatus @default(RUNNING)
  startedAt        DateTime           @default(now())
  pausedAt         DateTime?
  resumedAt        DateTime?
  breachedAt       DateTime?
  completedAt      DateTime?
  targetDurationMs Int?
  elapsedMs        Int                @default(0)
  pausedDurationMs Int                @default(0)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  case             Case               @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@unique([caseId, clockKey])
  @@index([caseId])
  @@index([status])
  @@map("case_sla_clocks")
}

model CaseEscalation {
  id               String               @id @default(uuid()) @db.Uuid
  caseId           String               @db.Uuid
  status           CaseEscalationStatus @default(OPEN)
  reason           String
  escalatedAt      DateTime             @default(now())
  resolvedAt       DateTime?
  retainsAuthority Boolean              @default(true)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  case             Case                 @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId])
  @@index([status])
  @@map("case_escalations")
}

model CaseIssue {
  id          String            @id @default(uuid()) @db.Uuid
  caseId      String            @db.Uuid
  severity    CaseIssueSeverity @default(MEDIUM)
  status      CaseIssueStatus   @default(OPEN)
  title       String
  description String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  resolvedAt  DateTime?
  case        Case              @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId])
  @@index([status])
  @@map("case_issues")
}

// ─── Phase 7: Evidence Records ───────────────────────────────────────────────

enum DocumentAuthenticationStatus {
  UNAUTHENTICATED
  AUTHENTICATED
  REJECTED
}

enum EvidenceRecordStatus {
  REGISTERED
  UNDER_REVIEW
  SUPERSEDED
  ARCHIVED
}

enum DepartmentalReviewStatus {
  DRAFT
  IN_PROGRESS
  COMPLETED
  SUPERSEDED
}

enum GovernmentCommunicationCategory {
  RECEIPT
  ACKNOWLEDGMENT
  INFORMATION
  GUIDANCE
  CONSULTATION
  REQUEST
  RESPONSE
  CONCURRENCE
  OBJECTION
  RETAINED_DETERMINATION
  SUPERVISORY_FINDING
  INSPECTION_FINDING
  OTHER
}

enum GovernmentCommunicationAuthenticationStatus {
  UNAUTHENTICATED
  AUTHENTICATED
  REJECTED
}

enum ProfessionalOpinionStatus {
  DRAFT
  ISSUED
  SUPERSEDED
  WITHDRAWN
}

enum ProfessionalSignatureSource {
  CONTROLLED_PROFESSIONAL_ACTION
  AI_ASSISTANCE
  OTHER
}

enum InspectionType {
  SITE
  DESKTOP
  REMOTE
  FOLLOW_UP
  OTHER
}

enum InspectionStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum InspectionFindingClassification {
  OBSERVATION
  CONDITION
  NON_COMPLIANCE
  OTHER
}

enum EvidenceCustodyEventType {
  COLLECTED
  RECEIVED
  TRANSFERRED
  OPENED
  SAMPLED
  COPIED
  ANALYZED
  SEALED
  UNSEALED
  RETURNED
  ARCHIVED
  DISPOSED_AUTHORIZED
}

enum EvidenceIntegrityState {
  INTACT
  COMPROMISED
  UNKNOWN
}

model DocumentRecord {
  id                    String                       @id @default(uuid()) @db.Uuid
  caseId                String                       @db.Uuid
  documentReference     String
  title                 String?
  description           String?
  classification        CaseRecordClassification       @default(OFFICIAL)
  authenticationStatus  DocumentAuthenticationStatus @default(UNAUTHENTICATED)
  sourceInstitutionId   String?                      @db.Uuid
  receivedAt            DateTime?
  createdAt             DateTime                     @default(now())
  updatedAt             DateTime                     @updatedAt
  case                  Case                         @relation(fields: [caseId], references: [id])
  sourceInstitution     Institution?                 @relation(fields: [sourceInstitutionId], references: [id])
  evidenceRecords                EvidenceRecord[]
  custodyEvents                  EvidenceCustodyEvent[]            @relation("DocumentCustodyEvents")
  governmentCommunicationLinks   GovernmentCommunicationDocument[]

  @@index([caseId])
  @@index([documentReference])
  @@map("document_records")
}

model EvidenceRecord {
  id                  String               @id @default(uuid()) @db.Uuid
  caseId              String               @db.Uuid
  documentRecordId    String?              @db.Uuid
  evidenceReference   String
  description         String?
  classification      CaseRecordClassification @default(OFFICIAL)
  status              EvidenceRecordStatus @default(REGISTERED)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  case                Case                 @relation(fields: [caseId], references: [id])
  documentRecord      DocumentRecord?      @relation(fields: [documentRecordId], references: [id])
  custodyEvents       EvidenceCustodyEvent[] @relation("EvidenceCustodyEvents")
  inspectionItems     InspectionEvidenceItem[]
  departmentalReviews DepartmentalReviewEvidence[]
  professionalReviews ProfessionalReviewEvidence[]
  governmentCommunications GovernmentCommunicationEvidence[]

  @@index([caseId])
  @@index([evidenceReference])
  @@map("evidence_records")
}

model DepartmentalReviewRecord {
  id                           String                   @id @default(uuid()) @db.Uuid
  caseId                       String                   @db.Uuid
  departmentId                 String                   @db.Uuid
  reviewerIdentityId           String                   @db.Uuid
  reviewerOfficeholderId       String                   @db.Uuid
  reviewQuestion               String
  functionAuthorityRecordId    String                   @db.Uuid
  authorityEvaluationRecordId  String?                  @db.Uuid
  reviewVersion                Int                      @default(1)
  findings                     String
  limitations                  String?
  recommendationIfPermitted    String?
  status                       DepartmentalReviewStatus @default(DRAFT)
  completedAt                  DateTime?
  supersededById               String?                  @db.Uuid
  createdAt                    DateTime                 @default(now())
  updatedAt                    DateTime                 @updatedAt
  case                         Case                     @relation(fields: [caseId], references: [id])
  department                   Department               @relation(fields: [departmentId], references: [id])
  reviewerIdentity             Identity                 @relation("DepartmentalReviewReviewer", fields: [reviewerIdentityId], references: [id])
  reviewerOfficeholder         Officeholder             @relation("DepartmentalReviewOfficeholder", fields: [reviewerOfficeholderId], references: [id])
  functionAuthorityRecord      FunctionAuthorityRecord  @relation(fields: [functionAuthorityRecordId], references: [id])
  authorityEvaluationRecord    AuthorityEvaluationRecord? @relation(fields: [authorityEvaluationRecordId], references: [id])
  supersededBy                 DepartmentalReviewRecord? @relation("DepartmentalReviewSupersession", fields: [supersededById], references: [id])
  supersedes                   DepartmentalReviewRecord[] @relation("DepartmentalReviewSupersession")
  evidenceConsidered           DepartmentalReviewEvidence[]

  @@unique([caseId, departmentId, reviewVersion])
  @@index([caseId])
  @@index([departmentId])
  @@index([status])
  @@map("departmental_review_records")
}

model DepartmentalReviewEvidence {
  id                       String                   @id @default(uuid()) @db.Uuid
  departmentalReviewId     String                   @db.Uuid
  evidenceRecordId         String                   @db.Uuid
  createdAt                DateTime                 @default(now())
  departmentalReview       DepartmentalReviewRecord @relation(fields: [departmentalReviewId], references: [id], onDelete: Cascade)
  evidenceRecord           EvidenceRecord           @relation(fields: [evidenceRecordId], references: [id])

  @@unique([departmentalReviewId, evidenceRecordId])
  @@map("departmental_review_evidence")
}

model GovernmentCommunicationRecord {
  id                      String                                      @id @default(uuid()) @db.Uuid
  caseId                  String                                      @db.Uuid
  category                GovernmentCommunicationCategory
  sourceInstitutionId     String                                      @db.Uuid
  officialReference       String?
  senderReference         String?
  recipientReference      String?
  receivedAt              DateTime?
  sentAt                  DateTime?
  authenticationStatus    GovernmentCommunicationAuthenticationStatus @default(UNAUTHENTICATED)
  scope                   String?
  effectiveFrom           DateTime?
  effectiveUntil          DateTime?
  limitations             String?
  caseReferralId          String?                                     @db.Uuid
  retainedDeterminationForExternalAuthorityId String?               @db.Uuid
  createdAt               DateTime                                    @default(now())
  updatedAt               DateTime                                    @updatedAt
  case                    Case                                        @relation(fields: [caseId], references: [id])
  sourceInstitution       Institution                                 @relation(fields: [sourceInstitutionId], references: [id])
  caseReferral            CaseReferral?                               @relation(fields: [caseReferralId], references: [id])
  retainedDeterminationFor ExternalAuthority?                        @relation(fields: [retainedDeterminationForExternalAuthorityId], references: [id])
  documentRecords         GovernmentCommunicationDocument[]
  evidenceRecords         GovernmentCommunicationEvidence[]

  @@index([caseId])
  @@index([category])
  @@index([sourceInstitutionId])
  @@map("government_communication_records")
}

model GovernmentCommunicationDocument {
  id                            String                        @id @default(uuid()) @db.Uuid
  governmentCommunicationId     String                        @db.Uuid
  documentRecordId                String                        @db.Uuid
  createdAt                     DateTime                      @default(now())
  governmentCommunication       GovernmentCommunicationRecord @relation(fields: [governmentCommunicationId], references: [id], onDelete: Cascade)
  documentRecord                DocumentRecord                @relation(fields: [documentRecordId], references: [id])

  @@unique([governmentCommunicationId, documentRecordId])
  @@map("government_communication_documents")
}

model GovernmentCommunicationEvidence {
  id                            String                        @id @default(uuid()) @db.Uuid
  governmentCommunicationId     String                        @db.Uuid
  evidenceRecordId              String                        @db.Uuid
  createdAt                     DateTime                      @default(now())
  governmentCommunication       GovernmentCommunicationRecord @relation(fields: [governmentCommunicationId], references: [id], onDelete: Cascade)
  evidenceRecord                EvidenceRecord                @relation(fields: [evidenceRecordId], references: [id])

  @@unique([governmentCommunicationId, evidenceRecordId])
  @@map("government_communication_evidence")
}

model ProfessionalReviewRecord {
  id                           String                    @id @default(uuid()) @db.Uuid
  caseId                       String                    @db.Uuid
  professionType               String
  professionalIdentityId       String                    @db.Uuid
  qualificationReference       String?
  scopeOfEngagement            String
  questionReviewed             String
  methodology                  String?
  findings                     String
  limitations                  String?
  opinionStatus                ProfessionalOpinionStatus @default(DRAFT)
  signatureReference           String?
  signatureSource              ProfessionalSignatureSource?
  reviewDate                   DateTime?
  validFrom                    DateTime?
  validUntil                   DateTime?
  independenceDeclaration      String?
  conflictDeclaration          String?
  createdAt                    DateTime                  @default(now())
  updatedAt                    DateTime                  @updatedAt
  case                         Case                      @relation(fields: [caseId], references: [id])
  professionalIdentity         Identity                  @relation("ProfessionalReviewIdentity", fields: [professionalIdentityId], references: [id])
  evidenceReviewed             ProfessionalReviewEvidence[]

  @@index([caseId])
  @@index([professionalIdentityId])
  @@index([opinionStatus])
  @@map("professional_review_records")
}

model ProfessionalReviewEvidence {
  id                     String                   @id @default(uuid()) @db.Uuid
  professionalReviewId   String                   @db.Uuid
  evidenceRecordId       String                   @db.Uuid
  createdAt              DateTime                 @default(now())
  professionalReview     ProfessionalReviewRecord @relation(fields: [professionalReviewId], references: [id], onDelete: Cascade)
  evidenceRecord         EvidenceRecord           @relation(fields: [evidenceRecordId], references: [id])

  @@unique([professionalReviewId, evidenceRecordId])
  @@map("professional_review_evidence")
}

model InspectionRecord {
  id                        String            @id @default(uuid()) @db.Uuid
  caseId                    String            @db.Uuid
  inspectionType            InspectionType
  functionAuthorityRecordId   String?           @db.Uuid
  locationSite              String?
  inspectionDate            DateTime
  scope                     String
  method                    String?
  conditionsObserved        String?
  findings                  String?
  limitations               String?
  followUpRequired          Boolean           @default(false)
  status                    InspectionStatus  @default(SCHEDULED)
  createdAt                 DateTime          @default(now())
  updatedAt                 DateTime          @updatedAt
  case                      Case              @relation(fields: [caseId], references: [id])
  functionAuthorityRecord   FunctionAuthorityRecord? @relation(fields: [functionAuthorityRecordId], references: [id])
  inspectors                InspectionInspector[]
  evidenceItems             InspectionEvidenceItem[]

  @@index([caseId])
  @@index([status])
  @@map("inspection_records")
}

model InspectionInspector {
  id                String           @id @default(uuid()) @db.Uuid
  inspectionId      String           @db.Uuid
  officeholderId    String           @db.Uuid
  identityId        String           @db.Uuid
  createdAt         DateTime         @default(now())
  inspection        InspectionRecord @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  officeholder      Officeholder     @relation("InspectionInspectorOfficeholder", fields: [officeholderId], references: [id])
  identity          Identity         @relation("InspectionInspectorIdentity", fields: [identityId], references: [id])

  @@unique([inspectionId, officeholderId])
  @@map("inspection_inspectors")
}

model InspectionEvidenceItem {
  id                         String                        @id @default(uuid()) @db.Uuid
  inspectionId               String                        @db.Uuid
  evidenceRecordId           String                        @db.Uuid
  findingClassification      InspectionFindingClassification @default(OBSERVATION)
  observationNotes           String?
  createdAt                  DateTime                      @default(now())
  inspection                 InspectionRecord              @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  evidenceRecord             EvidenceRecord                @relation(fields: [evidenceRecordId], references: [id])
  custodyEvents              EvidenceCustodyEvent[]

  @@unique([inspectionId, evidenceRecordId])
  @@map("inspection_evidence_items")
}

model EvidenceCustodyEvent {
  id                       String                   @id @default(uuid()) @db.Uuid
  eventType                EvidenceCustodyEventType
  evidenceRecordId         String?                  @db.Uuid
  documentRecordId         String?                  @db.Uuid
  inspectionEvidenceItemId String?                  @db.Uuid
  custodianIdentityId      String                   @db.Uuid
  custodianOfficeholderId  String?                  @db.Uuid
  occurredAt               DateTime                 @default(now())
  fromLocation             String?
  toLocation               String?
  reason                   String?
  integrityState           EvidenceIntegrityState   @default(UNKNOWN)
  witnessIdentityId        String?                  @db.Uuid
  witnessOfficeholderId    String?                  @db.Uuid
  createdAt                DateTime                 @default(now())
  evidenceRecord           EvidenceRecord?          @relation("EvidenceCustodyEvents", fields: [evidenceRecordId], references: [id])
  documentRecord           DocumentRecord?          @relation("DocumentCustodyEvents", fields: [documentRecordId], references: [id])
  inspectionEvidenceItem   InspectionEvidenceItem?  @relation(fields: [inspectionEvidenceItemId], references: [id])
  custodianIdentity        Identity                 @relation("CustodyCustodianIdentity", fields: [custodianIdentityId], references: [id])
  custodianOfficeholder    Officeholder?            @relation("CustodyCustodianOfficeholder", fields: [custodianOfficeholderId], references: [id])
  witnessIdentity          Identity?                @relation("CustodyWitnessIdentity", fields: [witnessIdentityId], references: [id])
  witnessOfficeholder      Officeholder?            @relation("CustodyWitnessOfficeholder", fields: [witnessOfficeholderId], references: [id])

  @@index([evidenceRecordId, occurredAt])
  @@index([documentRecordId, occurredAt])
  @@index([eventType])
  @@map("evidence_custody_events")
}

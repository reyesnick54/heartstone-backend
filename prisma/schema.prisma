generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum StructuralLifecycleStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  ARCHIVED
}

enum JurisdictionType {
  NATIONAL
  SUBNATIONAL
  MUNICIPAL
  SPECIAL_ECONOMIC_ZONE
  REGULATORY
  SUBJECT_MATTER
  OTHER
}

enum InstitutionType {
  GOVERNMENT
  MINISTRY
  AGENCY
  AUTHORITY
  REGULATOR
  STATUTORY_BODY
  SPECIAL_ECONOMIC_ZONE_AUTHORITY
  PUBLIC_BODY
  OTHER
}

model SystemMetadata {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("system_metadata")
}

enum DelegationStatus {
  PLANNED
  ACTIVE
  SUSPENDED
  EXPIRED
  REVOKED
  ENDED
}

/// Minimal structural record for delegation FK targets (full domain in Phase 2A–2D).
model Institution {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  delegationsAsDelegator Delegation[] @relation("DelegatorInstitution")
  delegationsAsRecipient Delegation[] @relation("RecipientInstitution")

  @@map("institutions")
}

/// Minimal structural record for delegation FK targets (full domain in Phase 2A–2D).
model Office {
  id        String   @id @default(cuid())
  code      String   @unique
  title     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  delegationsAsDelegator Delegation[] @relation("DelegatorOffice")
  delegationsAsRecipient Delegation[] @relation("RecipientOffice")
enum AppointmentType {
  PERMANENT
  FIXED_TERM
  ACTING
  INTERIM
  TEMPORARY
  EX_OFFICIO
  OTHER
}

enum AppointmentStatus {
  PLANNED
  ACTIVE
  SUSPENDED
  ENDED
  REVOKED
}

/// Minimal Office record required for Appointment foreign-key integrity (Phase 2C scope).
model Office {
  id            String        @id @default(cuid())
  referenceCode String        @unique
  name          String
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  appointments  Appointment[]

  @@map("offices")
}

/// Minimal structural record for delegation FK targets (full domain in Phase 2A–2D).
model Officeholder {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  delegationsAsDelegator Delegation[] @relation("DelegatorOfficeholder")
  delegationsAsRecipient Delegation[] @relation("RecipientOfficeholder")
/// Minimal Officeholder record required for Appointment foreign-key integrity (Phase 2C scope).
model Officeholder {
  id            String        @id @default(cuid())
  referenceCode String        @unique
  displayName   String
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  appointments  Appointment[]

  @@map("officeholders")
}

/// Structural delegation record — institutional evidence only, not legal authority.
model Delegation {
  id               String           @id @default(cuid())
  referenceCode    String           @unique
  sourceReference  String
  scopeDescription String
  status           DelegationStatus
  effectiveFrom    DateTime
  effectiveUntil   DateTime?
  notes            String?

  delegatorInstitutionId  String?
  delegatorOfficeId       String?
  delegatorOfficeholderId String?

  recipientInstitutionId  String?
  recipientOfficeId       String?
  recipientOfficeholderId String?

  delegatorInstitution  Institution?  @relation("DelegatorInstitution", fields: [delegatorInstitutionId], references: [id])
  delegatorOffice       Office?         @relation("DelegatorOffice", fields: [delegatorOfficeId], references: [id])
  delegatorOfficeholder Officeholder?   @relation("DelegatorOfficeholder", fields: [delegatorOfficeholderId], references: [id])

  recipientInstitution  Institution?  @relation("RecipientInstitution", fields: [recipientInstitutionId], references: [id])
  recipientOffice       Office?         @relation("RecipientOffice", fields: [recipientOfficeId], references: [id])
  recipientOfficeholder Officeholder?   @relation("RecipientOfficeholder", fields: [recipientOfficeholderId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("delegations")
model Appointment {
  id                  String            @id @default(cuid())
  officeId            String
  officeholderId      String
  referenceCode       String            @unique
  appointmentType     AppointmentType
  status              AppointmentStatus
  effectiveFrom       DateTime
  effectiveUntil      DateTime?
  instrumentReference String?
  notes               String?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  office       Office       @relation(fields: [officeId], references: [id])
  officeholder Officeholder @relation(fields: [officeholderId], references: [id])

  @@index([officeId])
  @@index([officeholderId])
  @@index([status])
  @@index([appointmentType])
  @@index([effectiveFrom])
  @@index([effectiveUntil])
  @@map("appointments")
model Jurisdiction {
  id           String                    @id @default(uuid()) @db.Uuid
  code         String                    @unique
  name         String
  description  String?
  type         JurisdictionType
  status       StructuralLifecycleStatus @default(ACTIVE)
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt
  institutions Institution[]

  @@map("jurisdictions")
}

model Institution {
  id             String                    @id @default(uuid()) @db.Uuid
  jurisdictionId String                    @db.Uuid
  code           String
  name           String
  description    String?
  type           InstitutionType
  status         StructuralLifecycleStatus @default(ACTIVE)
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt
  jurisdiction   Jurisdiction              @relation(fields: [jurisdictionId], references: [id])

  @@unique([jurisdictionId, code])
  @@map("institutions")
}

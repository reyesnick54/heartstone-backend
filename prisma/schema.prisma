  createdAt               DateTime                 @default(now())
  actorIdentity           Identity?                @relation("RecordIntegrityActor", fields: [actorIdentityId], references: [id])
  actorOfficeholder       Officeholder?            @relation("RecordIntegrityActorOfficeholder", fields: [actorOfficeholderId], references: [id])

  @@index([recordType, recordId, occurredAt])
  @@index([eventType])
  @@map("record_integrity_events")
}

model RecordAccessEvent {
  id                   String                @id @default(uuid()) @db.Uuid
  recordType           String
  recordId             String                @db.Uuid
  accessType           RecordAccessEventType
  identityId           String?               @db.Uuid
  officeholderId       String?               @db.Uuid

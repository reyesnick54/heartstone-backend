  alerts                 IntelligenceMonitoringAlert[]

  @@index([status])
  @@index([objectType, objectReference])
  @@index([institutionId])
  @@map("intelligence_monitoring_rules")
}

model IntelligenceMonitoringObservation {
  id                String                     @id @default(uuid()) @db.Uuid
  ruleId            String                     @db.Uuid
  observedCondition String

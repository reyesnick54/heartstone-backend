  documentDeficiencies       CustomsDocumentDeficiency[]
  appeals                    CustomsAppeal[]
  aiRecommendations          CustomsAiRecommendation[]

  @@index([organizationId])
  @@index([tradeOrganizationProfileId])
  @@index([representativeAuthorityId])
  @@index([status])
  @@map("trade_shipments")
}

model CustomsDeclaration {
  id                         String                     @id @default(uuid()) @db.Uuid
  organizationId             String                     @db.Uuid
  tradeOrganizationProfileId String                     @db.Uuid

model RecordCorrection {
  id                            String                 @id @default(uuid()) @db.Uuid
  targetRecordType              String
  targetRecordId                String                 @db.Uuid
  targetVersionId               String?                @db.Uuid
  requestedBy                   String                 @db.Uuid
  requestedAt                   DateTime               @default(now())
  errorOrDisputeDescription     String
  supportingEvidenceIds         Json                   @default("[]")
  correctionAuthorityFunctionId String?                @db.Uuid
  authorityEvaluationRecordId   String?                @db.Uuid
  approvedByIdentityId          String?                @db.Uuid
  approvedByOfficeholderId      String?                @db.Uuid
  approvedAt                    DateTime?
  replacementRecordReference    String?
  downstreamAffectedReferences  Json                   @default("[]")
  reassessmentRequired          Boolean                @default(false)
  noticeRequired                Boolean                @default(false)
  status                        RecordCorrectionStatus @default(REQUESTED)
  reason                        String?
  createdAt                     DateTime               @default(now())
  updatedAt                     DateTime               @updatedAt
  requester                     Identity               @relation("RecordCorrectionRequester", fields: [requestedBy], references: [id])
  approverIdentity              Identity?              @relation("RecordCorrectionApprover", fields: [approvedByIdentityId], references: [id])
  approverOfficeholder          Officeholder?          @relation("RecordCorrectionApproverOfficeholder", fields: [approvedByOfficeholderId], references: [id])
  authorityEvaluationRecord     AuthorityEvaluationRecord? @relation(fields: [authorityEvaluationRecordId], references: [id])

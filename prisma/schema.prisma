  @@map("simulation_uncertainties")
}

model SimulationReview {
  id                      String                  @id @default(uuid()) @db.Uuid
  simulationRunId         String                  @db.Uuid
  reviewerIdentityId      String?                 @db.Uuid
  reviewerOfficeholderId  String?                 @db.Uuid
  outcome                 SimulationReviewOutcome @default(DRAFT)
  reviewNotes             String?
  reviewedAt              DateTime?

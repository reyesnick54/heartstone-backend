  CARD
  BANK_TRANSFER
  CASH_COUNTER
  GOVERNMENT_TREASURY
  MOBILE_WALLET
  OTHER
}

enum PaymentIntentStatus {
  CREATED
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
  CANCELLED
  EXPIRED
}

enum PaymentTransactionStatus {
  PENDING
  AUTHORIZED
  SETTLED
  FAILED
  REVERSED
  CHARGEBACK
}

enum PaymentWebhookProcessingStatus {
  RECEIVED
  AUTHENTICATED
  PROCESSED
  DUPLICATE
  REJECTED
  FAILED
}

// ─── Phase 11C: Refunds, Adjustments, Reconciliation ─────────────────────────

enum FeeAdjustmentRequestStatus {
  PENDING
  DECIDED
  WITHDRAWN
}

enum RefundRequestStatus {
  PENDING
  AUTHORIZED
  PROCESSING
  COMPLETED
  REJECTED
  FAILED
}

enum RefundTransactionStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum ReconciliationBatchStatus {
  OPEN
  IN_PROGRESS
  EXCEPTION
  CLOSED
}

enum ReconciliationItemStatus {
  MATCHED
  MISMATCH
  EXCEPTION
  RESOLVED
}

enum FinancialDisputeStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  ESCALATED
}

enum ArrearsRecordStatus {
  OUTSTANDING
  PARTIALLY_PAID
  PAID
  WRITTEN_OFF
  DISPUTED
}

// ─── Phase 11D: Communications ───────────────────────────────────────────────

enum CommunicationTemplateStatus {
  DRAFT
  APPROVED
  ACTIVE
  SUPERSEDED
  RETIRED
}

enum CommunicationChannelType {
  EMAIL
  SMS
  PORTAL
  POSTAL
  IN_PERSON
  GOVERNMENT_SECURE_MESSAGING
  OTHER
}

enum CommunicationMessageStatus {
  DRAFT
  APPROVED
  QUEUED
  DELIVERING
  DELIVERED
  PARTIALLY_DELIVERED
  FAILED
  CANCELLED
}

enum CommunicationDeliveryStatus {
  PENDING
  IN_PROGRESS
  DELIVERED
  FAILED
  BOUNCED
  SUPERSEDED
}

enum CommunicationReceiptType {
  DELIVERY_CONFIRMATION
  READ_RECEIPT
  LEGAL_ACKNOWLEDGMENT
  SIGNATURE_CAPTURE
}

enum MandatoryCommunicationRuleStatus {
  ACTIVE
  INACTIVE
}

enum ReconciliationExceptionStatus {
  OPEN
  UNDER_INVESTIGATION
  RESOLVED
  CLOSED
}

enum CommunicationFailureRetryState {
  NOT_RETRYABLE
  PENDING_RETRY
  RETRYING
  RETRY_EXHAUSTED
  RESOLVED
}

// ─── Phase 11E: Integrations ─────────────────────────────────────────────────

enum IntegrationAcceptanceStatus {
  TECHNICALLY_CONNECTED
  TESTED
  TECHNICALLY_READY
  INSTITUTIONALLY_ACCEPTED
  OPERATIONALLY_ACTIVE
  SUSPENDED
  REVALIDATION_REQUIRED
}

enum IntegrationDefinitionStatus {
  DRAFT
  PENDING_ACCEPTANCE
  ACCEPTED
  ACTIVE
  SUSPENDED
  RETIRED
}

enum IntegrationEndpointDirection {
  INBOUND
  OUTBOUND
  BIDIRECTIONAL
}

enum DataExchangeFieldDirection {
  INBOUND
  OUTBOUND
  BIDIRECTIONAL
}

enum AuthoritativeSourceStatus {
  AUTHORITATIVE
  SUPPORTING
  MODELED
  UNVERIFIED
  STALE
}

enum IntegrationRequestStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  FAILED
  SAFE_HALTED
  CANCELLED
}

enum IntegrationExchangeStatus {
  INITIATED
  SENT
  ACKNOWLEDGED
  COMPLETED
  FAILED
  SAFE_HALTED
}

enum IntegrationMessageDirection {
  INBOUND
  OUTBOUND
}

enum IntegrationWebhookProcessingStatus {
  RECEIVED
  AUTHENTICATED
  PROCESSED
  DUPLICATE
  REJECTED
  FAILED
}

enum SourceDiscrepancyStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  SAFE_HALTED
}

enum IntegrationOutageStatus {
  DETECTED
  CONFIRMED
  RECOVERING
  RESOLVED
}

enum IntegrationFallbackStatus {
  ACTIVATED
  IN_USE
  RECONCILING
  DEACTIVATED
}

enum IntegrationReconciliationStatus {
  OPEN
  IN_PROGRESS
  EXCEPTION
  CLOSED
}

enum RegistryQueryStatus {
  PENDING
  COMPLETED
  FAILED
  TIMEOUT
  SAFE_HALTED
}

enum RegistrySynchronizationResult {
  SUCCESS
  PARTIAL
  FAILED
}

model FeeSchedule {
  id                  String               @id @default(uuid()) @db.Uuid
  institutionId       String               @db.Uuid
  governmentServiceId String?              @db.Uuid
  code                String
  name                String
  description         String?
  status              FeeScheduleStatus    @default(DRAFT)
  currency            String               @default("XCD")
  effectiveFrom       DateTime?
  effectiveUntil      DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  institution         Institution          @relation(fields: [institutionId], references: [id])
  governmentService   GovernmentService?   @relation(fields: [governmentServiceId], references: [id])
  versions            FeeScheduleVersion[]

  @@unique([institutionId, code])
  @@index([institutionId])
  @@index([governmentServiceId])
  @@index([status])
  @@map("fee_schedules")
}

model FeeScheduleVersion {
  id                   String                    @id @default(uuid()) @db.Uuid
  feeScheduleId        String                    @db.Uuid
  versionNumber        String
  status               FeeScheduleStatus         @default(DRAFT)
  changeSummary        String?
  approvedAt           DateTime?
  approvedByIdentityId String?                   @db.Uuid
  effectiveFrom        DateTime?
  effectiveUntil       DateTime?
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt
  feeSchedule          FeeSchedule               @relation(fields: [feeScheduleId], references: [id], onDelete: Cascade)
  approvedBy           Identity?                 @relation("FeeScheduleVersionApprover", fields: [approvedByIdentityId], references: [id])
  items                FeeScheduleItem[]
  feeAssessments       FeeAssessment[]
  financialApprovals   FinancialApprovalRecord[]

  @@unique([feeScheduleId, versionNumber])
  @@index([feeScheduleId])
  @@index([status])
  @@index([approvedByIdentityId])
  @@map("fee_schedule_versions")
}

model FeeScheduleItem {
  id                   String             @id @default(uuid()) @db.Uuid
  feeScheduleVersionId String             @db.Uuid
  itemCode             String
  label                String
  description          String?
  amountCents          Int?
  currency             String             @default("XCD")
  isVariable           Boolean            @default(false)
  calculationFormula   String?
  sortOrder            Int                @default(0)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  feeScheduleVersion   FeeScheduleVersion @relation(fields: [feeScheduleVersionId], references: [id], onDelete: Cascade)
  invoiceLines         InvoiceLine[]

  @@unique([feeScheduleVersionId, itemCode])
  @@index([feeScheduleVersionId])
  @@map("fee_schedule_items")
}

model FeeAssessment {
  id                         String                    @id @default(uuid()) @db.Uuid
  caseId                     String?                   @db.Uuid
  applicationId              String?                   @db.Uuid
  feeScheduleVersionId       String                    @db.Uuid
  masterAdministrativeFileId String?                   @db.Uuid
  assessmentReference        String                    @unique
  status                     FeeAssessmentStatus       @default(CALCULATED)
  totalAmountCents           Int
  currency                   String                    @default("XCD")
  calculatedAt               DateTime                  @default(now())
  waivedAt                   DateTime?
  notes                      String?
  createdAt                  DateTime                  @default(now())
  updatedAt                  DateTime                  @updatedAt
  case                       Case?                     @relation(fields: [caseId], references: [id])
  application                Application?              @relation(fields: [applicationId], references: [id])
  feeScheduleVersion         FeeScheduleVersion        @relation(fields: [feeScheduleVersionId], references: [id])
  masterAdministrativeFile   MasterAdministrativeFile? @relation(fields: [masterAdministrativeFileId], references: [id])
  invoices                   Invoice[]
  feeAdjustmentRequests      FeeAdjustmentRequest[]

  @@index([caseId])
  @@index([applicationId])
  @@index([feeScheduleVersionId])
  @@index([masterAdministrativeFileId])
  @@index([status])
  @@map("fee_assessments")
}

model Invoice {
  id                         String                   @id @default(uuid()) @db.Uuid
  feeAssessmentId            String                   @db.Uuid
  caseId                     String?                  @db.Uuid
  masterAdministrativeFileId String                   @db.Uuid
  invoiceNumber              String                   @unique
  status                     InvoiceStatus            @default(DRAFT)
  totalAmountCents           Int
  amountPaidCents            Int                      @default(0)
  currency                   String                   @default("XCD")
  issuedAt                   DateTime?
  dueAt                      DateTime?
  cancelledAt                DateTime?
  createdAt                  DateTime                 @default(now())
  updatedAt                  DateTime                 @updatedAt
  feeAssessment              FeeAssessment            @relation(fields: [feeAssessmentId], references: [id])
  case                       Case?                    @relation(fields: [caseId], references: [id])
  masterAdministrativeFile   MasterAdministrativeFile @relation(fields: [masterAdministrativeFileId], references: [id])
  lines                      InvoiceLine[]
  paymentIntents             PaymentIntent[]
  arrearsRecords             ArrearsRecord[]
  financialDisputes          FinancialDispute[]
  taxLiabilities             TaxLiability[]

  @@index([feeAssessmentId])
  @@index([caseId])
  @@index([masterAdministrativeFileId])
  @@index([status])
  @@map("invoices")
}

model InvoiceLine {
  id                 String              @id @default(uuid()) @db.Uuid
  invoiceId          String              @db.Uuid
  feeScheduleItemId  String?             @db.Uuid
  lineCode           String
  description        String
  quantity           Int                 @default(1)
  unitAmountCents    Int
  lineAmountCents    Int
  sortOrder          Int                 @default(0)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  invoice            Invoice             @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  feeScheduleItem    FeeScheduleItem?    @relation(fields: [feeScheduleItemId], references: [id])
  paymentAllocations PaymentAllocation[]

  @@index([invoiceId])
  @@index([feeScheduleItemId])
  @@map("invoice_lines")
}

model PaymentChannelDefinition {
  id                     String                         @id @default(uuid()) @db.Uuid
  code                   String                         @unique
  name                   String
  channelType            PaymentChannelType
  description            String?
  isActive               Boolean                        @default(true)
  configurationSchema    Json                           @default("{}")
  createdAt              DateTime                       @default(now())
  updatedAt              DateTime                       @updatedAt
  providerConfigurations PaymentProviderConfiguration[]

  @@index([channelType])
  @@index([isActive])
  @@map("payment_channel_definitions")
}

model PaymentProviderConfiguration {
  id                         String                        @id @default(uuid()) @db.Uuid
  paymentChannelDefinitionId String                        @db.Uuid
  institutionId              String?                       @db.Uuid
  providerCode               String
  providerName               String
  configuration              Json                          @default("{}")
  isActive                   Boolean                       @default(true)
  createdAt                  DateTime                      @default(now())
  updatedAt                  DateTime                      @updatedAt
  paymentChannelDefinition   PaymentChannelDefinition      @relation(fields: [paymentChannelDefinitionId], references: [id])
  institution                Institution?                  @relation(fields: [institutionId], references: [id])
  transactions               PaymentTransaction[]
  webhookEvents              PaymentProviderWebhookEvent[]

  @@unique([paymentChannelDefinitionId, providerCode, institutionId])
  @@index([paymentChannelDefinitionId])
  @@index([institutionId])
  @@index([isActive])
  @@map("payment_provider_configurations")
}

model PaymentIntent {
  id              String               @id @default(uuid()) @db.Uuid
  invoiceId       String               @db.Uuid
  intentReference String               @unique
  status          PaymentIntentStatus  @default(CREATED)
  amountCents     Int
  currency        String               @default("XCD")
  expiresAt       DateTime?
  completedAt     DateTime?
  failureReason   String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  invoice         Invoice              @relation(fields: [invoiceId], references: [id])
  transactions    PaymentTransaction[]

  @@index([invoiceId])
  @@index([status])
  @@map("payment_intents")
}

model PaymentTransaction {
  id                             String                       @id @default(uuid()) @db.Uuid
  paymentIntentId                String                       @db.Uuid
  paymentProviderConfigurationId String                       @db.Uuid
  providerTransactionReference   String
  status                         PaymentTransactionStatus     @default(PENDING)
  amountCents                    Int
  currency                       String                       @default("XCD")
  authorizedAt                   DateTime?
  settledAt                      DateTime?
  failureReason                  String?
  rawResponse                    Json?
  createdAt                      DateTime                     @default(now())
  updatedAt                      DateTime                     @updatedAt
  paymentIntent                  PaymentIntent                @relation(fields: [paymentIntentId], references: [id])
  paymentProviderConfiguration   PaymentProviderConfiguration @relation(fields: [paymentProviderConfigurationId], references: [id])
  allocations                    PaymentAllocation[]
  receipts                       PaymentReceipt[]
  refundRequests                 RefundRequest[]
  reconciliationItems            ReconciliationItem[]
  financialDisputes              FinancialDispute[]
  events                         PaymentTransactionEvent[]
  taxPaymentAllocations          TaxPaymentAllocation[]

  @@unique([paymentProviderConfigurationId, providerTransactionReference])
  @@index([paymentIntentId])
  @@index([paymentProviderConfigurationId])
  @@index([status])
  @@map("payment_transactions")
}

model PaymentAllocation {
  id                   String             @id @default(uuid()) @db.Uuid
  paymentTransactionId String             @db.Uuid
  invoiceLineId        String?            @db.Uuid
  allocatedAmountCents Int
  allocationType       String
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  paymentTransaction   PaymentTransaction @relation(fields: [paymentTransactionId], references: [id], onDelete: Cascade)
  invoiceLine          InvoiceLine?       @relation(fields: [invoiceLineId], references: [id])
  taxPaymentAllocations TaxPaymentAllocation[]

  @@index([paymentTransactionId])
  @@index([invoiceLineId])
  @@map("payment_allocations")
}

model PaymentReceipt {
  id                   String             @id @default(uuid()) @db.Uuid
  paymentTransactionId String             @db.Uuid
  receiptNumber        String             @unique
  issuedAt             DateTime           @default(now())
  contentHash          String?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  paymentTransaction   PaymentTransaction @relation(fields: [paymentTransactionId], references: [id], onDelete: Cascade)

  @@index([paymentTransactionId])
  @@map("payment_receipts")
}

model PaymentProviderWebhookEvent {
  id                             String                         @id @default(uuid()) @db.Uuid
  paymentProviderConfigurationId String                         @db.Uuid
  eventType                      String
  externalEventId                String
  payload                        Json
  processingStatus               PaymentWebhookProcessingStatus @default(RECEIVED)
  processedAt                    DateTime?
  failureReason                  String?
  createdAt                      DateTime                       @default(now())
  updatedAt                      DateTime                       @updatedAt
  paymentProviderConfiguration   PaymentProviderConfiguration   @relation(fields: [paymentProviderConfigurationId], references: [id])

  @@unique([paymentProviderConfigurationId, externalEventId])
  @@index([paymentProviderConfigurationId])
  @@index([processingStatus])
  @@map("payment_provider_webhook_events")
}

model FeeAdjustmentRequest {
  id                    String                     @id @default(uuid()) @db.Uuid
  feeAssessmentId       String                     @db.Uuid
  requestedAmountCents  Int
  requestedByIdentityId String?                    @db.Uuid
  reason                String
  status                FeeAdjustmentRequestStatus @default(PENDING)
  createdAt             DateTime                   @default(now())
  updatedAt             DateTime                   @updatedAt
  feeAssessment         FeeAssessment              @relation(fields: [feeAssessmentId], references: [id])
  requestedBy           Identity?                  @relation("FeeAdjustmentRequestRequester", fields: [requestedByIdentityId], references: [id])
  decisions             FeeAdjustmentDecision[]

  @@index([feeAssessmentId])
  @@index([status])
  @@index([requestedByIdentityId])
  @@map("fee_adjustment_requests")
}

model FeeAdjustmentDecision {
  id                     String                       @id @default(uuid()) @db.Uuid
  feeAdjustmentRequestId String                       @db.Uuid
  decidedByIdentityId    String?                      @db.Uuid
  outcome                FeeAdjustmentDecisionOutcome
  adjustedAmountCents    Int?
  reason                 String?
  decidedAt              DateTime                     @default(now())
  createdAt              DateTime                     @default(now())
  updatedAt              DateTime                     @updatedAt
  feeAdjustmentRequest   FeeAdjustmentRequest         @relation(fields: [feeAdjustmentRequestId], references: [id], onDelete: Cascade)
  decidedBy              Identity?                    @relation("FeeAdjustmentDecisionDecider", fields: [decidedByIdentityId], references: [id])

  @@index([feeAdjustmentRequestId])
  @@index([decidedByIdentityId])
  @@map("fee_adjustment_decisions")
}

model RefundRequest {
  id                            String                       @id @default(uuid()) @db.Uuid
  paymentTransactionId          String                       @db.Uuid
  redressImplementationActionId String?                      @db.Uuid
  requestedAmountCents          Int
  reason                        String
  status                        RefundRequestStatus          @default(PENDING)
  requestedByIdentityId         String?                      @db.Uuid
  createdAt                     DateTime                     @default(now())
  updatedAt                     DateTime                     @updatedAt
  paymentTransaction            PaymentTransaction           @relation(fields: [paymentTransactionId], references: [id])
  redressImplementationAction   RedressImplementationAction? @relation(fields: [redressImplementationActionId], references: [id])
  requestedBy                   Identity?                    @relation("RefundRequestRequester", fields: [requestedByIdentityId], references: [id])
  authorizations                RefundAuthorization[]
  transactions                  RefundTransaction[]

  @@index([paymentTransactionId])
  @@index([redressImplementationActionId])
  @@index([status])
  @@index([requestedByIdentityId])
  @@map("refund_requests")
}

model RefundAuthorization {
  id                     String                    @id @default(uuid()) @db.Uuid
  refundRequestId        String                    @db.Uuid
  authorizedByIdentityId String?                   @db.Uuid
  authorizedAmountCents  Int
  authorizationReference String                    @unique
  authorizedAt           DateTime                  @default(now())
  createdAt              DateTime                  @default(now())
  updatedAt              DateTime                  @updatedAt
  refundRequest          RefundRequest             @relation(fields: [refundRequestId], references: [id], onDelete: Cascade)
  authorizedBy           Identity?                 @relation("RefundAuthorizationAuthorizer", fields: [authorizedByIdentityId], references: [id])
  transactions           RefundTransaction[]
  financialApprovals     FinancialApprovalRecord[]

  @@index([refundRequestId])
  @@index([authorizedByIdentityId])
  @@map("refund_authorizations")
}

model RefundTransaction {
  id                      String                  @id @default(uuid()) @db.Uuid
  refundRequestId         String                  @db.Uuid
  refundAuthorizationId   String?                 @db.Uuid
  providerRefundReference String?
  amountCents             Int
  status                  RefundTransactionStatus @default(PENDING)
  processedAt             DateTime?
  failureReason           String?
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt
  refundRequest           RefundRequest           @relation(fields: [refundRequestId], references: [id], onDelete: Cascade)
  refundAuthorization     RefundAuthorization?    @relation(fields: [refundAuthorizationId], references: [id])

  @@index([refundRequestId])
  @@index([refundAuthorizationId])
  @@index([status])
  @@map("refund_transactions")
}

model ReconciliationBatch {
  id                 String                    @id @default(uuid()) @db.Uuid
  institutionId      String?                   @db.Uuid
  batchReference     String                    @unique
  status             ReconciliationBatchStatus @default(OPEN)
  periodStart        DateTime
  periodEnd          DateTime
  openedAt           DateTime                  @default(now())
  closedAt           DateTime?
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt
  institution        Institution?              @relation(fields: [institutionId], references: [id])
  items              ReconciliationItem[]
  financialApprovals FinancialApprovalRecord[]

  @@index([institutionId])
  @@index([status])
  @@map("reconciliation_batches")
}

model ReconciliationItem {
  id                    String                   @id @default(uuid()) @db.Uuid
  reconciliationBatchId String                   @db.Uuid
  paymentTransactionId  String?                  @db.Uuid
  externalReference     String?
  expectedAmountCents   Int
  actualAmountCents     Int?
  status                ReconciliationItemStatus @default(MISMATCH)
  resolvedAt            DateTime?
  resolutionNotes       String?
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt
  reconciliationBatch   ReconciliationBatch      @relation(fields: [reconciliationBatchId], references: [id], onDelete: Cascade)
  paymentTransaction    PaymentTransaction?      @relation(fields: [paymentTransactionId], references: [id])
  exception             ReconciliationException?

  @@index([reconciliationBatchId])
  @@index([paymentTransactionId])
  @@index([status])
  @@map("reconciliation_items")
}

model FinancialDispute {
  id                   String                 @id @default(uuid()) @db.Uuid
  invoiceId            String?                @db.Uuid
  paymentTransactionId String?                @db.Uuid
  disputeReference     String                 @unique
  status               FinancialDisputeStatus @default(OPEN)
  amountCents          Int
  reason               String
  openedAt             DateTime               @default(now())
  resolvedAt           DateTime?
  resolutionSummary    String?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  invoice              Invoice?               @relation(fields: [invoiceId], references: [id])
  paymentTransaction   PaymentTransaction?    @relation(fields: [paymentTransactionId], references: [id])

  @@index([invoiceId])
  @@index([paymentTransactionId])
  @@index([status])
  @@map("financial_disputes")
}

model ArrearsRecord {
  id                     String              @id @default(uuid()) @db.Uuid
  invoiceId              String              @db.Uuid
  outstandingAmountCents Int
  status                 ArrearsRecordStatus @default(OUTSTANDING)
  asOfDate               DateTime            @default(now())
  writtenOffAt           DateTime?
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt
  invoice                Invoice             @relation(fields: [invoiceId], references: [id])

  @@index([invoiceId])
  @@index([status])
  @@map("arrears_records")
}

model FinancialApprovalRecord {
  id                    String                  @id @default(uuid()) @db.Uuid
  approvalType          FinancialApprovalType
  status                FinancialApprovalStatus @default(PENDING)
  subjectReference      String
  subjectType           String
  approvedByIdentityId  String?                 @db.Uuid
  approvedAt            DateTime?
  rejectionReason       String?
  feeScheduleVersionId  String?                 @db.Uuid
  refundAuthorizationId String?                 @db.Uuid
  reconciliationBatchId String?                 @db.Uuid
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  approvedBy            Identity?               @relation("FinancialApprovalApprover", fields: [approvedByIdentityId], references: [id])
  feeScheduleVersion    FeeScheduleVersion?     @relation(fields: [feeScheduleVersionId], references: [id])
  refundAuthorization   RefundAuthorization?    @relation(fields: [refundAuthorizationId], references: [id])
  reconciliationBatch   ReconciliationBatch?    @relation(fields: [reconciliationBatchId], references: [id])

  @@index([approvalType])
  @@index([status])
  @@index([approvedByIdentityId])
  @@index([feeScheduleVersionId])
  @@index([refundAuthorizationId])
  @@index([reconciliationBatchId])
  @@map("financial_approval_records")
}

model CommunicationTemplate {
  id            String                         @id @default(uuid()) @db.Uuid
  code          String                         @unique
  name          String
  channelType   CommunicationChannelType
  institutionId String?                        @db.Uuid
  status        CommunicationTemplateStatus    @default(DRAFT)
  createdAt     DateTime                       @default(now())
  updatedAt     DateTime                       @updatedAt
  institution   Institution?                   @relation(fields: [institutionId], references: [id])
  versions      CommunicationTemplateVersion[]

  @@index([institutionId])
  @@index([status])
  @@index([channelType])
  @@map("communication_templates")
}

model CommunicationTemplateVersion {
  id                      String                       @id @default(uuid()) @db.Uuid
  communicationTemplateId String                       @db.Uuid
  versionNumber           String
  subjectTemplate         String
  bodyTemplate            String
  locale                  String                       @default("en")
  status                  CommunicationTemplateStatus  @default(DRAFT)
  approvedAt              DateTime?
  effectiveFrom           DateTime?
  createdAt               DateTime                     @default(now())
  updatedAt               DateTime                     @updatedAt
  communicationTemplate   CommunicationTemplate        @relation(fields: [communicationTemplateId], references: [id], onDelete: Cascade)
  messages                CommunicationMessage[]
  mafIndexEntries         CommunicationMafIndexEntry[]

  @@unique([communicationTemplateId, versionNumber])
  @@index([communicationTemplateId])
  @@index([status])
  @@map("communication_template_versions")
}

model CommunicationMessage {
  id                             String                        @id @default(uuid()) @db.Uuid
  caseId                         String?                       @db.Uuid
  masterAdministrativeFileId     String?                       @db.Uuid
  communicationTemplateVersionId String?                       @db.Uuid
  decisionNoticeReference        String?
  messageReference               String                        @unique
  channelType                    CommunicationChannelType
  status                         CommunicationMessageStatus    @default(DRAFT)
  subject                        String
  body                           String
  scheduledAt                    DateTime?
  approvedAt                     DateTime?
  createdAt                      DateTime                      @default(now())
  updatedAt                      DateTime                      @updatedAt
  case                           Case?                         @relation(fields: [caseId], references: [id])
  masterAdministrativeFile       MasterAdministrativeFile?     @relation(fields: [masterAdministrativeFileId], references: [id])
  communicationTemplateVersion   CommunicationTemplateVersion? @relation(fields: [communicationTemplateVersionId], references: [id])
  recipients                     CommunicationRecipient[]
  deliveries                     CommunicationDelivery[]
  mafIndexEntries                CommunicationMafIndexEntry[]
  serviceAppointmentReminders    ServiceAppointmentReminder[]

  @@index([caseId])
  @@index([masterAdministrativeFileId])
  @@index([communicationTemplateVersionId])
  @@index([status])
  @@index([decisionNoticeReference])
  @@map("communication_messages")
}

model CommunicationRecipient {
  id                     String                  @id @default(uuid()) @db.Uuid
  communicationMessageId String                  @db.Uuid
  recipientType          String
  recipientReference     String

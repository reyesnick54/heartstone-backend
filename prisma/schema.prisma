  @@unique([governmentServiceVersionId, code])
  @@index([governmentServiceVersionId])
  @@map("government_service_fee_definitions")
}

model GovernmentServiceEligibilityRule {
  id                         String                   @id @default(uuid()) @db.Uuid
  governmentServiceVersionId String                   @db.Uuid
  ruleCode                   String
  label                      String
  description                String
  configuration              Json                     @default("{}")
  sortOrder                  Int                      @default(0)
  isRequired                 Boolean                  @default(true)
  createdAt                  DateTime                 @default(now())
  updatedAt                  DateTime                 @updatedAt
  governmentServiceVersion   GovernmentServiceVersion @relation(fields: [governmentServiceVersionId], references: [id], onDelete: Cascade)

  @@unique([governmentServiceVersionId, ruleCode])
  @@index([governmentServiceVersionId])

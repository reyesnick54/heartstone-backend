model Application {
  id                         String                   @id @default(uuid()) @db.Uuid
  applicationNumber          String?                  @unique
  applicantIdentityId        String                   @db.Uuid
  organizationId             String?                  @db.Uuid
  representativeAuthorityId  String?                  @db.Uuid
  governmentServiceId        String                   @db.Uuid
  governmentServiceVersionId String                   @db.Uuid
  formDefinitionId           String                   @db.Uuid
  formVersionId              String                   @db.Uuid
  configurationFingerprint   String
  applicantCategory          ApplicantCategory
  status                     ApplicationStatus        @default(DRAFT)
  draftAnswers               Json                     @default("{}")
  idempotencyKey             String?
  createdAt                  DateTime                 @default(now())
  updatedAt                  DateTime                 @updatedAt
  applicantIdentity          Identity                 @relation(fields: [applicantIdentityId], references: [id])
  organization               Organization?            @relation(fields: [organizationId], references: [id])
  representativeAuthority    RepresentativeAuthority? @relation(fields: [representativeAuthorityId], references: [id])
  governmentService          GovernmentService        @relation(fields: [governmentServiceId], references: [id])
  governmentServiceVersion   GovernmentServiceVersion @relation(fields: [governmentServiceVersionId], references: [id])
  formDefinition             FormDefinition           @relation(fields: [formDefinitionId], references: [id])
  formVersion                FormVersion              @relation(fields: [formVersionId], references: [id])
  submissions                ApplicationSubmission[]
  case                       Case?

  @@unique([applicantIdentityId, idempotencyKey])
  @@index([applicantIdentityId])
  @@index([governmentServiceId])
  @@index([governmentServiceVersionId])
  @@index([status])
  @@map("applications")
}

model ApplicationSubmission {
  id                           String                        @id @default(uuid()) @db.Uuid
  applicationId                String                        @db.Uuid
  submissionNumber             String                        @unique
  sequenceNumber               Int
  status                       ApplicationSubmissionStatus   @default(SUBMITTED)
  answersSnapshot              Json
  configurationFingerprint     String
  governmentServiceVersionId   String                        @db.Uuid
  formVersionId                String                        @db.Uuid
  submittedAt                  DateTime                      @default(now())
  acknowledgedAt               DateTime?
  acknowledgmentReference      String?                       @unique
  contentHash                  String
  supersededAt                 DateTime?
  createdAt                    DateTime                      @default(now())
  application                  Application                   @relation(fields: [applicationId], references: [id])
  governmentServiceVersion     GovernmentServiceVersion      @relation(fields: [governmentServiceVersionId], references: [id])
  formVersion                  FormVersion                   @relation(fields: [formVersionId], references: [id])
  completenessReviews          CompletenessReview[]
  deficiencyNotices            DeficiencyNotice[]
  applicantInformationRequests ApplicantInformationRequest[]

  @@unique([applicationId, sequenceNumber])
  @@index([applicationId])
  @@index([status])
  @@map("application_submissions")
}

model Case {
  id                         String                      @id @default(uuid()) @db.Uuid
  caseNumber                 String                      @unique
  applicationId              String                      @unique @db.Uuid
  governmentServiceVersionId String                      @db.Uuid
  workflowVersionId          String                      @db.Uuid
  configurationFingerprint   String
  status                     CaseStatus                  @default(RECEIVED)
  legalStatusLabel           String?
  version                    Int                         @default(1)
  createdAt                  DateTime                    @default(now())
  updatedAt                  DateTime                    @updatedAt
  application                Application                 @relation(fields: [applicationId], references: [id])
  governmentServiceVersion   GovernmentServiceVersion    @relation(fields: [governmentServiceVersionId], references: [id])
  workflowVersion            WorkflowVersion             @relation(fields: [workflowVersionId], references: [id])
  statusHistory              CaseStatusHistory[]
  workflowInstance           CaseWorkflowInstance?
  assignments                CaseAssignment[]
  referrals                  CaseReferral[]
  slaClocks                  CaseSlaClock[]
  escalations                CaseEscalation[]
  issues                     CaseIssue[]
  events                     CaseEvent[]
  communications             CaseCommunication[]
  milestones                 CaseMilestone[]
  publicStatusProjection     CasePublicStatusProjection?
  masterAdministrativeFile   MasterAdministrativeFile?
  evidenceRecords            EvidenceRecord[]

  @@index([status])
  @@index([governmentServiceVersionId])
  @@index([workflowVersionId])
  @@map("cases")
}

model CaseStatusHistory {
  id              String      @id @default(uuid()) @db.Uuid
  caseId          String      @db.Uuid
  fromStatus      CaseStatus?
  toStatus        CaseStatus
  reason          String?
  actorIdentityId String?     @db.Uuid
  recordedAt      DateTime    @default(now())
  case            Case        @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId])
  @@index([recordedAt])
  @@map("case_status_history")
}

model WorkflowDefinition {
  id                  String                   @id @default(uuid()) @db.Uuid
  code                String                   @unique
  name                String
  description         String?
  governmentServiceId String?                  @db.Uuid
  status              WorkflowDefinitionStatus @default(DRAFT)
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
  governmentService   GovernmentService?       @relation(fields: [governmentServiceId], references: [id])
  versions            WorkflowVersion[]

  @@index([governmentServiceId])
  @@index([status])
  @@map("workflow_definitions")
}

model WorkflowVersion {
  id                   String                         @id @default(uuid()) @db.Uuid
  workflowDefinitionId String                         @db.Uuid
  version              String
  status               WorkflowVersionStatus          @default(DRAFT)
  approvedAt           DateTime?
  supersededAt         DateTime?
  supersededById       String?                        @db.Uuid
  createdAt            DateTime                       @default(now())
  updatedAt            DateTime                       @updatedAt
  workflowDefinition   WorkflowDefinition             @relation(fields: [workflowDefinitionId], references: [id])
  supersededBy         WorkflowVersion?               @relation("WorkflowVersionSupersession", fields: [supersededById], references: [id])
  supersedes           WorkflowVersion[]              @relation("WorkflowVersionSupersession")
  stages               WorkflowStageDefinition[]
  steps                WorkflowStepDefinition[]
  transitions          WorkflowTransitionDefinition[]
  caseInstances        CaseWorkflowInstance[]
  cases                Case[]

  @@unique([workflowDefinitionId, version])
  @@index([workflowDefinitionId])
  @@index([status])
  @@map("workflow_versions")
}

model WorkflowStageDefinition {
  id                String                   @id @default(uuid()) @db.Uuid
  workflowVersionId String                   @db.Uuid
  stageKey          String
  label             String
  description       String?
  displayOrder      Int
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  workflowVersion   WorkflowVersion          @relation(fields: [workflowVersionId], references: [id], onDelete: Cascade)
  steps             WorkflowStepDefinition[]

  @@unique([workflowVersionId, stageKey])
  @@index([workflowVersionId])
  @@map("workflow_stage_definitions")
}

model WorkflowStepDefinition {
  id                        String                         @id @default(uuid()) @db.Uuid
  workflowVersionId         String                         @db.Uuid
  workflowStageDefinitionId String?                        @db.Uuid
  stepKey                   String
  label                     String
  description               String?
  stepType                  WorkflowStepType
  consequenceLevel          WorkflowStepConsequenceLevel   @default(ADMINISTRATIVE)
  functionAuthorityRecordId String?                        @db.Uuid
  authorityActionType       AuthorityActionType?
  displayOrder              Int
  isParallel                Boolean                        @default(false)
  parallelGroupKey          String?
  joinType                  WorkflowTransitionJoinType?
  configuration             Json                           @default("{}")
  createdAt                 DateTime                       @default(now())
  updatedAt                 DateTime                       @updatedAt
  workflowVersion           WorkflowVersion                @relation(fields: [workflowVersionId], references: [id], onDelete: Cascade)
  workflowStageDefinition   WorkflowStageDefinition?       @relation(fields: [workflowStageDefinitionId], references: [id])
  functionAuthorityRecord   FunctionAuthorityRecord?       @relation(fields: [functionAuthorityRecordId], references: [id])
  outgoingTransitions       WorkflowTransitionDefinition[] @relation("TransitionFromStep")
  incomingTransitions       WorkflowTransitionDefinition[] @relation("TransitionToStep")
  stepInstances             CaseWorkflowStepInstance[]

  @@unique([workflowVersionId, stepKey])
  @@index([workflowVersionId])
  @@index([functionAuthorityRecordId])
  @@map("workflow_step_definitions")
}

model WorkflowTransitionDefinition {
  id                String                     @id @default(uuid()) @db.Uuid
  workflowVersionId String                     @db.Uuid
  fromStepId        String                     @db.Uuid
  toStepId          String                     @db.Uuid
  transitionKey     String
  label             String?
  joinType          WorkflowTransitionJoinType @default(ALL_REQUIRED)
  isDefault         Boolean                    @default(false)
  conditionConfig   Json                       @default("{}")
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt
  workflowVersion   WorkflowVersion            @relation(fields: [workflowVersionId], references: [id], onDelete: Cascade)
  fromStep          WorkflowStepDefinition     @relation("TransitionFromStep", fields: [fromStepId], references: [id], onDelete: Cascade)
  toStep            WorkflowStepDefinition     @relation("TransitionToStep", fields: [toStepId], references: [id], onDelete: Cascade)

  @@unique([workflowVersionId, transitionKey])
  @@index([workflowVersionId])
  @@index([fromStepId])
  @@index([toStepId])
  @@map("workflow_transition_definitions")
}

model CaseWorkflowInstance {
  id                String                     @id @default(uuid()) @db.Uuid
  caseId            String                     @unique @db.Uuid
  workflowVersionId String                     @db.Uuid
  status            CaseWorkflowInstanceStatus @default(PENDING)
  currentStepKeys   String[]                   @default([])
  startedAt         DateTime?
  completedAt       DateTime?
  haltedAt          DateTime?
  haltReason        String?
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt
  case              Case                       @relation(fields: [caseId], references: [id], onDelete: Cascade)
  workflowVersion   WorkflowVersion            @relation(fields: [workflowVersionId], references: [id])
  stepInstances     CaseWorkflowStepInstance[]

  @@index([workflowVersionId])
  @@index([status])
  @@map("case_workflow_instances")
}

model CaseWorkflowStepInstance {
  id                       String                         @id @default(uuid()) @db.Uuid
  caseWorkflowInstanceId   String                         @db.Uuid
  workflowStepDefinitionId String                         @db.Uuid
  status                   CaseWorkflowStepInstanceStatus @default(PENDING)
  parallelGroupKey         String?

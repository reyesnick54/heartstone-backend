  authorityEvaluationRecord   AuthorityEvaluationRecord? @relation(fields: [authorityEvaluationRecordId], references: [id])
  supersededBy                DepartmentalReviewRecord? @relation("DepartmentalReviewSupersession", fields: [supersededById], references: [id])
  supersedes                  DepartmentalReviewRecord[] @relation("DepartmentalReviewSupersession")
  evidenceConsidered          DepartmentalReviewEvidence[]
  packetItems                 EvidencePacketItem[]

  @@unique([caseId, departmentId, reviewVersion])
  @@index([caseId])
  @@index([departmentId])
  @@index([reviewerIdentityId])
  @@index([status])
  @@map("departmental_review_records")
}

model DepartmentalReviewEvidence {
  id                   String                 @id @default(uuid()) @db.Uuid
  departmentalReviewId String                 @db.Uuid
  evidenceRecordId     String                 @db.Uuid
  createdAt            DateTime               @default(now())
  departmentalReview   DepartmentalReviewRecord @relation(fields: [departmentalReviewId], references: [id], onDelete: Cascade)
  evidenceRecord       EvidenceRecord         @relation(fields: [evidenceRecordId], references: [id])

  @@unique([departmentalReviewId, evidenceRecordId])
  @@index([evidenceRecordId])
  @@map("departmental_review_evidence")
}

model GovernmentCommunicationRecord {

  documentRegisterReference         String?
  evidencePacketReference           String?
  recordsClassificationReference    String?
  retentionLegalHoldReference       String?
  createdAt                         DateTime                        @default(now())
  updatedAt                         DateTime                        @updatedAt
  application                       Application                     @relation(fields: [applicationId], references: [id])
  applicantIdentity                 Identity                        @relation("CaseApplicant", fields: [applicantIdentityId], references: [id])
  governmentService                 GovernmentService               @relation(fields: [governmentServiceId], references: [id])
  governmentServiceVersion          GovernmentServiceVersion        @relation(fields: [governmentServiceVersionId], references: [id])
  responsibleInstitution            Institution                     @relation(fields: [responsibleInstitutionId], references: [id])
  responsibleDepartment             Department                      @relation(fields: [responsibleDepartmentId], references: [id])
  workflowVersion                   WorkflowVersion                 @relation(fields: [workflowVersionId], references: [id])
  currentCaseManagerOfficeholder    Officeholder?                   @relation("CaseManager", fields: [currentCaseManagerOfficeholderId], references: [id])
  statusHistory                     CaseStatusHistory[]
  workflowInstance                  CaseWorkflowInstance?
  assignments                       CaseAssignment[]
  referrals                         CaseReferral[]
  slaClocks                         CaseSlaClock[]
  escalations                       CaseEscalation[]
  issues                            CaseIssue[]
  events                            CaseEvent[]
  communications                    CaseCommunication[]
  milestones                        CaseMilestone[]
  publicStatusProjection            CasePublicStatusProjection?
  masterAdministrativeFile          MasterAdministrativeFile?
  evidenceRecords                   EvidenceRecord[]
  departmentalReviews               DepartmentalReviewRecord[]
  governmentCommunications          GovernmentCommunicationRecord[]
  professionalReviews               ProfessionalReviewRecord[]
  inspectionRecords                 InspectionRecord[]
  evidencePackets                   EvidencePacket[]
  decisionReadinessAssessments      DecisionReadinessAssessment[]
  governmentDecisions               GovernmentDecision[]
  decisionPreparationRecords        DecisionPreparationRecord[]
  officialInstruments               OfficialInstrument[]
  issuanceReadinessAssessments      IssuanceReadinessAssessment[]
  complianceMatters                 ComplianceMatter[]
  complianceStatusProjections       ComplianceStatusProjection[]
  reconsiderationProceedings        ReconsiderationProceeding[]
  internalAdministrativeReviews     InternalAdministrativeReview[]
  redressMatters                    RedressMatter[]
  externalReviewReferrals           ExternalReviewReferral[]
  feeAssessments                    FeeAssessment[]
  invoices                          Invoice[]
  communicationMessages             CommunicationMessage[]
  integrationRequests               IntegrationRequest[]
  dashboardIndicatorProjections     DashboardIndicatorProjection[]
  strategicProjectProfiles          StrategicProjectProfile[]
  analysisRequests                  AnalysisRequest[]
  serviceAppointments               ServiceAppointment[]
  civilRegistryRegistration         CivilRegistryVitalRecord?         @relation("CivilRegistryRegistrationCase")
  civilRegistryEventSubmission      CivilRegistryEventSubmission?
  visaApplicationProfile            VisaApplicationProfile?
  residencyApplicationProfile       ResidencyApplicationProfile?
  citizenshipApplicationProfile     CitizenshipApplicationProfile?
  immigrationSponsorships           ImmigrationSponsorship[]
  dependentRelationships            DependentRelationship[]
  immigrationRequirementAssessments ImmigrationRequirementAssessment[]
  immigrationInterviews             ImmigrationInterview[]
  biometricRequirements             BiometricRequirement[]
  immigrationExternalChecks         ImmigrationExternalCheck[]
  immigrationCaseProjection         ImmigrationCaseProjection?
  vitalEvents                       VitalEvent[]
  civilRegistryEntries              CivilRegistryEntry[]
  civilRecordCorrectionRequests     CivilRecordCorrectionRequest[]
  workPermitApplicationProfile      WorkPermitApplicationProfile?
  employmentDeclarations            EmploymentDeclaration[]
  employmentSponsorships            EmploymentSponsorship[]
  labourMarketDeterminationReferences LabourMarketDeterminationReference[]
  employmentComplaints              EmploymentComplaint[]
  employmentDisputes                EmploymentDispute[]
  labourExternalDependencies        LabourExternalDependency[]
  driverLicenseApplicationProfile   DriverLicenseApplicationProfile?
  driverTestRecords                 DriverTestRecord[]
  driverMedicalRequirementReferences DriverMedicalRequirementReference[]
  vehicleInspections                VehicleInspection[]
  vehicleTransfers                  VehicleTransfer[]

  @@index([status])
  @@index([applicantIdentityId])
  @@index([governmentServiceId])
  @@index([governmentServiceVersionId])
  @@index([workflowVersionId])
  @@index([responsibleDepartmentId])
  @@index([currentCaseManagerOfficeholderId])

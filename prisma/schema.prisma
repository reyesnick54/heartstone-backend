  privacyClassification      String
  accessRestriction          String?
  archivalRequirement        String?
  integrityRequirement     String?
  reviewIntervalDays         Int?
  disposalApprovalRequired   Boolean                     @default(true)
  governingSourceId          String?                     @db.Uuid
  status                     RecordsClassificationStatus @default(DRAFT)
  createdAt                  DateTime                    @default(now())
  updatedAt                  DateTime                    @updatedAt
  governingSource            GoverningSource?            @relation(fields: [governingSourceId], references: [id])
  retentionSchedules         RetentionSchedule[]
  retentionAssignments       RecordRetentionAssignment[]
  legalHoldTargets           LegalHoldTarget[]

  @@index([governingSourceId])
  @@index([status])
  @@map("records_classifications")
}

model RetentionSchedule {
  id                       String                  @id @default(uuid()) @db.Uuid
  code                     String
  name                     String
  recordsClassificationId  String                  @db.Uuid
  versionNumber            Int                     @default(1)
  supersededByScheduleId   String?                 @unique @db.Uuid
  retentionDurationValue   Int?
  retentionDurationUnit    RetentionDurationUnit?
  triggerType              RetentionTriggerType
  triggerConfiguration     Json                    @default("{}")
  governingSourceId        String                  @db.Uuid
  approvedByIdentityId     String?                 @db.Uuid
  approvedAt               DateTime?
  effectiveFrom            DateTime
  effectiveUntil           DateTime?
  reviewAt                 DateTime?
  scheduleSnapshotHash     String
  status                   RetentionScheduleStatus @default(DRAFT)
  createdAt                DateTime                @default(now())
  updatedAt                DateTime                @updatedAt
  recordsClassification    RecordsClassification   @relation(fields: [recordsClassificationId], references: [id])
  governingSource          GoverningSource         @relation(fields: [governingSourceId], references: [id])
  supersededBySchedule     RetentionSchedule?      @relation("RetentionScheduleSupersession", fields: [supersededByScheduleId], references: [id])
  supersededSchedule       RetentionSchedule?      @relation("RetentionScheduleSupersession")
  rules                    RetentionRule[]
  retentionAssignments     RecordRetentionAssignment[]
  dispositionRequests      RecordDispositionRequest[]

  @@unique([code, versionNumber])
  @@index([recordsClassificationId])
  @@index([governingSourceId])
  @@index([status])
  @@map("retention_schedules")
}

model RetentionRule {
  id                  String               @id @default(uuid()) @db.Uuid
  retentionScheduleId String               @db.Uuid
  ruleOrder           Int                  @default(1)
  label               String
  triggerType         RetentionTriggerType
  triggerConfiguration Json                @default("{}")
  durationValue       Int?
  durationUnit        RetentionDurationUnit?
  minimumRetention    Boolean              @default(true)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  retentionSchedule   RetentionSchedule    @relation(fields: [retentionScheduleId], references: [id], onDelete: Cascade)

  @@unique([retentionScheduleId, ruleOrder])
  @@index([retentionScheduleId])
  @@map("retention_rules")
}

model RecordRetentionAssignment {
  id                      String                @id @default(uuid()) @db.Uuid
  targetType              LegalHoldTargetType
  targetReference         String
  recordsClassificationId String                @db.Uuid
  retentionScheduleId     String                @db.Uuid
  assignedAt              DateTime              @default(now())
  assignedByIdentityId    String                @db.Uuid
  triggerAnchorAt         DateTime?
  retentionExpiresAt      DateTime?
  scheduleVersionNumber   Int
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt
  recordsClassification   RecordsClassification @relation(fields: [recordsClassificationId], references: [id])
  retentionSchedule       RetentionSchedule     @relation(fields: [retentionScheduleId], references: [id])

  @@unique([targetType, targetReference, retentionScheduleId])
  @@index([recordsClassificationId])
  @@index([retentionScheduleId])
  @@index([targetType, targetReference])
  @@map("record_retention_assignments")
}

model LegalHold {
  id                    String                   @id @default(uuid()) @db.Uuid
  holdNumber            String                   @unique
  title                 String
  authorityReference    String
  reason                String
  issuedByIdentityId    String                   @db.Uuid
  issuedAt              DateTime                 @default(now())
  effectiveFrom         DateTime
  releasedAt            DateTime?
  status                LegalHoldStatus          @default(DRAFT)
  scope                 LegalHoldScope           @default(STANDARD)
  confidentiality       LegalHoldConfidentiality @default(STANDARD)
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt
  targets               LegalHoldTarget[]
  releaseRecords        LegalHoldReleaseRecord[]

  @@index([status])
  @@index([effectiveFrom])
  @@map("legal_holds")
}

model LegalHoldTarget {
  id                      String                @id @default(uuid()) @db.Uuid
  legalHoldId             String                @db.Uuid
  targetType              LegalHoldTargetType
  targetReference         String
  recordsClassificationId String?               @db.Uuid
  notes                   String?
  createdAt               DateTime              @default(now())
  legalHold               LegalHold             @relation(fields: [legalHoldId], references: [id], onDelete: Cascade)
  recordsClassification   RecordsClassification? @relation(fields: [recordsClassificationId], references: [id])

  @@unique([legalHoldId, targetType, targetReference])
  @@index([targetType, targetReference])
  @@index([legalHoldId])
  @@map("legal_hold_targets")
}

model LegalHoldReleaseRecord {
  id                         String    @id @default(uuid()) @db.Uuid
  legalHoldId                String    @db.Uuid
  releasedByIdentityId       String    @db.Uuid
  releaseAuthorityReference  String
  releaseReason              String
  releasedAt                 DateTime  @default(now())
  auditManifestHash          String
  createdAt                  DateTime  @default(now())
  legalHold                  LegalHold @relation(fields: [legalHoldId], references: [id])

  @@index([legalHoldId])
  @@index([releasedAt])
  @@map("legal_hold_release_records")
}

model PreservationCollection {
  id                   String                        @id @default(uuid()) @db.Uuid
  collectionReference  String                        @unique
  title                String
  purpose              PreservationCollectionPurpose
  status               PreservationCollectionStatus  @default(ACTIVE)
  frozenAt             DateTime                      @default(now())
  frozenByIdentityId   String                        @db.Uuid
  integrityManifest    Json                          @default("[]")
  manifestHash         String
  releaseAuthorityRef  String?
  releasedAt           DateTime?
  createdAt            DateTime                      @default(now())
  updatedAt            DateTime                      @updatedAt
  items                PreservationCollectionItem[]

  @@index([status])
  @@index([purpose])
  @@map("preservation_collections")
}

model PreservationCollectionItem {
  id                       String                 @id @default(uuid()) @db.Uuid
  preservationCollectionId String                 @db.Uuid
  targetType               LegalHoldTargetType
  targetReference          String
  versionReference         String
  integrityHash            String
  capturedAt               DateTime               @default(now())
  preservationCollection   PreservationCollection @relation(fields: [preservationCollectionId], references: [id], onDelete: Cascade)

  @@unique([preservationCollectionId, targetType, targetReference, versionReference])
  @@index([preservationCollectionId])
  @@map("preservation_collection_items")
}

model ExternalRecordsRepository {
  id                         String                          @id @default(uuid()) @db.Uuid
  code                       String                          @unique
  provider                   String
  institutionalOwnership     String
  systemOfRecord             Boolean                         @default(false)
  location                   String
  exportCapability           String
  retentionCompatibility     String
  legalHoldCapability        String
  backupTreatment            String
  terminationExitRequirement String
  vendorDefaultDeletionPolicy String?
  institutionalScheduleOverridesVendor Boolean             @default(true)
  status                     ExternalRecordsRepositoryStatus @default(ACTIVE)
  createdAt                  DateTime                        @default(now())
  updatedAt                  DateTime                        @updatedAt
  sourceTransfers            ArchivalTransfer[]              @relation("ArchivalTransferSource")
  destinationTransfers       ArchivalTransfer[]              @relation("ArchivalTransferDestination")

  @@map("external_records_repositories")
}

model ArchivalTransfer {
  id                          String                   @id @default(uuid()) @db.Uuid
  transferNumber              String                   @unique
  sourceRepositoryId          String                   @db.Uuid
  destinationRepositoryId     String                   @db.Uuid
  manifest                    Json                     @default("[]")
  manifestHash                String
  integrityVerification       String
  metadataCompleteness        String
  restrictions                String?
  transferDate                DateTime?
  sendingCustodianIdentityId  String?                  @db.Uuid
  receivingAcknowledgedAt     DateTime?
  receivingCustodianIdentityId String?                 @db.Uuid
  status                      ArchivalTransferStatus   @default(DRAFT)
  createdAt                   DateTime                 @default(now())
  updatedAt                   DateTime                 @updatedAt
  sourceRepository            ExternalRecordsRepository @relation("ArchivalTransferSource", fields: [sourceRepositoryId], references: [id])
  destinationRepository       ExternalRecordsRepository @relation("ArchivalTransferDestination", fields: [destinationRepositoryId], references: [id])
  items                       ArchivalTransferItem[]

  @@index([status])
  @@index([sourceRepositoryId])
  @@index([destinationRepositoryId])
  @@map("archival_transfers")
}

model ArchivalTransferItem {
  id                 String           @id @default(uuid()) @db.Uuid
  archivalTransferId String           @db.Uuid
  targetType         LegalHoldTargetType
  targetReference    String
  versionReference   String
  integrityHash      String
  metadata           Json             @default("{}")
  createdAt          DateTime         @default(now())
  archivalTransfer   ArchivalTransfer @relation(fields: [archivalTransferId], references: [id], onDelete: Cascade)

  @@unique([archivalTransferId, targetType, targetReference, versionReference])
  @@index([archivalTransferId])
  @@map("archival_transfer_items")
}

model RecordDispositionRequest {
  id                         String                       @id @default(uuid()) @db.Uuid
  requestReference           String                       @unique
  targetType                 LegalHoldTargetType
  targetReference            String
  retentionScheduleId        String?                      @db.Uuid
  eligibilityStatus          DispositionEligibilityStatus @default(NOT_EVALUATED)
  eligibilityCalculatedAt    DateTime?
  eligibilityNotes           String?
  safeHaltReasons            DispositionSafeHaltReason[]  @default([])
  appealActive               Boolean                      @default(false)
  investigationActive        Boolean                      @default(false)
  adverseEvidenceProtected   Boolean                      @default(false)
  requestedByIdentityId      String                       @db.Uuid
  reason                     String
  status                     DispositionRequestStatus     @default(DRAFT)
  createdAt                  DateTime                     @default(now())
  updatedAt                  DateTime                     @updatedAt
  retentionSchedule          RetentionSchedule?           @relation(fields: [retentionScheduleId], references: [id])
  dispositionRecords         RecordDispositionRecord[]

  @@index([targetType, targetReference])
  @@index([status])
  @@index([retentionScheduleId])
  @@map("record_disposition_requests")
}

model RecordDispositionRecord {
  id                         String                     @id @default(uuid()) @db.Uuid
  dispositionRequestId       String                     @db.Uuid
  authorizedByIdentityId     String                     @db.Uuid
  authorityReference         String
  dispositionDate            DateTime
  method                     DispositionMethod
  manifestCertificate        Json                       @default("{}")
  manifestCertificateHash    String
  verificationNotes          String?
  result                     DispositionExecutionResult
  createdAt                  DateTime                   @default(now())
  dispositionRequest         RecordDispositionRequest   @relation(fields: [dispositionRequestId], references: [id])

  @@index([dispositionRequestId])
  @@index([dispositionDate])
  @@map("record_disposition_records")
}

// ─── Phase 8A/8B: Decision Catalog, Readiness, and Authorized Decisions ────────

enum DecisionTypeVersionStatus {
  DRAFT
  ACTIVE
  SUSPENDED
  SUPERSEDED
  RETIRED
}

enum DecisionReadinessOutcome {
  READY
  NOT_READY
  BLOCKED
  SAFE_HALT
  REQUIRES_EXTERNAL_DETERMINATION
  REQUIRES_PROFESSIONAL_REVIEW
  REQUIRES_ADDITIONAL_EVIDENCE
  REQUIRES_CO_APPROVAL
}

enum GovernmentDecisionStatus {
  RECORDED
  FORMALIZATION_PENDING
  SIGNATURE_PENDING
  SEAL_PENDING
  NOTICE_PENDING
  CONDITIONS_PRECEDENT_PENDING
  EFFECTIVE
  SUPERSEDED
  SET_ASIDE
  WITHDRAWN_BY_AUTHORIZED_PROCESS
}

enum DecisionParticipantRole {
  DECISION_MAKER
  CO_APPROVER
  RECUSED
  OBSERVER
}

model DecisionType {
  id                  String               @id @default(uuid()) @db.Uuid
  code                String               @unique
  name                String
  description         String?
  governmentServiceId String               @db.Uuid
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  governmentService   GovernmentService    @relation(fields: [governmentServiceId], references: [id])
  versions            DecisionTypeVersion[]

  @@index([governmentServiceId])
  @@map("decision_types")
}

model DecisionTypeVersion {
  id                         String                    @id @default(uuid()) @db.Uuid
  decisionTypeId             String                    @db.Uuid
  version                    String
  status                     DecisionTypeVersionStatus @default(DRAFT)
  governmentServiceVersionId String                    @db.Uuid
  functionAuthorityRecordId  String                    @db.Uuid
  permissibleOutcomes        Json                      @default("[]")
  requirementsConfig         Json                      @default("{}")
  effectiveFrom              DateTime?
  effectiveUntil             DateTime?
  supersededById             String?                   @db.Uuid
  createdAt                  DateTime                  @default(now())
  updatedAt                  DateTime                  @updatedAt
  decisionType               DecisionType              @relation(fields: [decisionTypeId], references: [id])
  governmentServiceVersion   GovernmentServiceVersion  @relation(fields: [governmentServiceVersionId], references: [id])
  functionAuthorityRecord    FunctionAuthorityRecord   @relation(fields: [functionAuthorityRecordId], references: [id])
  supersededBy               DecisionTypeVersion?      @relation("DecisionTypeVersionSupersession", fields: [supersededById], references: [id])
  supersedes                 DecisionTypeVersion[]     @relation("DecisionTypeVersionSupersession")
  readinessAssessments       DecisionReadinessAssessment[]
  governmentDecisions        GovernmentDecision[]
  preparationRecords         DecisionPreparationRecord[]

  @@unique([decisionTypeId, version])
  @@index([decisionTypeId])
  @@index([governmentServiceVersionId])
  @@index([functionAuthorityRecordId])
  @@index([status])
  @@map("decision_type_versions")
}

model DecisionReadinessAssessment {
  id                            String                   @id @default(uuid()) @db.Uuid
  assessmentNumber              String                   @unique
  caseId                        String                   @db.Uuid
  decisionTypeVersionId         String                   @db.Uuid
  proposedDecisionMakerIdentityId String                 @db.Uuid
  proposedDecisionMakerOfficeholderId String?            @db.Uuid
  requestedOutcome              String
  assessedAt                    DateTime                 @default(now())
  outcome                       DecisionReadinessOutcome
  reasonCodes                   Json                     @default("[]")
  contextSnapshot               Json                     @default("{}")
  evidencePacketVersionId       String?                  @db.Uuid
  masterAdministrativeFileId    String?                  @db.Uuid
  authorityEvaluationRecordId   String?                  @db.Uuid
  createdAt                     DateTime                 @default(now())
  case                          Case                     @relation(fields: [caseId], references: [id])
  decisionTypeVersion           DecisionTypeVersion      @relation(fields: [decisionTypeVersionId], references: [id])
  proposedDecisionMakerIdentity Identity                 @relation("DecisionReadinessProposedMaker", fields: [proposedDecisionMakerIdentityId], references: [id])
  proposedDecisionMakerOfficeholder Officeholder?        @relation("DecisionReadinessProposedOfficeholder", fields: [proposedDecisionMakerOfficeholderId], references: [id])
  evidencePacketVersion         EvidencePacketVersion?   @relation(fields: [evidencePacketVersionId], references: [id])
  masterAdministrativeFile      MasterAdministrativeFile? @relation(fields: [masterAdministrativeFileId], references: [id])
  authorityEvaluationRecord     AuthorityEvaluationRecord? @relation("DecisionReadinessAuthority", fields: [authorityEvaluationRecordId], references: [id])
  participants                  DecisionParticipant[]
  governmentDecisions           GovernmentDecision[]

  @@index([caseId])
  @@index([decisionTypeVersionId])
  @@index([outcome])
  @@index([assessedAt])
  @@map("decision_readiness_assessments")
}

model DecisionParticipant {
  id                            String                    @id @default(uuid()) @db.Uuid
  readinessAssessmentId         String                    @db.Uuid
  identityId                    String                    @db.Uuid
  officeholderId                String?                   @db.Uuid
  appointmentId                 String?                   @db.Uuid
  role                          DecisionParticipantRole
  isConflicted                  Boolean                   @default(false)
  isRecused                     Boolean                   @default(false)
  hasApproved                   Boolean                   @default(false)
  approvedAt                    DateTime?
  createdAt                     DateTime                  @default(now())
  readinessAssessment           DecisionReadinessAssessment @relation(fields: [readinessAssessmentId], references: [id], onDelete: Cascade)
  identity                      Identity                  @relation("DecisionParticipantIdentity", fields: [identityId], references: [id])
  officeholder                  Officeholder?             @relation("DecisionParticipantOfficeholder", fields: [officeholderId], references: [id])
  appointment                   Appointment?              @relation(fields: [appointmentId], references: [id])

  @@index([readinessAssessmentId])
  @@index([identityId])
  @@map("decision_participants")
}

model DecisionPreparationRecord {
  id                    String              @id @default(uuid()) @db.Uuid
  caseId                String              @db.Uuid
  decisionTypeVersionId String              @db.Uuid
  editorIdentityId      String              @db.Uuid
  proposedFindings      String?
  proposedReasons       String?
  proposedOutcome       String?
  recommendation        String?
  aiAssistanceMetadata  Json                @default("{}")
  isNonFinal            Boolean             @default(true)
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  case                  Case                @relation(fields: [caseId], references: [id])
  decisionTypeVersion   DecisionTypeVersion @relation(fields: [decisionTypeVersionId], references: [id])
  editorIdentity        Identity            @relation("DecisionPreparationEditor", fields: [editorIdentityId], references: [id])

  @@index([caseId])
  @@index([decisionTypeVersionId])
  @@map("decision_preparation_records")
}

model GovernmentDecision {
  id                            String                   @id @default(uuid()) @db.Uuid
  decisionNumber                String                   @unique
  caseId                        String                   @db.Uuid
  masterAdministrativeFileId    String                   @db.Uuid
  decisionTypeVersionId         String                   @db.Uuid
  functionAuthorityRecordId     String                   @db.Uuid
  authorityEvaluationRecordId   String                   @db.Uuid
  decisionReadinessAssessmentId String                   @db.Uuid
  evidencePacketVersionId       String                   @db.Uuid
  decisionMakerIdentityId       String                   @db.Uuid
  decisionMakerOfficeholderId   String                   @db.Uuid
  appointmentId                 String                   @db.Uuid
  delegationId                  String?                  @db.Uuid
  institutionId                 String                   @db.Uuid
  departmentId                  String                   @db.Uuid
  matterDecided                 String
  outcome                       String
  decisionStatus                GovernmentDecisionStatus @default(RECORDED)
  decidedAt                     DateTime
  effectiveAt                   DateTime?
  effectiveUntil                DateTime?
  integrityHash                 String
  explicitIntentConfirmed       Boolean                  @default(true)
  createdAt                     DateTime                 @default(now())
  case                          Case                     @relation(fields: [caseId], references: [id])
  masterAdministrativeFile      MasterAdministrativeFile @relation(fields: [masterAdministrativeFileId], references: [id])
  decisionTypeVersion           DecisionTypeVersion      @relation(fields: [decisionTypeVersionId], references: [id])
  functionAuthorityRecord       FunctionAuthorityRecord  @relation(fields: [functionAuthorityRecordId], references: [id])
  authorityEvaluationRecord     AuthorityEvaluationRecord @relation("GovernmentDecisionAuthority", fields: [authorityEvaluationRecordId], references: [id])
  decisionReadinessAssessment   DecisionReadinessAssessment @relation(fields: [decisionReadinessAssessmentId], references: [id])
  evidencePacketVersion         EvidencePacketVersion    @relation(fields: [evidencePacketVersionId], references: [id])
  decisionMakerIdentity         Identity                 @relation("GovernmentDecisionMaker", fields: [decisionMakerIdentityId], references: [id])
  decisionMakerOfficeholder     Officeholder             @relation("GovernmentDecisionOfficeholder", fields: [decisionMakerOfficeholderId], references: [id])
  appointment                   Appointment              @relation(fields: [appointmentId], references: [id])
  delegation                    Delegation?              @relation(fields: [delegationId], references: [id])
  institution                   Institution              @relation(fields: [institutionId], references: [id])
  department                    Department               @relation(fields: [departmentId], references: [id])

  @@index([caseId])
  @@index([decisionTypeVersionId])
  @@index([decisionStatus])
  @@index([decidedAt])
  @@map("government_decisions")
}

  weight        Float?
  exactValue    Json?
  basisLabel    String?
  createdAt     DateTime          @default(now())
  assessment    RiskAssessment    @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@index([assessmentId])
  @@map("risk_factors")
}

model RiskMitigation {
  id              String               @id @default(uuid()) @db.Uuid
  assessmentId    String               @db.Uuid

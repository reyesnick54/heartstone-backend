  holderOfficeholder                Officeholder?                     @relation("InstrumentHolderOfficeholder", fields: [holderOfficeholderId], references: [id])
  holderOrganization                Organization?                     @relation("OfficialInstrumentHolderOrganization", fields: [holderOrganizationId], references: [id])
  governmentServiceVersion          GovernmentServiceVersion?         @relation(fields: [governmentServiceVersionId], references: [id])
  issuerInstitution                 Institution                       @relation("OfficialInstrumentIssuerInstitution", fields: [issuerInstitutionId], references: [id])
  issuerOfficeholder                Officeholder?                     @relation("OfficialInstrumentIssuerOfficeholder", fields: [issuerOfficeholderId], references: [id])
  currentVersion                    OfficialInstrumentVersion?        @relation("OfficialInstrumentCurrentVersion", fields: [currentVersionId], references: [id])
  versions                          OfficialInstrumentVersion[]       @relation("OfficialInstrumentVersions")
  numberReservation                 InstrumentNumberReservation?
  issuanceEvents                    IssuanceEvent[]
  issuanceReadinessAssessments      IssuanceReadinessAssessment[]

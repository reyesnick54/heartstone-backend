model TaxTypeDefinition {
  id              String                  @id @default(uuid()) @db.Uuid
  jurisdictionId  String                  @db.Uuid
  code            String
  name            String
  description     String?
  status          TaxTypeDefinitionStatus @default(DRAFT)
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  jurisdiction    Jurisdiction            @relation(fields: [jurisdictionId], references: [id])
  versions        TaxTypeDefinitionVersion[]
  periods         TaxPeriod[]
  obligations     TaxObligation[]
  returns         TaxReturn[]
  assessments     TaxAssessment[]
  withholdingRecords TaxWithholdingRecord[]

  @@unique([jurisdictionId, code])
  @@index([jurisdictionId])
  @@index([status])
  @@map("tax_type_definitions")
}

model TaxTypeDefinitionVersion {
  id                    String              @id @default(uuid()) @db.Uuid
  taxTypeDefinitionId   String              @db.Uuid
  versionNumber         Int
  ruleConfiguration     Json                @default("{}")
  methodologyReference  String
  effectiveFrom         DateTime
  effectiveUntil        DateTime?
  approvedByIdentityId  String?             @db.Uuid
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  taxTypeDefinition     TaxTypeDefinition   @relation(fields: [taxTypeDefinitionId], references: [id], onDelete: Cascade)
  approvedBy            Identity?           @relation("TaxTypeDefinitionVersionApprover", fields: [approvedByIdentityId], references: [id])
  calculationRecords    TaxCalculationRecord[]

  @@unique([taxTypeDefinitionId, versionNumber])
  @@index([taxTypeDefinitionId])
  @@map("tax_type_definition_versions")
}

model TaxpayerAccount {
  id                    String               @id @default(uuid()) @db.Uuid
  jurisdictionId        String               @db.Uuid
  accountNumber         String               @unique
  accountKind           TaxpayerAccountKind
  primaryIdentityId     String?              @db.Uuid
  organizationId        String?              @db.Uuid
  displayName           String
  isActive              Boolean              @default(true)
  registeredAt          DateTime?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  jurisdiction          Jurisdiction         @relation(fields: [jurisdictionId], references: [id])
  primaryIdentity       Identity?            @relation("TaxpayerAccountPrimaryIdentity", fields: [primaryIdentityId], references: [id])
  organization          Organization?        @relation(fields: [organizationId], references: [id])
  registrations         TaxpayerRegistration[]
  identifiers           TaxpayerIdentifier[]
  obligations           TaxObligation[]
  returns               TaxReturn[]
  assessments           TaxAssessment[]
  liabilities           TaxLiability[]
  credits               TaxCredit[]
  balanceSnapshots      TaxAccountBalance[]
  refundClaims          TaxRefundClaim[]
  arrears               TaxArrear[]
  paymentPlans          TaxPaymentPlan[]
  complianceStatuses    TaxComplianceStatus[]
  auditMatters          TaxAuditMatter[]
  objections            TaxObjection[]
  disputes              TaxDispute[]
  clearanceRequests     TaxClearanceCertificateRequest[]
  withholdingRecords    TaxWithholdingRecord[]
  accessAudits          TaxAccessAudit[]

  @@index([jurisdictionId])
  @@index([primaryIdentityId])
  @@index([organizationId])
  @@map("taxpayer_accounts")
}

model TaxpayerRegistration {
  id                    String                     @id @default(uuid()) @db.Uuid
  taxpayerAccountId     String                     @db.Uuid

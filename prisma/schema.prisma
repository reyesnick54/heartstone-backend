model ServiceFamily {
  id          String                    @id @default(uuid()) @db.Uuid
  code        String                    @unique
  name        String
  description String?
  status      StructuralLifecycleStatus @default(ACTIVE)
  createdAt   DateTime                  @default(now())
  updatedAt   DateTime                  @updatedAt
  services    GovernmentService[]

  @@map("service_families")
}

model GovernmentService {
  id                       String                     @id @default(uuid()) @db.Uuid
  code                     String                     @unique
  slug                     String                     @unique
  officialName             String
  publicName               String
  summary                  String?
  catalogServiceType       CatalogServiceType?
  internalNotes            String?
  sensitiveConfig          Json?
  responsibleInstitutionId String                     @db.Uuid
  responsibleDepartmentId  String                     @db.Uuid
  serviceFamilyId          String                     @db.Uuid
  createdAt                DateTime                   @default(now())
  updatedAt                DateTime                   @updatedAt
  responsibleInstitution   Institution                @relation(fields: [responsibleInstitutionId], references: [id])
  responsibleDepartment    Department                 @relation(fields: [responsibleDepartmentId], references: [id])
  serviceFamily            ServiceFamily              @relation(fields: [serviceFamilyId], references: [id])
  ownerOfficeholderId      String?                    @db.Uuid
  ownerOfficeholder        Officeholder?              @relation(fields: [ownerOfficeholderId], references: [id])
  versions                 GovernmentServiceVersion[]
  applications             Application[]
  cases                    Case[]
  workflowDefinitions      WorkflowDefinition[]

  @@index([responsibleInstitutionId])
  @@index([ownerOfficeholderId])
  @@index([responsibleDepartmentId])
  @@index([serviceFamilyId])
  @@index([catalogServiceType])
  @@map("government_services")
}

model GovernmentServiceVersion {
  id                                  String                                      @id @default(uuid()) @db.Uuid
  governmentServiceId                 String                                      @db.Uuid
  version                             String
  purpose                             String?
  coveredActivities                   String?
  excludedActivities                  String?
  geographicScope                     String?
  publicDescription                   String?
  typicalValidityDescription          String?
  effectiveFrom                       DateTime?
  effectiveUntil                      DateTime?
  informationLastVerifiedAt           DateTime?
  publicDisclaimer                    String?
  authorityClassificationSummary      String?
  majorDependencies                   Json                                        @default("[]")
  internalGoverningSourceMaterial     String?
  restrictedSecurityNotes             String?
  supersededAt                        DateTime?
  formDefinitionId                    String?                                     @db.Uuid
  formVersionId                       String?                                     @db.Uuid
  maturityStatus                      GovernmentServiceMaturityStatus             @default(DRAFT)
  publicAvailability                  GovernmentServicePublicAvailability         @default(HIDDEN)
  institutionallyAccepted             Boolean                                     @default(false)
  institutionallyAcceptedAt           DateTime?
  testReadinessStatus                 ServiceTestReadinessStatus                  @default(NOT_TESTED)
  pilotScopeDescription               String?
  activationFunctionAuthorityRecordId String?                                     @db.Uuid
  supersededByVersionId               String?                                     @db.Uuid
  createdAt                           DateTime                                    @default(now())
  updatedAt                           DateTime                                    @updatedAt
  governmentService                   GovernmentService                           @relation(fields: [governmentServiceId], references: [id])
  activationFunctionAuthority         FunctionAuthorityRecord?                    @relation("ServiceActivationAuthority", fields: [activationFunctionAuthorityRecordId], references: [id])
  supersededByVersion                 GovernmentServiceVersion?                   @relation("GovernmentServiceVersionSupersession", fields: [supersededByVersionId], references: [id])
  supersededVersions                  GovernmentServiceVersion[]                  @relation("GovernmentServiceVersionSupersession")
  activationRecords                   ServiceActivationRecord[]
  formDefinition                      FormDefinition?                             @relation("ServiceVersionFormDefinition", fields: [formDefinitionId], references: [id])
  formVersion                         FormVersion?                                @relation(fields: [formVersionId], references: [id])
  functionMappings                    ServiceFunctionMapping[]
  applicantCategories                 GovernmentServiceVersionApplicantCategory[]
  fees                                GovernmentServiceFeeDefinition[]
  eligibilityRules                    GovernmentServiceEligibilityRule[]
  checklistItems                      GovernmentServiceChecklistItem[]
  outputs                             GovernmentServiceOutputDefinition[]
  redressRoutes                       GovernmentServiceRedressRoute[]
  formDefinitions                     FormDefinition[]
  applications                        Application[]
  applicationSubmissions              ApplicationSubmission[]
  cases                               Case[]

  @@unique([governmentServiceId, version])
  @@index([governmentServiceId])
  @@index([maturityStatus])
  @@index([publicAvailability])
  @@index([formDefinitionId])
  @@index([formVersionId])
  @@index([activationFunctionAuthorityRecordId])
  @@map("government_service_versions")
}

model GovernmentServiceVersionApplicantCategory {
  id                         String                   @id @default(uuid()) @db.Uuid
  governmentServiceVersionId String                   @db.Uuid
  category                   ApplicantCategory
  createdAt                  DateTime                 @default(now())
  governmentServiceVersion   GovernmentServiceVersion @relation(fields: [governmentServiceVersionId], references: [id])

  @@unique([governmentServiceVersionId, category])
  @@index([governmentServiceVersionId])
  @@map("government_service_version_applicant_categories")
}

model ServiceFunctionMapping {
  id                         String                       @id @default(uuid()) @db.Uuid
  governmentServiceVersionId String                       @db.Uuid
  functionAuthorityRecordId  String                       @db.Uuid
  sequenceOrder              Int                          @default(0)
  isConsequential            Boolean                      @default(true)
  publicStageLabel           String?
  status                     ServiceFunctionMappingStatus @default(ACTIVE)
  effectiveFrom              DateTime?
  effectiveUntil             DateTime?
  createdAt                  DateTime                     @default(now())
  updatedAt                  DateTime                     @updatedAt
  governmentServiceVersion   GovernmentServiceVersion     @relation(fields: [governmentServiceVersionId], references: [id])
  functionAuthorityRecord    FunctionAuthorityRecord      @relation(fields: [functionAuthorityRecordId], references: [id])

  @@unique([governmentServiceVersionId, functionAuthorityRecordId])
  @@index([governmentServiceVersionId])
  @@index([functionAuthorityRecordId])
  @@map("service_function_mappings")
}

model FormDefinition {
  id                        String                     @id @default(uuid()) @db.Uuid
  code                      String                     @unique
  name                      String
  purpose                   String?
  description               String?
  governmentServiceVersionId String                    @db.Uuid
  status                    FormDefinitionStatus       @default(DRAFT)
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt
  governmentServiceVersion  GovernmentServiceVersion   @relation(fields: [governmentServiceVersionId], references: [id])
  versions                  FormVersion[]
  governmentServiceVersions GovernmentServiceVersion[] @relation("ServiceVersionFormDefinition")
  applications              Application[]

  @@index([governmentServiceVersionId])
  @@index([status])
  @@map("form_definitions")
}

model FormVersion {
  id                        String                     @id @default(uuid()) @db.Uuid
  formDefinitionId          String                     @db.Uuid
  version                   Int
  title                     Json
  instructions              Json?
  effectiveFrom             DateTime?
  effectiveUntil            DateTime?
  status                    FormVersionStatus          @default(DRAFT)
  publishedAt               DateTime?
  supersededById            String?                    @db.Uuid
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt
  formDefinition            FormDefinition             @relation(fields: [formDefinitionId], references: [id], onDelete: Cascade)
  supersededBy              FormVersion?               @relation("FormVersionSupersession", fields: [supersededById], references: [id])
  supersedes                FormVersion[]              @relation("FormVersionSupersession")
  sections                  FormSection[]
  governmentServiceVersions GovernmentServiceVersion[]
  applications              Application[]
  applicationSubmissions    ApplicationSubmission[]

  @@unique([formDefinitionId, version])
  @@index([formDefinitionId])
  @@index([status])
  @@map("form_versions")
}

model FormSection {
  id            String      @id @default(uuid()) @db.Uuid
  formVersionId String      @db.Uuid
  sectionKey    String
  title         Json
  description   Json?
  displayOrder  Int
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  formVersion   FormVersion @relation(fields: [formVersionId], references: [id], onDelete: Cascade)
  fields        FormField[]

  @@unique([formVersionId, sectionKey])
  @@index([formVersionId])
  @@map("form_sections")
}

model FormField {
  id                   String                     @id @default(uuid()) @db.Uuid
  formSectionId        String                     @db.Uuid
  fieldKey             String
  label                Json
  description          Json?
  fieldType            FormFieldType
  required             Boolean                    @default(false)
  displayOrder         Int
  defaultValue         Json?
  placeholder          Json?
  dataClassification   FormDataClassification     @default(PUBLIC)
  validationDefinition Json                       @default("{}")
  options              Json?
  sourceMetadata       Json?
  createdAt            DateTime                   @default(now())
  updatedAt            DateTime                   @updatedAt
  formSection          FormSection                @relation(fields: [formSectionId], references: [id], onDelete: Cascade)
  conditionalRules     FormFieldConditionalRule[]

  @@unique([formSectionId, fieldKey])
  @@index([formSectionId])
  @@map("form_fields")
}

model FormFieldConditionalRule {
  id           String                @id @default(uuid()) @db.Uuid
  formFieldId  String                @db.Uuid
  action       FormConditionalAction
  conditions   Json
  logic        FormConditionalLogic  @default(AND)
  displayOrder Int                   @default(0)
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  formField    FormField             @relation(fields: [formFieldId], references: [id], onDelete: Cascade)

  @@index([formFieldId])
  @@map("form_field_conditional_rules")
}

model GovernmentServiceFeeDefinition {
  id                         String                   @id @default(uuid()) @db.Uuid
  governmentServiceVersionId String                   @db.Uuid
  code                       String
  label                      String

  resolvedAt                 DateTime?
  createdAt                  DateTime                            @default(now())
  updatedAt                  DateTime                            @updatedAt
  developmentProject         DevelopmentProject                  @relation(fields: [developmentProjectId], references: [id], onDelete: Cascade)

  @@index([developmentProjectId])
  @@index([status])
  @@map("development_external_dependencies")
}

model DevelopmentProjectProfessional {
  id                   String                    @id @default(uuid()) @db.Uuid
  developmentProjectId String                    @db.Uuid
  identityId           String                    @db.Uuid
  role                 DevelopmentProfessionalRole
  registrationReference String?
  effectiveFrom        DateTime                  @default(now())
  effectiveUntil       DateTime?
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt
  developmentProject   DevelopmentProject        @relation(fields: [developmentProjectId], references: [id], onDelete: Cascade)
  identity             Identity                  @relation("DevelopmentProjectProfessionalIdentity", fields: [identityId], references: [id])

  @@index([developmentProjectId])
  @@index([identityId])
  @@map("development_project_professionals")
}

model DevelopmentProjectFee {
  id                   String             @id @default(uuid()) @db.Uuid
  developmentProjectId String             @db.Uuid
  feeCode              String
  label                String
  amountCents          Int
  currency             String             @default("XCD")
  status               DevelopmentFeeStatus @default(OUTSTANDING)
  paidAt               DateTime?
  paymentTransactionId String?            @db.Uuid
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  developmentProject   DevelopmentProject @relation(fields: [developmentProjectId], references: [id], onDelete: Cascade)

  @@index([developmentProjectId])
  @@index([status])
  @@map("development_project_fees")
}

model DevelopmentOccupancyCertificate {
  id                     String                              @id @default(uuid()) @db.Uuid
  developmentProjectId   String                              @db.Uuid
  certificateReference   String                              @unique
  status                 DevelopmentOccupancyCertificateStatus @default(REQUESTED)
  governmentDecisionId   String?                             @db.Uuid
  issuedByOfficeholderId String?                             @db.Uuid
  issuedAt               DateTime?
  createdAt              DateTime                            @default(now())
  updatedAt              DateTime                            @updatedAt
  developmentProject     DevelopmentProject                  @relation(fields: [developmentProjectId], references: [id], onDelete: Cascade)
  governmentDecision     GovernmentDecision?                 @relation(fields: [governmentDecisionId], references: [id])
  issuedByOfficeholder   Officeholder?                       @relation("DevelopmentOccupancyIssuerOfficeholder", fields: [issuedByOfficeholderId], references: [id])

  @@index([developmentProjectId])
  @@index([status])
  @@map("development_occupancy_certificates")
}

model DevelopmentPlanningAppeal {
  id                   String                          @id @default(uuid()) @db.Uuid
  developmentProjectId String                          @db.Uuid
  appealReference      String                          @unique
  status               DevelopmentPlanningAppealStatus @default(FILED)
  groundsSummary       String
  filedAt              DateTime                        @default(now())
  decidedAt            DateTime?
  createdAt            DateTime                        @default(now())
  updatedAt            DateTime                        @updatedAt
  developmentProject   DevelopmentProject              @relation(fields: [developmentProjectId], references: [id], onDelete: Cascade)

  @@index([developmentProjectId])
  @@index([status])
  @@map("development_planning_appeals")
}

model DevelopmentAccessAudit {
  id                   String                   @id @default(uuid()) @db.Uuid
  developmentProjectId String                   @db.Uuid
  accessorIdentityId   String                   @db.Uuid
  actorKind            DevelopmentAccessActorKind
  endpoint             String
  granted              Boolean
  denialReason         String?
  recordedAt           DateTime                 @default(now())
  developmentProject   DevelopmentProject       @relation(fields: [developmentProjectId], references: [id], onDelete: Cascade)
  accessor             Identity                 @relation("DevelopmentAccessAuditAccessor", fields: [accessorIdentityId], references: [id])

  @@index([developmentProjectId])
  @@index([accessorIdentityId])
  @@map("development_access_audits")
}

enum EvidencePacketPurpose {
  SUBSTANTIVE_REVIEW
  PROFESSIONAL_REVIEW
  INSPECTION_REVIEW
  EXTERNAL_REFERRAL
  DECISION_SUPPORT
  APPEAL_RECORD
  COMPLIANCE_REVIEW
  PROJECT_READINESS
  OTHER_CONTROLLED_PURPOSE
}

enum EvidencePacketVersionStatus {
  DRAFT
  ASSEMBLED
  UNDER_REVIEW
  FROZEN
  SUPERSEDED
  ARCHIVED
}

model EvidencePacket {
  id                         String                @id @default(uuid()) @db.Uuid
  packetNumber               String                @unique
  masterAdministrativeFileId String                @db.Uuid
  caseId                     String?               @db.Uuid
  purpose                    EvidencePacketPurpose
  questionOrIssue            String
  responsibleDepartmentId    String                @db.Uuid
  externalProjectReference   String?
  createdAt                  DateTime              @default(now())
  updatedAt                  DateTime              @updatedAt
  masterAdministrativeFile   MasterAdministrativeFile @relation(fields: [masterAdministrativeFileId], references: [id])
  case                       Case?                 @relation(fields: [caseId], references: [id])
  responsibleDepartment      Department            @relation(fields: [responsibleDepartmentId], references: [id])
  versions                   EvidencePacketVersion[]

  @@index([masterAdministrativeFileId])
  @@index([caseId])
  @@index([responsibleDepartmentId])
  @@map("evidence_packets")
}

model EvidencePacketVersion {
  id                          String                      @id @default(uuid()) @db.Uuid
  packetId                    String                      @db.Uuid
  version                     Int
  status                      EvidencePacketVersionStatus @default(DRAFT)
  evidenceCutoffAt            DateTime?
  assembledByIdentityId       String                      @db.Uuid
  assembledByOfficeholderId   String?                     @db.Uuid
  authorityEvaluationRecordId String?                     @db.Uuid
  frozenAt                    DateTime?
  manifestHash                String?
  supersededById              String?                     @db.Uuid
  readyForDecisionReview      Boolean                     @default(false)
  qualitySummary              Json                        @default("{}")
  createdAt                   DateTime                    @default(now())
  packet                      EvidencePacket              @relation(fields: [packetId], references: [id])
  assembledByOfficeholder     Officeholder?               @relation("EvidencePacketAssembler", fields: [assembledByOfficeholderId], references: [id])
  authorityEvaluationRecord   AuthorityEvaluationRecord?  @relation("EvidencePacketVersionAuthority", fields: [authorityEvaluationRecordId], references: [id])
  supersededBy                EvidencePacketVersion?      @relation("PacketVersionSupersession", fields: [supersededById], references: [id])
  supersedes                  EvidencePacketVersion[]     @relation("PacketVersionSupersession")
  items                       EvidencePacketItem[]
  manifest                    EvidencePacketManifest?
  exclusionRecords            EvidencePacketItemExclusion[]
  decisionReadinessAssessments DecisionReadinessAssessment[]
  governmentDecisions         GovernmentDecision[]

  @@unique([packetId, version])
  @@index([packetId])
  @@index([status])
  @@map("evidence_packet_versions")
}

model EvidencePacketItem {
  id                          String                        @id @default(uuid()) @db.Uuid
  packetVersionId             String                        @db.Uuid
  evidenceRecordId            String                        @db.Uuid
  evidenceStatusAtInclusion   EvidenceRecordStatus
  documentVersionId           String                        @db.Uuid
  inclusionOrder              Int
  limitations                 String?
  departmentalReviewId        String?                       @db.Uuid
  governmentCommunicationId   String?                       @db.Uuid
  professionalReviewId        String?                       @db.Uuid
  inspectionRecordId          String?                       @db.Uuid
  isExplicitlyExcluded        Boolean                       @default(false)
  exclusionRecordId           String?                       @unique @db.Uuid
  createdAt                   DateTime                      @default(now())
  packetVersion               EvidencePacketVersion         @relation(fields: [packetVersionId], references: [id], onDelete: Cascade)
  evidenceRecord              EvidenceRecord                @relation(fields: [evidenceRecordId], references: [id])
  documentVersion             DocumentVersion               @relation(fields: [documentVersionId], references: [id])
  departmentalReview          DepartmentalReviewRecord?     @relation(fields: [departmentalReviewId], references: [id])
  governmentCommunication     GovernmentCommunicationRecord? @relation(fields: [governmentCommunicationId], references: [id])
  professionalReview          ProfessionalReviewRecord?     @relation(fields: [professionalReviewId], references: [id])
  inspectionRecord            InspectionRecord?             @relation(fields: [inspectionRecordId], references: [id])
  exclusionRecord             EvidencePacketItemExclusion?  @relation(fields: [exclusionRecordId], references: [id])
  verificationRecords         EvidenceVerification[]        @relation("PacketItemVerifications")
  acceptanceRecords           EvidencePurposeAcceptance[]   @relation("PacketItemAcceptances")

  @@unique([packetVersionId, evidenceRecordId])
  @@index([packetVersionId])
  @@index([evidenceRecordId])
  @@map("evidence_packet_items")
}

model EvidencePacketManifest {
  id                String                @id @default(uuid()) @db.Uuid
  packetVersionId   String                @unique @db.Uuid
  canonicalManifest Json
  manifestHash      String
  generatedAt       DateTime              @default(now())
  packetVersion     EvidencePacketVersion @relation(fields: [packetVersionId], references: [id], onDelete: Cascade)

  @@map("evidence_packet_manifests")
}

model EvidencePacketItemExclusion {
  id                          String                @id @default(uuid()) @db.Uuid
  packetVersionId             String                @db.Uuid
  evidenceRecordId            String                @db.Uuid
  exclusionReason             String
  authorizedByIdentityId      String                @db.Uuid
  authorizedByOfficeholderId  String?               @db.Uuid
  authorityEvaluationRecordId String?               @db.Uuid
  createdAt                   DateTime              @default(now())
  packetVersion               EvidencePacketVersion @relation(fields: [packetVersionId], references: [id])
  evidenceRecord              EvidenceRecord        @relation(fields: [evidenceRecordId], references: [id])
  authorizedByOfficeholder    Officeholder?         @relation("EvidencePacketExclusionAuthorizer", fields: [authorizedByOfficeholderId], references: [id])
  authorityEvaluationRecord   AuthorityEvaluationRecord? @relation("EvidencePacketExclusionAuthority", fields: [authorityEvaluationRecordId], references: [id])
  excludedItem                EvidencePacketItem?

  @@index([packetVersionId])
  @@index([evidenceRecordId])
  @@map("evidence_packet_item_exclusions")
}


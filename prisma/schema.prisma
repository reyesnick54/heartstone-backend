  createdAt                 DateTime                         @default(now())
  updatedAt                 DateTime                         @updatedAt
  organization              Organization                     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  jurisdiction              Jurisdiction                     @relation(fields: [jurisdictionId], references: [id])
  shipments                 TradeShipment[]
  declarations              CustomsDeclaration[]
  permits                   TradePermit[]
  assessments               CustomsAssessment[]
  appeals                   CustomsAppeal[]

  @@index([jurisdictionId])
  @@index([importerStatus])
  @@index([exporterStatus])
  @@map("trade_organization_profiles")
}

model TradeShipment {
  id                         String                   @id @default(uuid()) @db.Uuid
  organizationId             String                   @db.Uuid
  tradeOrganizationProfileId String                   @db.Uuid
  representativeAuthorityId  String?                  @db.Uuid
  shipmentReference          String                   @unique
  direction                  TradeShipmentDirection
  status                     TradeShipmentStatus      @default(DRAFT)
  description                String?

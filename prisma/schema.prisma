model DepartmentalReviewRecord {
  id                          String                   @id @default(uuid()) @db.Uuid
  caseId                      String                   @db.Uuid
  departmentId                String                   @db.Uuid
  reviewerIdentityId          String                   @db.Uuid
  reviewerOfficeholderId      String                   @db.Uuid
  reviewQuestion              String
  functionAuthorityRecordId   String                   @db.Uuid
  authorityEvaluationRecordId String?                  @db.Uuid
  reviewVersion               Int                      @default(1)
  findings                    String
  limitations                 String?
  recommendationIfPermitted   String?
  status                      DepartmentalReviewStatus @default(DRAFT)
  completedAt                 DateTime?
  supersededById              String?                  @db.Uuid
  createdAt                   DateTime                 @default(now())
  updatedAt                   DateTime                 @updatedAt
  case                        Case                     @relation(fields: [caseId], references: [id])
  department                  Department               @relation(fields: [departmentId], references: [id])
  reviewerIdentity            Identity                 @relation("DepartmentalReviewReviewer", fields: [reviewerIdentityId], references: [id])
  reviewerOfficeholder        Officeholder             @relation("DepartmentalReviewReviewerOfficeholder", fields: [reviewerOfficeholderId], references: [id])

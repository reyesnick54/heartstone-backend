// ─── Labour, Employment & Workforce Regulation Foundation ─────────────────

enum LabourDataClassification {
  PUBLIC
  OFFICIAL
  EMPLOYER_SCOPED
  WORKER_SELF
  PROTECTED_LABOUR
  PROTECTED_WORKER
  RESTRICTED
}

enum LabourActorPersona {
  WORKER
  EMPLOYER
  EMPLOYER_REPRESENTATIVE
  AUTHORIZED_REPRESENTATIVE
  LABOUR_OFFICER
  SENIOR_DECISION_OFFICER
  COMPLIANCE_OFFICER
  EXTERNAL_AUTHORITY_LIAISON
  TECHNICAL_ADMIN
  AI_ASSISTANCE
  PAYMENT_SYSTEM
  SYSTEM
}

enum EmployerRegistryStatus {
  DRAFT
  REGISTERED
  SUSPENDED
  WITHDRAWN
  CLOSED
}

enum EmploymentRelationshipStatus {
  PROPOSED
  ACTIVE
  SUSPENDED
  TERMINATED
  CLOSED
}

enum WorkPermitApplicationProfileStatus {
  LINKED
  ACTIVE
  WITHDRAWN
  CLOSED
}

enum WorkPermitLifecycleStatus {
  NOT_ISSUED
  PENDING_ISSUANCE
  ISSUED
  EFFECTIVE
  EXPIRED
  REVOKED
  SUSPENDED
  SUPERSEDED
  SURRENDERED
}

enum EmploymentDeclarationStatus {
  DRAFT
  SUBMITTED
  ACKNOWLEDGED
  WITHDRAWN
}

enum EmploymentSponsorshipStatus {
  PROPOSED
  ACTIVE
  LIMITED
  WITHDRAWN
  CLOSED
}

enum EmploymentComplaintStatus {
  FILED
  UNDER_REVIEW
  REFERRED
  CLOSED
  WITHDRAWN
}

enum EmploymentDisputeStatus {
  OPEN
  MEDIATION
  ADJUDICATION
  CLOSED
  WITHDRAWN
}

enum LabourExternalDependencyType {
  IMMIGRATION_RESIDENCY
  IMMIGRATION_ENTRY
  PROFESSIONAL_REGULATOR
  OCCUPATIONAL_SAFETY
  HEALTH_SCREENING
  CRIMINAL_RECORD
  EDUCATION_CREDENTIAL
  OTHER_AUTHORIZED
}

enum LabourExternalDependencyRecordedBy {
  EXTERNAL_AUTHORITY_LIAISON
  INTEGRATION_SYSTEM
  LABOUR_OFFICER
  SYSTEM
}

model EmployerRegistryRecord {
  id                            String                   @id @default(uuid()) @db.Uuid
  registryNumber                String                   @unique
  organizationId                String                   @db.Uuid
  jurisdictionId                String?                  @db.Uuid
  institutionId                 String?                  @db.Uuid
  masterAdministrativeFileId    String?                  @db.Uuid
  registrationStatus            EmployerRegistryStatus   @default(DRAFT)
  doesNotSelfAuthorizeWorkers   Boolean                  @default(true)
  dataClassification            LabourDataClassification @default(EMPLOYER_SCOPED)
  registeredAt                  DateTime?
  createdAt                     DateTime                 @default(now())
  updatedAt                     DateTime                 @updatedAt
  organization                  Organization             @relation(fields: [organizationId], references: [id])
  jurisdiction                  Jurisdiction?            @relation(fields: [jurisdictionId], references: [id])
  institution                   Institution?             @relation(fields: [institutionId], references: [id])
  masterAdministrativeFile      MasterAdministrativeFile? @relation(fields: [masterAdministrativeFileId], references: [id])
  employmentRelationships       EmploymentRelationship[]
  employmentDeclarations        EmploymentDeclaration[]
  employmentSponsorships        EmploymentSponsorship[]
  employerWorkforceProfiles     EmployerWorkforceProfile[]
  employerWorkforceDeclarations EmployerWorkforceDeclaration[]
  workPermitRecordsAsEmployer   WorkPermitRecord[]       @relation("WorkPermitEmployer")
  labourInspectionReferences    LabourInspectionReference[]
  employmentComplaints          EmploymentComplaint[]
  employmentDisputes            EmploymentDispute[]
  terminationNotifications      EmploymentTerminationNotification[]
  labourComplianceMatterReferences LabourComplianceMatterReference[]

  @@index([organizationId])
  @@index([jurisdictionId])
  @@index([registrationStatus])
  @@map("employer_registry_records")
}

model WorkerProfileReference {
  id                         String                   @id @default(uuid()) @db.Uuid
  profileReferenceNumber     String                   @unique
  workerIdentityId           String                   @db.Uuid
  jurisdictionId             String?                  @db.Uuid
  masterAdministrativeFileId String?                  @db.Uuid
  dataClassification         LabourDataClassification @default(PROTECTED_WORKER)
  createdAt                  DateTime                 @default(now())
  updatedAt                  DateTime                 @updatedAt
  workerIdentity             Identity                 @relation("LabourWorkerProfile", fields: [workerIdentityId], references: [id])
  jurisdiction               Jurisdiction?          @relation(fields: [jurisdictionId], references: [id])
  masterAdministrativeFile   MasterAdministrativeFile? @relation(fields: [masterAdministrativeFileId], references: [id])
  employmentRelationships    EmploymentRelationship[]
  workPermitApplicationProfiles WorkPermitApplicationProfile[]
  workPermitRecords          WorkPermitRecord[]
  employmentSponsorships     EmploymentSponsorship[]
  professionalQualifications ProfessionalQualificationReference[]
  employmentComplaints       EmploymentComplaint[]    @relation("EmploymentComplaintWorker")
  employmentDisputes         EmploymentDispute[]      @relation("EmploymentDisputeWorker")
  terminationNotifications   EmploymentTerminationNotification[]
  labourComplianceMatterReferences LabourComplianceMatterReference[]
  labourExternalDependencies LabourExternalDependency[]

  @@index([workerIdentityId])
  @@index([jurisdictionId])
  @@map("worker_profile_references")
}

model OccupationClassificationReference {
  id                  String   @id @default(uuid()) @db.Uuid
  classificationCode  String
  classificationLabel String
  schemeReference     String?
  jurisdictionId      String?  @db.Uuid
  effectiveFrom       DateTime @default(now())
  effectiveUntil      DateTime?
  createdAt           DateTime @default(now())
  jurisdiction        Jurisdiction? @relation(fields: [jurisdictionId], references: [id])
  employmentRelationships EmploymentRelationship[]

  @@index([classificationCode])
  @@index([jurisdictionId])
  @@map("occupation_classification_references")
}

model EmploymentRelationship {
  id                                String                       @id @default(uuid()) @db.Uuid
  relationshipNumber                String                       @unique
  employerRegistryRecordId          String                       @db.Uuid
  workerProfileReferenceId          String                       @db.Uuid
  occupationClassificationId        String?                      @db.Uuid
  roleTitle                         String
  status                            EmploymentRelationshipStatus @default(PROPOSED)
  startDate                         DateTime?
  endDate                           DateTime?
  isGovernmentWorkAuthorization     Boolean                      @default(false)
  currentWorkPermitRecordId         String?                      @db.Uuid
  dataClassification                LabourDataClassification     @default(PROTECTED_LABOUR)
  createdAt                         DateTime                     @default(now())
  updatedAt                         DateTime                     @updatedAt
  employerRegistryRecord            EmployerRegistryRecord       @relation(fields: [employerRegistryRecordId], references: [id])
  workerProfileReference            WorkerProfileReference       @relation(fields: [workerProfileReferenceId], references: [id])
  occupationClassification          OccupationClassificationReference? @relation(fields: [occupationClassificationId], references: [id])
  currentWorkPermitRecord           WorkPermitRecord?            @relation("EmploymentRelationshipCurrentPermit", fields: [currentWorkPermitRecordId], references: [id])
  history                           EmploymentRelationshipHistory[]
  employmentDeclarations            EmploymentDeclaration[]
  employmentContractReferences      EmploymentContractReference[]
  employmentSponsorships            EmploymentSponsorship[]

  @@index([employerRegistryRecordId])
  @@index([workerProfileReferenceId])
  @@index([status])
  @@map("employment_relationships")
}

model EmploymentRelationshipHistory {
  id                       String               @id @default(uuid()) @db.Uuid
  employmentRelationshipId String               @db.Uuid
  employerRegistryRecordId String               @db.Uuid
  workerProfileReferenceId String               @db.Uuid
  roleTitle                String
  startDate                DateTime?
  endDate                  DateTime?
  workPermitRecordId       String?              @db.Uuid
  changeReason             String?
  actorIdentityId          String?              @db.Uuid
  actorPersona             LabourActorPersona
  recordedAt               DateTime             @default(now())
  employmentRelationship   EmploymentRelationship @relation(fields: [employmentRelationshipId], references: [id], onDelete: Cascade)
  workPermitRecord         WorkPermitRecord?    @relation(fields: [workPermitRecordId], references: [id])
  actor                    Identity?            @relation("EmploymentRelationshipHistoryActor", fields: [actorIdentityId], references: [id])

  @@index([employmentRelationshipId])
  @@index([recordedAt])
  @@map("employment_relationship_history")
}

model EmploymentDeclaration {
  id                       String                    @id @default(uuid()) @db.Uuid
  declarationReference     String                    @unique
  employerRegistryRecordId String                    @db.Uuid
  employmentRelationshipId String?                   @db.Uuid
  caseId                   String?                   @db.Uuid
  status                   EmploymentDeclarationStatus @default(DRAFT)
  isVerifiedGovernmentFact Boolean                   @default(false)
  declaredAt               DateTime?
  payloadSummary           String?
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  employerRegistryRecord   EmployerRegistryRecord    @relation(fields: [employerRegistryRecordId], references: [id])
  employmentRelationship   EmploymentRelationship?   @relation(fields: [employmentRelationshipId], references: [id])
  case                     Case?                     @relation(fields: [caseId], references: [id])

  @@index([employerRegistryRecordId])
  @@index([employmentRelationshipId])
  @@map("employment_declarations")
}

model EmploymentContractReference {
  id                       String                 @id @default(uuid()) @db.Uuid
  contractReferenceToken   String
  employmentRelationshipId String                 @db.Uuid
  documentRecordId         String?                @db.Uuid
  doesNotAuthorizeWork     Boolean                @default(true)
  doesNotIssueWorkPermit   Boolean                @default(true)
  referencedAt             DateTime               @default(now())
  createdAt                DateTime               @default(now())
  employmentRelationship   EmploymentRelationship @relation(fields: [employmentRelationshipId], references: [id], onDelete: Cascade)
  documentRecord           DocumentRecord?        @relation(fields: [documentRecordId], references: [id])

  @@index([employmentRelationshipId])
  @@map("employment_contract_references")
}

model WorkPermitApplicationProfile {
  id                         String                             @id @default(uuid()) @db.Uuid
  profileNumber              String                             @unique
  workerProfileReferenceId   String                             @db.Uuid
  caseId                     String                             @unique @db.Uuid
  applicationId              String                             @unique @db.Uuid
  immigrationProfileId       String?                            @db.Uuid
  status                     WorkPermitApplicationProfileStatus @default(LINKED)
  submissionAcknowledgedAt   DateTime?
  doesNotIssueWorkPermit     Boolean                            @default(true)
  paymentDoesNotApprove      Boolean                            @default(true)
  serviceCategoryCode        String?
  createdAt                  DateTime                           @default(now())
  updatedAt                  DateTime                           @updatedAt
  workerProfileReference     WorkerProfileReference             @relation(fields: [workerProfileReferenceId], references: [id])
  case                       Case                               @relation(fields: [caseId], references: [id])
  application                Application                        @relation(fields: [applicationId], references: [id])
  immigrationProfile         ImmigrationProfile?                @relation(fields: [immigrationProfileId], references: [id])
  workPermitRecords            WorkPermitRecord[]

  @@index([workerProfileReferenceId])
  @@index([immigrationProfileId])
  @@map("work_permit_application_profiles")
}

model WorkPermitRecord {
  id                            String                  @id @default(uuid()) @db.Uuid
  permitNumber                  String                  @unique
  workerProfileReferenceId      String                  @db.Uuid
  employerRegistryRecordId      String?                 @db.Uuid
  workPermitApplicationProfileId String?                @db.Uuid
  immigrationProfileId          String?                 @db.Uuid
  linkedResidencyPermitRecordId String?                 @db.Uuid
  governmentDecisionId          String?                 @db.Uuid
  officialInstrumentId          String?                 @db.Uuid
  lifecycleStatus               WorkPermitLifecycleStatus @default(NOT_ISSUED)
  doesNotCreateResidency        Boolean                 @default(true)
  validFrom                     DateTime?
  validUntil                    DateTime?
  renewalOfPermitId             String?                 @unique @db.Uuid
  dataClassification            LabourDataClassification @default(PROTECTED_LABOUR)
  createdAt                     DateTime                @default(now())
  updatedAt                     DateTime                @updatedAt
  workerProfileReference        WorkerProfileReference  @relation(fields: [workerProfileReferenceId], references: [id])
  employerRegistryRecord        EmployerRegistryRecord? @relation("WorkPermitEmployer", fields: [employerRegistryRecordId], references: [id])
  workPermitApplicationProfile  WorkPermitApplicationProfile? @relation(fields: [workPermitApplicationProfileId], references: [id])
  immigrationProfile            ImmigrationProfile?     @relation(fields: [immigrationProfileId], references: [id])
  linkedResidencyPermitRecord   ResidencyPermitRecord?  @relation("WorkPermitResidencyCoordination", fields: [linkedResidencyPermitRecordId], references: [id])
  governmentDecision            GovernmentDecision?     @relation(fields: [governmentDecisionId], references: [id])
  officialInstrument            OfficialInstrument?     @relation(fields: [officialInstrumentId], references: [id])
  renewalOfPermit               WorkPermitRecord?       @relation("WorkPermitRenewal", fields: [renewalOfPermitId], references: [id])
  renewedByPermit               WorkPermitRecord?       @relation("WorkPermitRenewal")
  conditions                    WorkPermitCondition[]
  statusHistory                 WorkPermitStatusHistory[]
  employmentRelationshipHistory EmploymentRelationshipHistory[]
  employmentRelationshipsCurrent EmploymentRelationship[] @relation("EmploymentRelationshipCurrentPermit")

  @@index([workerProfileReferenceId])
  @@index([employerRegistryRecordId])
  @@index([lifecycleStatus])
  @@index([immigrationProfileId])
  @@map("work_permit_records")
}

model WorkPermitCondition {
  id               String         @id @default(uuid()) @db.Uuid
  workPermitRecordId String       @db.Uuid
  conditionCode    String
  conditionSummary String?
  effectiveFrom    DateTime       @default(now())
  effectiveUntil   DateTime?
  createdAt        DateTime       @default(now())
  workPermitRecord WorkPermitRecord @relation(fields: [workPermitRecordId], references: [id], onDelete: Cascade)

  @@index([workPermitRecordId])
  @@map("work_permit_conditions")
}

model WorkPermitStatusHistory {
  id                 String                  @id @default(uuid()) @db.Uuid
  workPermitRecordId String                  @db.Uuid
  fromStatus         WorkPermitLifecycleStatus?
  toStatus           WorkPermitLifecycleStatus
  actorIdentityId    String?                 @db.Uuid
  actorPersona       LabourActorPersona
  reason             String?
  governmentDecisionId String?               @db.Uuid
  recordedAt         DateTime                @default(now())
  workPermitRecord   WorkPermitRecord        @relation(fields: [workPermitRecordId], references: [id], onDelete: Cascade)
  actor              Identity?               @relation("WorkPermitStatusHistoryActor", fields: [actorIdentityId], references: [id])
  governmentDecision GovernmentDecision?     @relation(fields: [governmentDecisionId], references: [id])

  @@index([workPermitRecordId])
  @@index([recordedAt])
  @@map("work_permit_status_history")
}

model EmploymentSponsorship {
  id                       String                    @id @default(uuid()) @db.Uuid
  sponsorshipNumber        String                    @unique
  employerRegistryRecordId String                    @db.Uuid
  workerProfileReferenceId String                    @db.Uuid
  employmentRelationshipId String?                   @db.Uuid
  caseId                   String?                   @db.Uuid
  immigrationProfileId     String?                   @db.Uuid

}

model ComplianceStatusProjection {
  id                          String                         @id @default(uuid()) @db.Uuid
  audience                    ComplianceDashboardAudience
  subjectIdentityId           String?                        @db.Uuid
  subjectOfficeholderId         String?                        @db.Uuid
  subjectDepartmentId           String?                        @db.Uuid
  subjectInstitutionId          String?                        @db.Uuid
  caseId                        String?                        @db.Uuid
  masterAdministrativeFileId    String?                        @db.Uuid
  officialInstrumentId          String?                        @db.Uuid
  status                        ComplianceProjectionStatus     @default(NO_CURRENT_ASSESSMENT)
  projectionDisclaimer          String
  underlyingAssessmentType      String?
  underlyingAssessmentId        String?                        @db.Uuid
  evidenceCutoffAt              DateTime?
  openFindingRefs               Json                           @default("[]")
  openCorrectiveActionRefs      Json                           @default("[]")
  instrumentStatusSnapshot      String?
  functionAuthorityRecordId     String?                        @db.Uuid
  authorityEvaluationRecordId   String?                        @db.Uuid
  lastReviewedAt                DateTime?
  nextReviewAt                  DateTime?
  projectionVersion             Int                            @default(1)
  lastDerivedAt                 DateTime                       @default(now())
  createdAt                     DateTime                       @default(now())
  updatedAt                     DateTime                       @updatedAt
  subjectIdentity               Identity?                      @relation("ComplianceProjectionSubjectIdentity", fields: [subjectIdentityId], references: [id])
  subjectOfficeholder           Officeholder?                  @relation("ComplianceProjectionSubjectOfficeholder", fields: [subjectOfficeholderId], references: [id])
  subjectDepartment             Department?                    @relation(fields: [subjectDepartmentId], references: [id])
  subjectInstitution            Institution?                   @relation(fields: [subjectInstitutionId], references: [id])
  case                          Case?                          @relation(fields: [caseId], references: [id])
  masterAdministrativeFile      MasterAdministrativeFile?      @relation(fields: [masterAdministrativeFileId], references: [id])
  officialInstrument            OfficialInstrument?            @relation(fields: [officialInstrumentId], references: [id])
  functionAuthorityRecord       FunctionAuthorityRecord?       @relation(fields: [functionAuthorityRecordId], references: [id])
  authorityEvaluationRecord     AuthorityEvaluationRecord?     @relation("ComplianceProjectionAuthority", fields: [authorityEvaluationRecordId], references: [id])
  indicators                    ComplianceIndicator[]
  alerts                        ComplianceAlert[]
  monitoringEvents              ComplianceMonitoringEvent[]
  revalidationRecords           ComplianceRevalidationRecord[]

  @@index([audience])
  @@index([status])
  @@index([caseId])
  @@index([subjectIdentityId])
  @@index([subjectDepartmentId])
  @@index([lastDerivedAt])
  @@map("compliance_status_projections")
}

model ComplianceIndicator {
  id                  String                     @id @default(uuid()) @db.Uuid
  projectionId        String                     @db.Uuid
  indicatorType       ComplianceIndicatorType
  displayLabel        String
  countValue          Int                        @default(0)
  drillDownReferences Json                       @default("[]")
  computedAt          DateTime                   @default(now())
  projection          ComplianceStatusProjection @relation(fields: [projectionId], references: [id], onDelete: Cascade)

  @@unique([projectionId, indicatorType])
  @@index([indicatorType])
  @@map("compliance_indicators")
}

model MonitoringRule {
  id                 String                      @id @default(uuid()) @db.Uuid
  code               String                      @unique
  name               String
  description        String?
  ruleType           MonitoringRuleType
  status             MonitoringRuleStatus        @default(DRAFT)
  institutionId      String?                     @db.Uuid
  departmentId       String?                     @db.Uuid
  structuredConfig   Json                        @default("{}")
  warningDaysBefore  Int?
  criticalDaysBefore Int?
  reviewIntervalDays Int?
  effectiveFrom      DateTime?
  effectiveUntil     DateTime?
  createdAt          DateTime                    @default(now())
  updatedAt          DateTime                    @updatedAt
  institution        Institution?                @relation(fields: [institutionId], references: [id])
  department         Department?                 @relation(fields: [departmentId], references: [id])
  monitoringEvents   ComplianceMonitoringEvent[]
  alerts             ComplianceAlert[]

  @@index([ruleType, status])
  @@index([institutionId])
  @@map("monitoring_rules")
}

model ComplianceMonitoringEvent {
  id               String                        @id @default(uuid()) @db.Uuid
  projectionId     String?                       @db.Uuid
  monitoringRuleId String?                       @db.Uuid
  eventType        ComplianceMonitoringEventType
  eventSummary     String
  sourceDataRefs   Json                          @default("[]")
  uncertaintyNotes String?
  occurredAt       DateTime                      @default(now())
  projection       ComplianceStatusProjection?   @relation(fields: [projectionId], references: [id])
  monitoringRule   MonitoringRule?               @relation(fields: [monitoringRuleId], references: [id])

  @@index([projectionId])
  @@index([monitoringRuleId])
  @@index([eventType])
  @@index([occurredAt])
  @@map("compliance_monitoring_events")
}

model ComplianceAlert {
  id                        String                     @id @default(uuid()) @db.Uuid
  projectionId              String                     @db.Uuid
  monitoringRuleId          String?                    @db.Uuid
  alertLevel                ComplianceAlertLevel
  status                    ComplianceAlertStatus      @default(OPEN)
  title                     String
  summary                   String
  sourceDataRefs            Json                       @default("[]")
  uncertaintyNotes          String?
  isViolation               Boolean                    @default(false)
  isEnforcementDecision     Boolean                    @default(false)
  methodologyVersion        String?
  inputsSnapshot            Json                       @default("{}")
  limitations               String?
  humanReviewRequired       Boolean                    @default(true)
  humanReviewedAt           DateTime?
  humanReviewedByIdentityId String?                    @db.Uuid
  raisedAt                  DateTime                   @default(now())
  resolvedAt                DateTime?
  projection                ComplianceStatusProjection @relation(fields: [projectionId], references: [id], onDelete: Cascade)
  monitoringRule            MonitoringRule?            @relation(fields: [monitoringRuleId], references: [id])
  humanReviewedBy           Identity?                  @relation("ComplianceAlertReviewer", fields: [humanReviewedByIdentityId], references: [id])

  @@index([projectionId])
  @@index([alertLevel])
  @@index([status])
  @@map("compliance_alerts")
}

model ComplianceRevalidationRecord {
  id                     String                        @id @default(uuid()) @db.Uuid
  projectionId           String                        @db.Uuid
  trigger                ComplianceRevalidationTrigger
  triggerSummary         String
  sourceDataRefs         Json                          @default("[]")
  priorAssessmentId      String?                       @db.Uuid
  priorAssessmentType    String?
  doesNotRenewInstrument Boolean                       @default(true)
  recordedAt             DateTime                      @default(now())
  recordedByIdentityId   String?                       @db.Uuid
  projection             ComplianceStatusProjection    @relation(fields: [projectionId], references: [id], onDelete: Cascade)
  recordedBy             Identity?                     @relation("ComplianceRevalidationRecorder", fields: [recordedByIdentityId], references: [id])

  @@index([projectionId])
  @@index([trigger])
  @@map("compliance_revalidation_records")
}

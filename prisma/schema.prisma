  status                SimulationScenarioStatus @default(DRAFT)
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt
  twinVersion           DigitalTwinVersion       @relation(fields: [twinVersionId], references: [id])
  inputSnapshot         DigitalTwinSnapshot?     @relation("ScenarioInputSnapshot", fields: [inputSnapshotId], references: [id])
  runs                  SimulationRun[]

  @@index([twinVersionId])
  @@index([status])
  @@map("simulation_scenarios")
}

model SimulationRun {
  id              String              @id @default(uuid()) @db.Uuid
  scenarioId      String              @db.Uuid
  runNumber       Int
  twinVersionId   String              @db.Uuid
  inputSnapshotId String              @db.Uuid
  mode            DigitalTwinMode     @default(SIMULATION)
  status          SimulationRunStatus @default(PENDING)
  startedAt       DateTime?
  completedAt     DateTime?
  createdAt       DateTime            @default(now())
  scenario        SimulationScenario  @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  twinVersion     DigitalTwinVersion  @relation(fields: [twinVersionId], references: [id])
  inputSnapshot   DigitalTwinSnapshot @relation("RunInputSnapshot", fields: [inputSnapshotId], references: [id])
  inputs          SimulationInput[]
  outputs         SimulationOutput[]
  assumptions     SimulationAssumption[]
  uncertainties   SimulationUncertainty[]
  reviews         SimulationReview[]
  consequentialUseReviews ConsequentialUseReview[]

  @@unique([scenarioId, runNumber])
  @@index([scenarioId])
  @@index([twinVersionId])
  @@index([status])
  @@map("simulation_runs")
}

model SimulationInput {
  id              String              @id @default(uuid()) @db.Uuid
  simulationRunId String              @db.Uuid

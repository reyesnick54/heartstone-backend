}

model ConsequentialUseReview {
  id                       String                         @id @default(uuid()) @db.Uuid
  twinVersionId            String                         @db.Uuid
  simulationRunId          String?                        @db.Uuid
  simulationOutputId       String?                        @db.Uuid
  representedSubjectType   DigitalTwinType
  representedSubjectId     String                         @db.Uuid

  sourceStatus      AnalysisSourceStatus
  confidenceNotes   String?
  uncertaintyNotes  String?
  isStaleSource     Boolean                    @default(false)
  observedAt        DateTime                   @default(now())
  createdAt         DateTime                   @default(now())
  rule              IntelligenceMonitoringRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  alerts            IntelligenceMonitoringAlert[]

  @@index([ruleId])
  @@index([observedAt])
  @@map("intelligence_monitoring_observations")
}

model IntelligenceMonitoringAlert {
  id                            String                            @id @default(uuid()) @db.Uuid
  alertNumber                   String                            @unique
  ruleId                        String                            @db.Uuid
  observationId                   String?                           @db.Uuid
  monitoredObjectType           IntelligenceMonitoringObjectType
  monitoredObjectReference      String
  sourceReference               String
  observedCondition             String
  observedAt                    DateTime
  confidenceNotes               String?
  uncertaintyNotes              String?
  affectedServiceIds            Json                              @default("[]")
  recommendedReview             String
  responsibleRecipientIdentityId String                           @db.Uuid
  status                        IntelligenceAlertStatus           @default(GENERATED)
  isViolation                   Boolean                           @default(false)
  isEmergency                   Boolean                           @default(false)
  isEnforcement                 Boolean                           @default(false)
  generatedAt                   DateTime                          @default(now())
  createdAt                     DateTime                          @default(now())
  updatedAt                     DateTime                          @updatedAt
  rule                          IntelligenceMonitoringRule        @relation(fields: [ruleId], references: [id])
  observation                   IntelligenceMonitoringObservation? @relation(fields: [observationId], references: [id])
  responsibleRecipient          Identity                          @relation("IntelligenceMonitoringAlertRecipient", fields: [responsibleRecipientIdentityId], references: [id])
  verifications                 IntelligenceAlertVerification[]
  dispositions                  IntelligenceAlertDisposition[]

  @@index([ruleId])
  @@index([status])
  @@index([observedAt])
  @@map("intelligence_monitoring_alerts")

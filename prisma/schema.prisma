generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum StructuralLifecycleStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  ARCHIVED
}

enum JurisdictionType {
  NATIONAL
  SUBNATIONAL
  MUNICIPAL
  SPECIAL_ECONOMIC_ZONE
  REGULATORY
  SUBJECT_MATTER
  OTHER
}

enum InstitutionType {
  GOVERNMENT
  MINISTRY
  AGENCY
  AUTHORITY
  REGULATOR
  STATUTORY_BODY
  SPECIAL_ECONOMIC_ZONE_AUTHORITY
  PUBLIC_BODY
  OTHER
}

enum GovernmentBodyType {
  GOVERNING
  SUPERVISORY
  ADVISORY
  ADMINISTRATIVE
  DECISION_MAKING
  OTHER
}

enum AppointmentStatus {
  PENDING
  ACTIVE
  SUSPENDED
  ENDED
  REVOKED
}

enum DelegationStatus {
  PENDING
  ACTIVE
  SUSPENDED
  REVOKED
  ENDED
}

enum ExternalAuthorityType {
  GOVERNMENT
  REGULATORY
  JUDICIAL
  PROFESSIONAL
  INSTITUTIONAL
  OTHER
}

model SystemMetadata {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("system_metadata")
}

model Jurisdiction {
  id           String                    @id @default(uuid()) @db.Uuid
  code         String                    @unique
  name         String
  description  String?
  type         JurisdictionType
  status       StructuralLifecycleStatus @default(ACTIVE)
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt
  institutions              Institution[]
  inspectionTypeDefinitions InspectionTypeDefinition[]
  inspectionPlans           InspectionPlan[]
  inspectionAssignments     InspectionAssignment[]

  @@map("jurisdictions")
}

model Institution {
  id                            String                          @id @default(uuid()) @db.Uuid
  jurisdictionId                String                          @db.Uuid
  code                          String
  name                          String
  description                   String?
  type                          InstitutionType
  status                        StructuralLifecycleStatus       @default(ACTIVE)
  createdAt                     DateTime                        @default(now())
  updatedAt                     DateTime                        @updatedAt
  jurisdiction                  Jurisdiction                    @relation(fields: [jurisdictionId], references: [id])
  governmentBodies              GovernmentBody[]
  departments                   Department[]
  delegations                   Delegation[]
  externalAuthorityRelations    InstitutionExternalAuthority[]
  functionAuthorityRecords      FunctionAuthorityRecord[]
  functionAuthorityAssignments  FunctionAuthorityAssignment[]
  institutionalAuthorityActs    InstitutionalAuthorityAct[]
  responsibleGovernmentServices GovernmentService[]
  caseReferrals                 CaseReferral[]
  responsibleCases              Case[]
  masterAdministrativeFiles     MasterAdministrativeFile[]
  documentRecords               DocumentRecord[]
  governmentCommunications      GovernmentCommunicationRecord[] @relation("GovernmentCommunicationSourceInstitution")
  governmentDecisions           GovernmentDecision[]
  instrumentTypeVersions        InstrumentTypeVersion[]         @relation("InstrumentIssuingInstitution")
  instrumentNumberingRules      InstrumentNumberingRule[]
  issuedOfficialInstruments     OfficialInstrument[]            @relation("OfficialInstrumentIssuerInstitution")
  complianceMattersResponsible ComplianceMatter[]
  responsibleInspectionTypes   InspectionTypeDefinition[] @relation("InspectionTypeResponsibleInstitution")
  complianceStatusProjections  ComplianceStatusProjection[]
  monitoringRules              MonitoringRule[]

  @@unique([jurisdictionId, code])
  @@index([jurisdictionId])
  @@map("institutions")
}

model GovernmentBody {
  id            String                    @id @default(uuid()) @db.Uuid
  institutionId String                    @db.Uuid
  code          String
  name          String
  description   String?
  type          GovernmentBodyType
  status        StructuralLifecycleStatus @default(ACTIVE)
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt
  institution   Institution               @relation(fields: [institutionId], references: [id])

  @@unique([institutionId, code])
  @@index([institutionId])
  @@map("government_bodies")
}

model Department {
  id                            String                     @id @default(uuid()) @db.Uuid
  institutionId                 String                     @db.Uuid
  code                          String
  name                          String
  description                   String?
  status                        StructuralLifecycleStatus  @default(ACTIVE)
  createdAt                     DateTime                   @default(now())
  updatedAt                     DateTime                   @updatedAt
  institution                   Institution                @relation(fields: [institutionId], references: [id])
  offices                       Office[]
  responsibleGovernmentServices GovernmentService[]
  responsibleCases              Case[]
  masterAdministrativeFiles     MasterAdministrativeFile[]
  departmentalReviews           DepartmentalReviewRecord[]
  evidencePackets               EvidencePacket[]
  governmentDecisions           GovernmentDecision[]
  complianceMattersResponsible  ComplianceMatter[]
  responsibleInspectionTypes  InspectionTypeDefinition[] @relation("InspectionTypeResponsibleDepartment")
  complianceStatusProjections   ComplianceStatusProjection[]
  monitoringRules               MonitoringRule[]

  @@unique([institutionId, code])
  @@index([institutionId])
  @@map("departments")
}

model Office {
  id                               String                        @id @default(uuid()) @db.Uuid
  departmentId                     String                        @db.Uuid
  code                             String
  name                             String
  description                      String?
  status                           StructuralLifecycleStatus     @default(ACTIVE)
  createdAt                        DateTime                      @default(now())
  updatedAt                        DateTime                      @updatedAt
  department                       Department                    @relation(fields: [departmentId], references: [id])
  appointments                     Appointment[]
  delegationsAsDelegator           Delegation[]                  @relation("DelegationDelegatorOffice")
  delegationsAsRecipient           Delegation[]                  @relation("DelegationRecipientOffice")
  functionAuthorityRecords         FunctionAuthorityRecord[]
  functionAuthorityAssignments     FunctionAuthorityAssignment[]
  masterFilesAsAdministrativeOwner MasterAdministrativeFile[]    @relation("MasterFileAdministrativeOwner")
  masterFilesAsRecordsCustodian    MasterAdministrativeFile[]    @relation("MasterFileRecordsCustodian")
  continuingObligationReviews      ContinuingObligation[]        @relation("ObligationReviewingOffice")

  @@unique([departmentId, code])
  @@index([departmentId])
  @@map("offices")
}

model Officeholder {
  id                            String                        @id @default(uuid()) @db.Uuid
  code                          String                        @unique
  name                          String
  description                   String?
  status                        StructuralLifecycleStatus     @default(ACTIVE)
  createdAt                     DateTime                      @default(now())
  updatedAt                     DateTime                      @updatedAt
  appointments                  Appointment[]
  delegationsAsDelegator        Delegation[]                  @relation("DelegationDelegatorOfficeholder")
  delegationsAsRecipient        Delegation[]                  @relation("DelegationRecipientOfficeholder")
  identityLinks                 IdentityOfficeholderLink[]
  functionAuthorityAssignments  FunctionAuthorityAssignment[]
  ownedGovernmentServices       GovernmentService[]
  managedCases                  Case[]                        @relation("CaseManager")
  caseEvents                    CaseEvent[]                   @relation("CaseEventOfficeholder")
  communicationsAsSender        CaseCommunication[]           @relation("CommunicationSenderOfficeholder")
  evidenceVerifications         EvidenceVerification[]        @relation("EvidenceVerificationVerifierOfficeholder")
  evidencePurposeAcceptances    EvidencePurposeAcceptance[]   @relation("EvidencePurposeAcceptanceReviewerOfficeholder")
  evidenceQualityAssessments    EvidenceQualityAssessment[]   @relation("EvidenceQualityAssessorOfficeholder")
  departmentalReviewsAsReviewer DepartmentalReviewRecord[]    @relation("DepartmentalReviewReviewerOfficeholder")
  inspectionInspectors          InspectionInspector[]
  custodyEventsAsCustodian      EvidenceCustodyEvent[]        @relation("EvidenceCustodyCustodianOfficeholder")
  custodyEventsAsWitness        EvidenceCustodyEvent[]        @relation("EvidenceCustodyWitnessOfficeholder")
  assembledEvidencePackets      EvidencePacketVersion[]       @relation("EvidencePacketAssembler")
  authorizedPacketExclusions    EvidencePacketItemExclusion[] @relation("EvidencePacketExclusionAuthorizer")
  recordCorrectionsApproved     RecordCorrection[]            @relation("RecordCorrectionApproverOfficeholder")
  recordIntegrityEvents         RecordIntegrityEvent[]        @relation("RecordIntegrityActorOfficeholder")
  recordAccessEvents            RecordAccessEvent[]           @relation("RecordAccessOfficeholder")
  decisionReadinessProposed     DecisionReadinessAssessment[] @relation("DecisionReadinessProposedOfficeholder")
  decisionParticipants          DecisionParticipant[]         @relation("DecisionParticipantOfficeholder")
  governmentDecisionsMade       GovernmentDecision[]          @relation("GovernmentDecisionOfficeholder")
  issuedOfficialInstruments     OfficialInstrument[]          @relation("OfficialInstrumentIssuerOfficeholder")
  issuanceEventsAsIssuer        IssuanceEvent[]               @relation("IssuanceEventIssuerOfficeholder")
  instrumentsHeld               OfficialInstrument[]          @relation("InstrumentHolderOfficeholder")
  instrumentLifecycleEvents     InstrumentLifecycleEvent[]    @relation("InstrumentLifecycleActorOfficeholder")
  reviewReferencesAsAppellant   DecisionReviewReference[]     @relation("ReviewAppellantOfficeholder")
  inspectionAssignments        InspectionAssignment[]
  complianceProjectionSubjects  ComplianceStatusProjection[]  @relation("ComplianceProjectionSubjectOfficeholder")
  complianceReviewsAsReviewer   ComplianceReview[]            @relation("ComplianceReviewReviewerOfficeholder")

  @@map("officeholders")
}

model Appointment {
  id                   String                @id @default(uuid()) @db.Uuid
  officeId             String                @db.Uuid
  officeholderId       String                @db.Uuid
  status               AppointmentStatus     @default(PENDING)
  effectiveFrom        DateTime
  effectiveUntil       DateTime?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  office               Office                @relation(fields: [officeId], references: [id])
  officeholder         Officeholder          @relation(fields: [officeholderId], references: [id])
  decisionParticipants  DecisionParticipant[]
  governmentDecisions   GovernmentDecision[]
  inspectionAssignments InspectionAssignment[]

  @@index([officeId])
  @@index([officeholderId])
  @@map("appointments")
}

model Delegation {
  id                      String                      @id @default(uuid()) @db.Uuid
  institutionId           String                      @db.Uuid
  delegatorOfficeId       String?                     @db.Uuid
  delegatorOfficeholderId String?                     @db.Uuid
  recipientOfficeId       String?                     @db.Uuid
  recipientOfficeholderId String?                     @db.Uuid
  scopeDescription        String
  status                  DelegationStatus            @default(PENDING)
  effectiveFrom           DateTime
  effectiveUntil          DateTime?
  createdAt               DateTime                    @default(now())
  updatedAt               DateTime                    @updatedAt
  institution             Institution                 @relation(fields: [institutionId], references: [id])
  delegatorOffice         Office?                     @relation("DelegationDelegatorOffice", fields: [delegatorOfficeId], references: [id])
  delegatorOfficeholder   Officeholder?               @relation("DelegationDelegatorOfficeholder", fields: [delegatorOfficeholderId], references: [id])
  recipientOffice         Office?                     @relation("DelegationRecipientOffice", fields: [recipientOfficeId], references: [id])
  recipientOfficeholder   Officeholder?               @relation("DelegationRecipientOfficeholder", fields: [recipientOfficeholderId], references: [id])
  structuredScopes        DelegationStructuredScope[]
  governmentDecisions     GovernmentDecision[]

  @@index([institutionId])
  @@map("delegations")
}

model ExternalAuthority {
  id                               String                            @id @default(uuid()) @db.Uuid
  code                             String                            @unique
  name                             String
  description                      String?
  type                             ExternalAuthorityType
  status                           StructuralLifecycleStatus         @default(ACTIVE)
  createdAt                        DateTime                          @default(now())
  updatedAt                        DateTime                          @updatedAt
  institutionRelations             InstitutionExternalAuthority[]
  authorityDependencies            AuthorityDependency[]
  externalDependencyDeterminations ExternalDependencyDetermination[]
  institutionalAuthorityActs       InstitutionalAuthorityAct[]
  caseReferrals                    CaseReferral[]
  documentVersionsReceived         DocumentVersion[]
  retainedDeterminations           GovernmentCommunicationRecord[]   @relation("RetainedDeterminationExternalAuthority")

  @@map("external_authorities")
}

model InstitutionExternalAuthority {
  id                  String                    @id @default(uuid()) @db.Uuid
  institutionId       String                    @db.Uuid
  externalAuthorityId String                    @db.Uuid
  relationshipLabel   String?
  status              StructuralLifecycleStatus @default(ACTIVE)
  effectiveFrom       DateTime?
  effectiveUntil      DateTime?
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt
  institution         Institution               @relation(fields: [institutionId], references: [id])
  externalAuthority   ExternalAuthority         @relation(fields: [externalAuthorityId], references: [id])

  @@unique([institutionId, externalAuthorityId])
  @@index([institutionId])
  @@index([externalAuthorityId])
  @@map("institution_external_authorities")
}

// ─── Phase 3: Identity & Access ─────────────────────────────────────────────

enum AccountStatus {
  PENDING
  ACTIVE
  SUSPENDED
  REVOKED
}

enum IdentityType {
  INDIVIDUAL
  ORGANIZATION
  SERVICE
}

enum CredentialType {
  PASSWORD
  OIDC
  API_KEY
  MFA_TOTP
}

enum CredentialStatus {
  PENDING
  ACTIVE
  REVOKED
}

enum AuthenticationMethodType {
  PASSWORD
  OIDC
  SERVICE_API_KEY
  MFA_TOTP
}

enum AssuranceLevel {
  NONE
  LOW
  MEDIUM
  HIGH
}

enum OrganizationStatus {
  PENDING
  ACTIVE
  SUSPENDED
  REVOKED
}

enum MembershipStatus {
  PENDING
  ACTIVE
  SUSPENDED
  REVOKED
}

enum RepresentativeAuthorityStatus {
  PENDING
  ACTIVE
  SUSPENDED
  REVOKED
  ENDED
}

enum SessionStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

enum SessionRevocationReason {
  USER_LOGOUT
  ADMIN_REVOCATION
  ACCOUNT_REVOCATION
  SECURITY_EVENT
  REPLACED
  EXPIRED
}

enum IdentityOfficeholderLinkStatus {
  PENDING
  ACTIVE
  REVOKED
}

enum SecurityAuditEventType {
  PERSON_CREATED
  USER_ACCOUNT_CREATED
  USER_ACCOUNT_SUSPENDED
  IDENTITY_CREATED
  IDENTITY_ATTACHED
  CREDENTIAL_CREATED
  CREDENTIAL_REVOKED
  AUTHENTICATION_METHOD_CONFIGURED
  AUTHENTICATION_SUCCESS
  AUTHENTICATION_FAILURE
  SESSION_CREATED
  SESSION_REVOKED
  SESSION_REJECTED
  SESSION_EXPIRED
  CREDENTIAL_REJECTED
  SUSPENDED_ACCOUNT_LOGIN_ATTEMPT
  REVOKED_ACCOUNT_LOGIN_ATTEMPT
  ORGANIZATION_CREATED
  MEMBERSHIP_CREATED
  REPRESENTATIVE_AUTHORITY_CREATED
  OFFICEHOLDER_LINK_CREATED
  OFFICEHOLDER_LINK_REVOKED
  OIDC_CLAIM_RECEIVED
  MFA_VERIFIED
  SERVICE_IDENTITY_AUTHENTICATED
  PROTECTED_ENDPOINT_ACCESS
}

model Person {
  id          String       @id @default(uuid()) @db.Uuid
  givenName   String
  familyName  String
  displayName String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  userAccount UserAccount?
  identities  Identity[]

  @@map("persons")
}

model UserAccount {
  id              String        @id @default(uuid()) @db.Uuid
  personId        String?       @unique @db.Uuid
  loginIdentifier String        @unique
  status          AccountStatus @default(PENDING)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  person          Person?       @relation(fields: [personId], references: [id])
  identities      Identity[]
  sessions        Session[]

  @@index([status])
  @@map("user_accounts")
}

model Identity {
  id                                  String                            @id @default(uuid()) @db.Uuid
  type                                IdentityType
  userAccountId                       String?                           @db.Uuid
  personId                            String?                           @db.Uuid
  organizationId                      String?                           @db.Uuid
  displayName                         String
  createdAt                           DateTime                          @default(now())
  updatedAt                           DateTime                          @updatedAt
  userAccount                         UserAccount?                      @relation(fields: [userAccountId], references: [id])
  person                              Person?                           @relation(fields: [personId], references: [id])
  organization                        Organization?                     @relation(fields: [organizationId], references: [id])
  credentials                         Credential[]
  authenticationMethods               AuthenticationMethod[]
  sessions                            Session[]
  memberships                         OrganizationMembership[]
  representativeAuthorities           RepresentativeAuthority[]
  officeholderLinks                   IdentityOfficeholderLink[]
  applications                        Application[]
  casesAsApplicant                    Case[]                            @relation("CaseApplicant")
  caseEventsAsActor                   CaseEvent[]                       @relation("CaseEventActor")
  communicationsAsSender              CaseCommunication[]               @relation("CommunicationSender")
  documentVersionsReceived            DocumentVersion[]                 @relation("DocumentVersionReceivedFrom")
  documentAssociations                DocumentAssociation[]             @relation("DocumentAssociationActor")
  documentAuditEvents                 DocumentAuditEvent[]              @relation("DocumentAuditActor")
  evidenceVerifications               EvidenceVerification[]            @relation("EvidenceVerificationVerifier")
  evidencePurposeAcceptances          EvidencePurposeAcceptance[]       @relation("EvidencePurposeAcceptanceReviewer")
  evidenceQualityAssessments          EvidenceQualityAssessment[]       @relation("EvidenceQualityAssessor")
  departmentalReviewsAsReviewer       DepartmentalReviewRecord[]        @relation("DepartmentalReviewReviewer")
  professionalReviews                 ProfessionalReviewRecord[]        @relation("ProfessionalReviewIdentity")
  inspectionInspectors                InspectionInspector[]             @relation("InspectionInspectorIdentity")
  custodyEventsAsCustodian            EvidenceCustodyEvent[]            @relation("EvidenceCustodyCustodian")
  custodyEventsAsWitness              EvidenceCustodyEvent[]            @relation("EvidenceCustodyWitness")
  recordCorrectionsRequested          RecordCorrection[]                @relation("RecordCorrectionRequester")
  recordCorrectionsApproved           RecordCorrection[]                @relation("RecordCorrectionApprover")
  recordIntegrityEvents               RecordIntegrityEvent[]            @relation("RecordIntegrityActor")
  recordAccessEvents                  RecordAccessEvent[]               @relation("RecordAccessIdentity")
  decisionReadinessProposed           DecisionReadinessAssessment[]     @relation("DecisionReadinessProposedMaker")
  decisionParticipants                DecisionParticipant[]             @relation("DecisionParticipantIdentity")
  decisionPreparationRecords          DecisionPreparationRecord[]       @relation("DecisionPreparationEditor")
  governmentDecisionsMade             GovernmentDecision[]              @relation("GovernmentDecisionMaker")
  officialInstrumentsAsHolder         OfficialInstrument[]              @relation("OfficialInstrumentHolderIdentity")
  issuanceEventsAsIssuer              IssuanceEvent[]                   @relation("IssuanceEventIssuerIdentity")
  approvedInstrumentTemplateVersions  InstrumentTemplateVersion[]       @relation("InstrumentTemplateApprover")
  instrumentDeliveriesAsRecipient     InstrumentDelivery[]              @relation("InstrumentDeliveryRecipient")
  instrumentReceiptsAsRecipient       InstrumentReceiptAcknowledgment[] @relation("InstrumentReceiptRecipient")
  instrumentDeliveryAuditsAsActor     InstrumentDeliveryAuditEvent[]    @relation("InstrumentDeliveryAuditActor")
  instrumentVerificationEventsAsActor InstrumentVerificationEvent[]     @relation("InstrumentVerificationEventActor")
  instrumentDownloadsAsActor          InstrumentDownloadEvent[]         @relation("InstrumentDownloadActor")
  instrumentLifecycleEventsAsActor    InstrumentLifecycleEvent[]        @relation("InstrumentLifecycleActor")
  reviewReferencesAsAppellant         DecisionReviewReference[]         @relation("ReviewAppellant")
  suspensionRecordsExecuted           InstrumentSuspensionRecord[]      @relation("SuspensionExecutor")
  complianceMattersAsHolder          ComplianceMatter[]            @relation("ComplianceMatterHolderIdentity")
  obligationStatusChanges            ObligationStatusHistory[]     @relation("ObligationStatusChangedBy")
  createdInspectionPlans             InspectionPlan[]              @relation("InspectionPlanCreator")
  approvedInspectionPlans            InspectionPlan[]              @relation("InspectionPlanApprover")
  inspectionAssignments              InspectionAssignment[]        @relation("InspectionAssignmentInspector")
  verifiedInspectorQualifications    InspectorQualificationSnapshot[] @relation("InspectorQualificationVerifier")
  recordedInspectionScheduleEvents   InspectionScheduleEvent[]     @relation("InspectionScheduleEventRecorder")
  complianceProjectionSubjects       ComplianceStatusProjection[]  @relation("ComplianceProjectionSubjectIdentity")
  complianceAlertReviews             ComplianceAlert[]             @relation("ComplianceAlertReviewer")
  complianceRevalidationRecords      ComplianceRevalidationRecord[] @relation("ComplianceRevalidationRecorder")
  complianceSubmissionsSubmitted     ComplianceSubmission[]        @relation("ComplianceSubmissionSubmitter")
  obligationEvidenceLinks            ObligationEvidenceLink[]      @relation("ObligationEvidenceLinker")
  complianceReviewsConducted         ComplianceReview[]            @relation("ComplianceReviewReviewer")

  @@index([userAccountId])
  @@index([personId])
  @@index([organizationId])
  @@index([type])
  @@map("identities")
}

model Credential {
  id           String           @id @default(uuid()) @db.Uuid
  identityId   String           @db.Uuid
  type         CredentialType
  status       CredentialStatus @default(PENDING)
  secretHash   String?
  oidcProvider String?
  oidcSubject  String?
  apiKeyHash   String?
  revokedAt    DateTime?
  lastUsedAt   DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  identity     Identity         @relation(fields: [identityId], references: [id])

  @@index([identityId])
  @@index([status])
  @@map("credentials")
}

model Organization {
  id                              String                            @id @default(uuid()) @db.Uuid
  code                            String                            @unique
  name                            String
  description                     String?
  status                          OrganizationStatus                @default(PENDING)
  createdAt                       DateTime                          @default(now())
  updatedAt                       DateTime                          @updatedAt
  identities                      Identity[]
  memberships                     OrganizationMembership[]
  representativeAuthorities       RepresentativeAuthority[]
  applications                    Application[]
  documentRecords                 DocumentRecord[]
  officialInstrumentsAsHolder     OfficialInstrument[]              @relation("OfficialInstrumentHolderOrganization")
  instrumentDeliveriesAsRecipient InstrumentDelivery[]              @relation("InstrumentDeliveryRecipientOrganization")
  instrumentReceiptsAsRecipient   InstrumentReceiptAcknowledgment[] @relation("InstrumentReceiptRecipientOrganization")
  complianceMattersAsHolder         ComplianceMatter[]                @relation("ComplianceMatterHolderOrganization")

  @@index([status])
  @@map("organizations")
}

model OrganizationMembership {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @db.Uuid
  identityId     String           @db.Uuid
  roleLabel      String?
  status         MembershipStatus @default(PENDING)
  effectiveFrom  DateTime         @default(now())
  effectiveUntil DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  organization   Organization     @relation(fields: [organizationId], references: [id])
  identity       Identity         @relation(fields: [identityId], references: [id])

  @@unique([organizationId, identityId])
  @@index([organizationId])
  @@index([identityId])
  @@map("organization_memberships")
}

model RepresentativeAuthority {
  id               String                        @id @default(uuid()) @db.Uuid
  organizationId   String                        @db.Uuid
  identityId       String                        @db.Uuid
  scopeDescription String
  status           RepresentativeAuthorityStatus @default(PENDING)
  effectiveFrom    DateTime
  effectiveUntil   DateTime?
  createdAt        DateTime                      @default(now())
  updatedAt        DateTime                      @updatedAt
  organization     Organization                  @relation(fields: [organizationId], references: [id])
  identity         Identity                      @relation(fields: [identityId], references: [id])
  applications          Application[]
  complianceSubmissions ComplianceSubmission[]

  @@index([organizationId])
  @@index([identityId])
  @@map("representative_authorities")
}

model AuthenticationMethod {
  id             String                   @id @default(uuid()) @db.Uuid
  identityId     String                   @db.Uuid
  type           AuthenticationMethodType
  isEnabled      Boolean                  @default(true)
  assuranceLevel AssuranceLevel           @default(NONE)
  oidcIssuer     String?
  oidcClientId   String?
  oidcAudience   String?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  identity       Identity                 @relation(fields: [identityId], references: [id])

  @@index([identityId])
  @@map("authentication_methods")
}

model Session {
  id               String                   @id @default(uuid()) @db.Uuid
  identityId       String                   @db.Uuid
  userAccountId    String?                  @db.Uuid
  tokenHash        String                   @unique
  status           SessionStatus            @default(ACTIVE)
  assuranceLevel   AssuranceLevel           @default(LOW)
  issuedAt         DateTime                 @default(now())
  expiresAt        DateTime
  lastUsedAt       DateTime?
  revokedAt        DateTime?
  revocationReason SessionRevocationReason?
  ipAddress        String?
  userAgent        String?
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  identity         Identity                 @relation(fields: [identityId], references: [id])
  userAccount      UserAccount?             @relation(fields: [userAccountId], references: [id])

  @@index([identityId])
  @@index([userAccountId])
  @@index([status])
  @@index([expiresAt])
  @@map("sessions")
}

model IdentityOfficeholderLink {
  id                 String                         @id @default(uuid()) @db.Uuid
  identityId         String                         @db.Uuid
  officeholderId     String                         @db.Uuid
  status             IdentityOfficeholderLinkStatus @default(PENDING)
  linkedAt           DateTime                       @default(now())
  linkedByIdentityId String?                        @db.Uuid
  revokedAt          DateTime?
  createdAt          DateTime                       @default(now())
  updatedAt          DateTime                       @updatedAt
  identity           Identity                       @relation(fields: [identityId], references: [id])
  officeholder       Officeholder                   @relation(fields: [officeholderId], references: [id])

  @@unique([identityId, officeholderId])
  @@index([identityId])
  @@index([officeholderId])
  @@map("identity_officeholder_links")
}

model SecurityAuditEvent {
  id              String                 @id @default(uuid()) @db.Uuid
  eventType       SecurityAuditEventType
  identityId      String?                @db.Uuid
  userAccountId   String?                @db.Uuid
  sessionId       String?                @db.Uuid
  actorIdentityId String?                @db.Uuid
  metadata        Json?
  ipAddress       String?
  createdAt       DateTime               @default(now())

  @@index([eventType])
  @@index([identityId])
  @@index([userAccountId])
  @@index([createdAt])
  @@map("security_audit_events")
}

// ─── Phase 4: Authority & Policy Engine ──────────────────────────────────────

enum AuthorityClassification {
  ABSEZ_OWNED
  ABSEZ_DELEGATED
  EXPRESSLY_RETAINED_NATIONAL
  SHARED_OR_COORDINATED
  RESERVED_PROFESSIONAL
  ADMINISTRATIVE_SUPPORT
  TECHNOLOGY_ASSISTED
  PROHIBITED_OR_UNAUTHORIZED
}

enum ControlledFunctionClass {
  LICENSING
  APPROVAL
  INSPECTION
  REGISTRATION
  ENFORCEMENT
  ADVISORY
  ADMINISTRATIVE
  INFORMATIONAL
  OTHER
}

enum FunctionAuthorityLifecycleStatus {
  DRAFT
  PENDING_ACTIVATION
  ACTIVE
  SUSPENDED
  INACTIVE
  ARCHIVED
}

enum AuthorityActionType {
  RETRIEVE
  SUMMARIZE
  PREPARE
  REVIEW
  VERIFY
  CHECK
  RECOMMEND
  CONCUR

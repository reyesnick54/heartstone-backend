generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum StructuralLifecycleStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  ARCHIVED
}

enum JurisdictionType {
  NATIONAL
  SUBNATIONAL
  MUNICIPAL
  SPECIAL_ECONOMIC_ZONE
  REGULATORY
  SUBJECT_MATTER
  OTHER
}

enum InstitutionType {
  GOVERNMENT
  MINISTRY
  AGENCY
  AUTHORITY
  REGULATOR
  STATUTORY_BODY
  SPECIAL_ECONOMIC_ZONE_AUTHORITY
  PUBLIC_BODY
  OTHER
}

enum GovernmentBodyType {
  GOVERNING
  SUPERVISORY
  ADVISORY
  ADMINISTRATIVE
  DECISION_MAKING
  OTHER
}

enum AppointmentStatus {
  PENDING
  ACTIVE
  SUSPENDED
  ENDED
  REVOKED
}

enum DelegationStatus {
  PENDING
  ACTIVE
  SUSPENDED
  REVOKED
  ENDED
}

enum ExternalAuthorityType {
  GOVERNMENT
  REGULATORY
  JUDICIAL
  PROFESSIONAL
  INSTITUTIONAL
  OTHER
}

model SystemMetadata {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("system_metadata")
}

model Jurisdiction {
  id           String                    @id @default(uuid()) @db.Uuid
  code         String                    @unique
  name         String
  description  String?
  type         JurisdictionType
  status       StructuralLifecycleStatus @default(ACTIVE)
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt
  institutions Institution[]

  @@map("jurisdictions")
}

model Institution {
  id                         String                         @id @default(uuid()) @db.Uuid
  jurisdictionId             String                         @db.Uuid
  code                       String
  name                       String
  description                String?
  type                       InstitutionType
  status                     StructuralLifecycleStatus      @default(ACTIVE)
  createdAt                  DateTime                       @default(now())
  updatedAt                  DateTime                       @updatedAt
  jurisdiction               Jurisdiction                   @relation(fields: [jurisdictionId], references: [id])
  governmentBodies           GovernmentBody[]
  departments                Department[]
  delegations                Delegation[]
  externalAuthorityRelations InstitutionExternalAuthority[]

  @@unique([jurisdictionId, code])
  @@index([jurisdictionId])
  @@map("institutions")
}

model GovernmentBody {
  id            String                    @id @default(uuid()) @db.Uuid
  institutionId String                    @db.Uuid
  code          String
  name          String
  description   String?
  type          GovernmentBodyType
  status        StructuralLifecycleStatus @default(ACTIVE)
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt
  institution   Institution               @relation(fields: [institutionId], references: [id])

  @@unique([institutionId, code])
  @@index([institutionId])
  @@map("government_bodies")
}

model Department {
  id            String                    @id @default(uuid()) @db.Uuid
  institutionId String                    @db.Uuid
  code          String
  name          String
  description   String?
  status        StructuralLifecycleStatus @default(ACTIVE)
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt
  institution   Institution               @relation(fields: [institutionId], references: [id])
  offices       Office[]

  @@unique([institutionId, code])
  @@index([institutionId])
  @@map("departments")
}

model Office {
  id                     String                    @id @default(uuid()) @db.Uuid
  departmentId           String                    @db.Uuid
  code                   String
  name                   String
  description            String?
  status                 StructuralLifecycleStatus @default(ACTIVE)
  createdAt              DateTime                  @default(now())
  updatedAt              DateTime                  @updatedAt
  department             Department                @relation(fields: [departmentId], references: [id])
  appointments           Appointment[]
  delegationsAsDelegator Delegation[]              @relation("DelegationDelegatorOffice")
  delegationsAsRecipient Delegation[]              @relation("DelegationRecipientOffice")

  @@unique([departmentId, code])
  @@index([departmentId])
  @@map("offices")
}

model Officeholder {
  id                     String                     @id @default(uuid()) @db.Uuid
  code                   String                     @unique
  name                   String
  description            String?
  status                 StructuralLifecycleStatus  @default(ACTIVE)
  createdAt              DateTime                   @default(now())
  updatedAt              DateTime                   @updatedAt
  appointments           Appointment[]
  delegationsAsDelegator Delegation[]               @relation("DelegationDelegatorOfficeholder")
  delegationsAsRecipient Delegation[]               @relation("DelegationRecipientOfficeholder")
  identityLinks          IdentityOfficeholderLink[]
  id                     String                    @id @default(uuid()) @db.Uuid
  code                   String                    @unique
  name                   String
  description            String?
  status                 StructuralLifecycleStatus @default(ACTIVE)
  createdAt              DateTime                  @default(now())
  updatedAt              DateTime                  @updatedAt
  appointments           Appointment[]
  delegationsAsDelegator Delegation[]              @relation("DelegationDelegatorOfficeholder")
  delegationsAsRecipient Delegation[]              @relation("DelegationRecipientOfficeholder")

  @@map("officeholders")
}

enum IdentityAccountStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum UserAccountKind {
  STANDARD
  IDENTITY_ADMINISTRATOR
}

enum CredentialType {
  PASSWORD
  API_KEY
  CLIENT_SECRET
}

enum CredentialStatus {
  ACTIVE
  REVOKED
}

enum AuthSessionStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

enum IdentityOfficeholderLinkStatus {
  PENDING
  VERIFIED
  SUSPENDED
  REVOKED
  ENDED
}

enum IdentityOfficeholderVerificationMethod {
  ADMIN_VERIFICATION
  DOCUMENT_EVIDENCE
  IN_PERSON_VERIFICATION
  OTHER
}

enum SecurityAuditEventType {
  ACCOUNT_CREATED
  ACCOUNT_SUSPENDED
  ACCOUNT_REACTIVATED
  IDENTITY_LINKED
  IDENTITY_VERIFICATION_CHANGED
  CREDENTIAL_CREATED
  CREDENTIAL_REVOKED
  SESSION_CREATED
  SESSION_REVOKED
  SERVICE_IDENTITY_AUTHENTICATED
  OFFICEHOLDER_LINKAGE_REQUESTED
  OFFICEHOLDER_LINKAGE_ACTIVATED
  OFFICEHOLDER_LINKAGE_SUSPENDED
  OFFICEHOLDER_LINKAGE_REVOKED
}

enum SecurityAuditResult {
  SUCCESS
  FAILURE
}

enum PrincipalKind {
  USER_ACCOUNT
  SERVICE_IDENTITY
  SYSTEM
}

model Person {
  id                String                     @id @default(uuid()) @db.Uuid
  displayName       String?
  status            IdentityAccountStatus      @default(ACTIVE)
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt
  userAccounts      UserAccount[]
  officeholderLinks IdentityOfficeholderLink[]

  @@map("persons")
}

model UserAccount {
  id                String                     @id @default(uuid()) @db.Uuid
  personId          String                     @db.Uuid
  username          String                     @unique
  kind              UserAccountKind            @default(STANDARD)
  status            IdentityAccountStatus      @default(ACTIVE)
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt
  person            Person                     @relation(fields: [personId], references: [id])
  credentials       Credential[]
  sessions          AuthSession[]
  externalLinks     ExternalIdentityLink[]
  officeholderLinks IdentityOfficeholderLink[]

  @@index([personId])
  @@map("user_accounts")
}

model ServiceIdentity {
  id          String                @id @default(uuid()) @db.Uuid
  code        String                @unique
  name        String
  status      IdentityAccountStatus @default(ACTIVE)
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  credentials Credential[]
  sessions    AuthSession[]

  @@map("service_identities")
}

model Credential {
  id                String           @id @default(uuid()) @db.Uuid
  userAccountId     String?          @db.Uuid
  serviceIdentityId String?          @db.Uuid
  type              CredentialType
  identifier        String
  secretHash        String?
  status            CredentialStatus @default(ACTIVE)
  revokedAt         DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  userAccount       UserAccount?     @relation(fields: [userAccountId], references: [id])
  serviceIdentity   ServiceIdentity? @relation(fields: [serviceIdentityId], references: [id])

  @@index([userAccountId])
  @@index([serviceIdentityId])
  @@map("credentials")
}

model AuthSession {
  id                String            @id @default(uuid()) @db.Uuid
  userAccountId     String?           @db.Uuid
  serviceIdentityId String?           @db.Uuid
  tokenHash         String            @unique
  status            AuthSessionStatus @default(ACTIVE)
  expiresAt         DateTime
  revokedAt         DateTime?
  correlationId     String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  userAccount       UserAccount?      @relation(fields: [userAccountId], references: [id])
  serviceIdentity   ServiceIdentity?  @relation(fields: [serviceIdentityId], references: [id])

  @@index([userAccountId])
  @@index([serviceIdentityId])
  @@map("auth_sessions")
}

model ExternalIdentityLink {
  id              String      @id @default(uuid()) @db.Uuid
  userAccountId   String      @db.Uuid
  providerKey     String
  externalSubject String
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  userAccount     UserAccount @relation(fields: [userAccountId], references: [id])

  @@unique([providerKey, externalSubject])
  @@index([userAccountId])
  @@map("external_identity_links")
}

model IdentityOfficeholderLink {
  id                 String                                  @id @default(uuid()) @db.Uuid
  personId           String                                  @db.Uuid
  userAccountId      String?                                 @db.Uuid
  officeholderId     String                                  @db.Uuid
  status             IdentityOfficeholderLinkStatus          @default(PENDING)
  verificationMethod IdentityOfficeholderVerificationMethod?
  evidenceReference  String?
  effectiveFrom      DateTime?
  effectiveUntil     DateTime?
  createdAt          DateTime                                @default(now())
  updatedAt          DateTime                                @updatedAt
  person             Person                                  @relation(fields: [personId], references: [id])
  userAccount        UserAccount?                            @relation(fields: [userAccountId], references: [id])
  officeholder       Officeholder                            @relation(fields: [officeholderId], references: [id])

  @@index([personId])
  @@index([userAccountId])
  @@index([officeholderId])
  @@map("identity_officeholder_links")
}

model SecurityAuditEvent {
  id            String                 @id @default(uuid()) @db.Uuid
  eventType     SecurityAuditEventType
  actorKind     PrincipalKind?
  actorId       String?                @db.Uuid
  subjectType   String?
  subjectId     String?                @db.Uuid
  correlationId String?
  source        String?
  result        SecurityAuditResult    @default(SUCCESS)
  reason        String?
  metadata      Json?
  createdAt     DateTime               @default(now())

  @@index([eventType])
  @@index([actorId])
  @@index([subjectId])
  @@index([correlationId])
  @@index([createdAt])
  @@map("security_audit_events")
}

model Appointment {
  id             String            @id @default(uuid()) @db.Uuid
  officeId       String            @db.Uuid
  officeholderId String            @db.Uuid
  status         AppointmentStatus @default(PENDING)
  effectiveFrom  DateTime
  effectiveUntil DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  office         Office            @relation(fields: [officeId], references: [id])
  officeholder   Officeholder      @relation(fields: [officeholderId], references: [id])

  @@index([officeId])
  @@index([officeholderId])
  @@map("appointments")
}

model Delegation {
  id                      String           @id @default(uuid()) @db.Uuid
  institutionId           String           @db.Uuid
  delegatorOfficeId       String?          @db.Uuid
  delegatorOfficeholderId String?          @db.Uuid
  recipientOfficeId       String?          @db.Uuid
  recipientOfficeholderId String?          @db.Uuid
  scopeDescription        String
  status                  DelegationStatus @default(PENDING)
  effectiveFrom           DateTime
  effectiveUntil          DateTime?
  createdAt               DateTime         @default(now())
  updatedAt               DateTime         @updatedAt
  institution             Institution      @relation(fields: [institutionId], references: [id])
  delegatorOffice         Office?          @relation("DelegationDelegatorOffice", fields: [delegatorOfficeId], references: [id])
  delegatorOfficeholder   Officeholder?    @relation("DelegationDelegatorOfficeholder", fields: [delegatorOfficeholderId], references: [id])
  recipientOffice         Office?          @relation("DelegationRecipientOffice", fields: [recipientOfficeId], references: [id])
  recipientOfficeholder   Officeholder?    @relation("DelegationRecipientOfficeholder", fields: [recipientOfficeholderId], references: [id])

  @@index([institutionId])
  @@map("delegations")
}

model ExternalAuthority {
  id                   String                         @id @default(uuid()) @db.Uuid
  code                 String                         @unique
  name                 String
  description          String?
  type                 ExternalAuthorityType
  status               StructuralLifecycleStatus      @default(ACTIVE)
  createdAt            DateTime                       @default(now())
  updatedAt            DateTime                       @updatedAt
  institutionRelations InstitutionExternalAuthority[]

  @@map("external_authorities")
}

model InstitutionExternalAuthority {
  id                  String                    @id @default(uuid()) @db.Uuid
  institutionId       String                    @db.Uuid
  externalAuthorityId String                    @db.Uuid
  relationshipLabel   String?
  status              StructuralLifecycleStatus @default(ACTIVE)
  effectiveFrom       DateTime?
  effectiveUntil      DateTime?
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt
  institution         Institution               @relation(fields: [institutionId], references: [id])
  externalAuthority   ExternalAuthority         @relation(fields: [externalAuthorityId], references: [id])

  @@unique([institutionId, externalAuthorityId])
  @@index([institutionId])
  @@index([externalAuthorityId])
  @@map("institution_external_authorities")
}

// ─── Phase 3: Identity & Access ─────────────────────────────────────────────

enum AccountStatus {
  PENDING
  ACTIVE
  SUSPENDED
  REVOKED
}

enum IdentityType {
  INDIVIDUAL
  ORGANIZATION
  SERVICE
}

enum CredentialType {
  PASSWORD
  OIDC
  API_KEY
  MFA_TOTP
// ---------------------------------------------------------------------------
// Phase 3A: Identity & Access — canonical identity primitives
// User != Officeholder != Role != Permission != Authority
// ---------------------------------------------------------------------------

enum PersonStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  ARCHIVED
}

enum UserAccountStatus {
  PENDING
  ACTIVE
  SUSPENDED
  LOCKED
  DEACTIVATED
}

enum IdentityVerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
  EXPIRED
}

enum CredentialType {
  PASSWORD_HASH
  API_KEY_REFERENCE
  CERTIFICATE_REFERENCE
  OTHER
}

enum CredentialStatus {
  PENDING
  ACTIVE
  REVOKED
}

enum AuthenticationMethodType {
  PASSWORD
  OIDC
  SERVICE_API_KEY
  MFA_TOTP
}

enum AssuranceLevel {
  NONE
  LOW
  MEDIUM
  HIGH
}

enum OrganizationStatus {
  PENDING
  ACTIVE
  SUSPENDED
  REVOKED
}

enum MembershipStatus {
  PENDING
  ACTIVE
  SUSPENDED
  REVOKED
  SUSPENDED
  REVOKED
  EXPIRED
}

enum OrganizationType {
  COMPANY
  APPLICANT_ORGANIZATION
  INVESTOR_ENTITY
  IMPLEMENTATION_PARTNER
  OTHER
}

enum OrganizationStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  ARCHIVED
}

enum OrganizationMembershipStatus {
  PENDING
  ACTIVE
  SUSPENDED
  ENDED
}

enum OrganizationMembershipRole {
  MEMBER
  ADMINISTRATOR
  CONTACT
  OTHER
}

enum RepresentativeAuthorityStatus {
  PENDING
  ACTIVE
  SUSPENDED
  REVOKED
  ENDED
}

enum SessionStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

enum SessionRevocationReason {
  USER_LOGOUT
  ADMIN_REVOCATION
  ACCOUNT_REVOCATION
  SECURITY_EVENT
  REPLACED
  EXPIRED
}

enum IdentityOfficeholderLinkStatus {
  PENDING
  ACTIVE
  REVOKED
}

enum SecurityAuditEventType {
  PERSON_CREATED
  USER_ACCOUNT_CREATED
  USER_ACCOUNT_SUSPENDED
  IDENTITY_CREATED
  IDENTITY_ATTACHED
  CREDENTIAL_CREATED
  CREDENTIAL_REVOKED
  AUTHENTICATION_METHOD_CONFIGURED
  AUTHENTICATION_SUCCESS
  AUTHENTICATION_FAILURE
  SESSION_CREATED
  SESSION_REVOKED
  SESSION_REJECTED
  SESSION_EXPIRED
  CREDENTIAL_REJECTED
  SUSPENDED_ACCOUNT_LOGIN_ATTEMPT
  REVOKED_ACCOUNT_LOGIN_ATTEMPT
  ORGANIZATION_CREATED
  MEMBERSHIP_CREATED
  REPRESENTATIVE_AUTHORITY_CREATED
  OFFICEHOLDER_LINK_CREATED
  OFFICEHOLDER_LINK_REVOKED
  OIDC_CLAIM_RECEIVED
  MFA_VERIFIED
  SERVICE_IDENTITY_AUTHENTICATED
  PROTECTED_ENDPOINT_ACCESS
}

model Person {
  id          String       @id @default(uuid()) @db.Uuid
  givenName   String
  familyName  String
  displayName String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  userAccount UserAccount?
  identities  Identity[]
enum AuthenticationMethodType {
  PASSWORD
  OIDC
  SAML
  MFA_TOTP
  MFA_SMS
  API_KEY
  OTHER
}

enum AuthenticationMethodStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum SessionStatus {
  ACTIVE
  EXPIRED
  REVOKED
}

model Person {
  id                        String                    @id @default(uuid()) @db.Uuid
  displayName               String
  status                    PersonStatus              @default(ACTIVE)
  createdAt                 DateTime                  @default(now())
  updatedAt                 DateTime                  @updatedAt
  userAccounts              UserAccount[]
  organizationMemberships   OrganizationMembership[]
  representativeAuthorities RepresentativeAuthority[]

  @@map("persons")
}

model UserAccount {
  id              String        @id @default(uuid()) @db.Uuid
  personId        String?       @unique @db.Uuid
  loginIdentifier String        @unique
  status          AccountStatus @default(PENDING)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  person          Person?       @relation(fields: [personId], references: [id])
  identities      Identity[]
  sessions        Session[]

  @@index([status])
  id                        String                    @id @default(uuid()) @db.Uuid
  personId                  String                    @db.Uuid
  username                  String                    @unique
  status                    UserAccountStatus         @default(PENDING)
  createdAt                 DateTime                  @default(now())
  updatedAt                 DateTime                  @updatedAt
  person                    Person                    @relation(fields: [personId], references: [id])
  identities                Identity[]
  credentials               Credential[]
  organizationMemberships   OrganizationMembership[]
  representativeAuthorities RepresentativeAuthority[]
  authenticationMethods     AuthenticationMethod[]
  sessions                  Session[]

  @@index([personId])
  @@map("user_accounts")
}

model Identity {
  id                        String                     @id @default(uuid()) @db.Uuid
  type                      IdentityType
  userAccountId             String?                    @db.Uuid
  personId                  String?                    @db.Uuid
  organizationId            String?                    @db.Uuid
  displayName               String
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt
  userAccount               UserAccount?               @relation(fields: [userAccountId], references: [id])
  person                    Person?                    @relation(fields: [personId], references: [id])
  organization              Organization?              @relation(fields: [organizationId], references: [id])
  credentials               Credential[]
  authenticationMethods     AuthenticationMethod[]
  sessions                  Session[]
  memberships               OrganizationMembership[]
  representativeAuthorities RepresentativeAuthority[]
  officeholderLinks         IdentityOfficeholderLink[]

  @@index([userAccountId])
  @@index([personId])
  @@index([organizationId])
  @@index([type])
  id                 String                     @id @default(uuid()) @db.Uuid
  userAccountId      String                     @db.Uuid
  providerCode       String
  subjectId          String
  verificationStatus IdentityVerificationStatus @default(UNVERIFIED)
  verifiedAt         DateTime?
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt
  userAccount        UserAccount                @relation(fields: [userAccountId], references: [id])

  @@unique([providerCode, subjectId])
  @@index([userAccountId])
  @@map("identities")
}

model Credential {
  id           String           @id @default(uuid()) @db.Uuid
  identityId   String           @db.Uuid
  type         CredentialType
  status       CredentialStatus @default(PENDING)
  secretHash   String?
  oidcProvider String?
  oidcSubject  String?
  apiKeyHash   String?
  revokedAt    DateTime?
  lastUsedAt   DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  identity     Identity         @relation(fields: [identityId], references: [id])

  @@index([identityId])
  id                    String           @id @default(uuid()) @db.Uuid
  userAccountId         String           @db.Uuid
  type                  CredentialType
  credentialFingerprint String?
  secretReference       String?
  status                CredentialStatus @default(PENDING)
  expiresAt             DateTime?
  revokedAt             DateTime?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  userAccount           UserAccount      @relation(fields: [userAccountId], references: [id])

  @@index([userAccountId])
  @@index([status])
  @@map("credentials")
}

model Organization {
  id                        String                    @id @default(uuid()) @db.Uuid
  code                      String                    @unique
  name                      String
  description               String?
  status                    OrganizationStatus        @default(PENDING)
  createdAt                 DateTime                  @default(now())
  updatedAt                 DateTime                  @updatedAt
  identities                Identity[]
  memberships               OrganizationMembership[]
  representativeAuthorities RepresentativeAuthority[]

  @@index([status])
  type                      OrganizationType
  status                    OrganizationStatus        @default(ACTIVE)
  createdAt                 DateTime                  @default(now())
  updatedAt                 DateTime                  @updatedAt
  memberships               OrganizationMembership[]
  representativeAuthorities RepresentativeAuthority[]

  @@map("organizations")
}

model OrganizationMembership {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @db.Uuid
  identityId     String           @db.Uuid
  roleLabel      String?
  status         MembershipStatus @default(PENDING)
  effectiveFrom  DateTime         @default(now())
  effectiveUntil DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  organization   Organization     @relation(fields: [organizationId], references: [id])
  identity       Identity         @relation(fields: [identityId], references: [id])

  @@unique([organizationId, identityId])
  @@index([organizationId])
  @@index([identityId])
  id             String                       @id @default(uuid()) @db.Uuid
  organizationId String                       @db.Uuid
  personId       String                       @db.Uuid
  userAccountId  String?                      @db.Uuid
  role           OrganizationMembershipRole   @default(MEMBER)
  status         OrganizationMembershipStatus @default(PENDING)
  effectiveFrom  DateTime?
  effectiveUntil DateTime?
  createdAt      DateTime                     @default(now())
  updatedAt      DateTime                     @updatedAt
  organization   Organization                 @relation(fields: [organizationId], references: [id])
  person         Person                       @relation(fields: [personId], references: [id])
  userAccount    UserAccount?                 @relation(fields: [userAccountId], references: [id])

  @@unique([organizationId, personId])
  @@index([organizationId])
  @@index([personId])
  @@index([userAccountId])
  @@map("organization_memberships")
}

model RepresentativeAuthority {
  id               String                        @id @default(uuid()) @db.Uuid
  organizationId   String                        @db.Uuid
  identityId       String                        @db.Uuid
  scopeDescription String
  personId         String?                       @db.Uuid
  userAccountId    String?                       @db.Uuid
  mandateReference String
  scopeDescription String?
  status           RepresentativeAuthorityStatus @default(PENDING)
  effectiveFrom    DateTime
  effectiveUntil   DateTime?
  createdAt        DateTime                      @default(now())
  updatedAt        DateTime                      @updatedAt
  organization     Organization                  @relation(fields: [organizationId], references: [id])
  identity         Identity                      @relation(fields: [identityId], references: [id])

  @@index([organizationId])
  @@index([identityId])
  person           Person?                       @relation(fields: [personId], references: [id])
  userAccount      UserAccount?                  @relation(fields: [userAccountId], references: [id])

  @@index([organizationId])
  @@index([personId])
  @@index([userAccountId])
  @@map("representative_authorities")
}

model AuthenticationMethod {
  id             String                   @id @default(uuid()) @db.Uuid
  identityId     String                   @db.Uuid
  type           AuthenticationMethodType
  isEnabled      Boolean                  @default(true)
  assuranceLevel AssuranceLevel           @default(NONE)
  oidcIssuer     String?
  oidcClientId   String?
  oidcAudience   String?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  identity       Identity                 @relation(fields: [identityId], references: [id])

  @@index([identityId])
  id            String                     @id @default(uuid()) @db.Uuid
  userAccountId String                     @db.Uuid
  type          AuthenticationMethodType
  providerCode  String?
  status        AuthenticationMethodStatus @default(ACTIVE)
  createdAt     DateTime                   @default(now())
  updatedAt     DateTime                   @updatedAt
  userAccount   UserAccount                @relation(fields: [userAccountId], references: [id])

  @@index([userAccountId])
  @@map("authentication_methods")
}

model Session {
  id               String                   @id @default(uuid()) @db.Uuid
  identityId       String                   @db.Uuid
  userAccountId    String?                  @db.Uuid
  tokenHash        String                   @unique
  status           SessionStatus            @default(ACTIVE)
  assuranceLevel   AssuranceLevel           @default(LOW)
  issuedAt         DateTime                 @default(now())
  expiresAt        DateTime
  lastUsedAt       DateTime?
  revokedAt        DateTime?
  revocationReason SessionRevocationReason?
  ipAddress        String?
  userAgent        String?
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  identity         Identity                 @relation(fields: [identityId], references: [id])
  userAccount      UserAccount?             @relation(fields: [userAccountId], references: [id])

  @@index([identityId])
  id             String        @id @default(uuid()) @db.Uuid
  userAccountId  String        @db.Uuid
  status         SessionStatus @default(ACTIVE)
  expiresAt      DateTime
  revokedAt      DateTime?
  lastActivityAt DateTime?
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  userAccount    UserAccount   @relation(fields: [userAccountId], references: [id])

  @@index([userAccountId])
  @@index([status])
  @@index([expiresAt])
  @@map("sessions")
}

model IdentityOfficeholderLink {
  id                 String                         @id @default(uuid()) @db.Uuid
  identityId         String                         @db.Uuid
  officeholderId     String                         @db.Uuid
  status             IdentityOfficeholderLinkStatus @default(PENDING)
  linkedAt           DateTime                       @default(now())
  linkedByIdentityId String?                        @db.Uuid
  revokedAt          DateTime?
  createdAt          DateTime                       @default(now())
  updatedAt          DateTime                       @updatedAt
  identity           Identity                       @relation(fields: [identityId], references: [id])
  officeholder       Officeholder                   @relation(fields: [officeholderId], references: [id])

  @@unique([identityId, officeholderId])
  @@index([identityId])
  @@index([officeholderId])
  @@map("identity_officeholder_links")
}

model SecurityAuditEvent {
  id              String                 @id @default(uuid()) @db.Uuid
  eventType       SecurityAuditEventType
  identityId      String?                @db.Uuid
  userAccountId   String?                @db.Uuid
  sessionId       String?                @db.Uuid
  actorIdentityId String?                @db.Uuid
  metadata        Json?
  ipAddress       String?
  createdAt       DateTime               @default(now())

  @@index([eventType])
  @@index([identityId])
  @@index([userAccountId])
  @@index([createdAt])
  @@map("security_audit_events")
}

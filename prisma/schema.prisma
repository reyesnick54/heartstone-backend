generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RecordStatus {
  ACTIVE
  INACTIVE
  HISTORICAL
}

enum ExternalAuthorityType {
  GOVERNMENT_AUTHORITY
  REGULATOR
  JUDICIAL_BODY
  PROFESSIONAL_BODY
  PUBLIC_REGISTRY
  INTERNATIONAL_BODY
  OTHER
}

enum InstitutionExternalAuthorityRelationshipType {
  COORDINATION
  REFERRAL
  CONSULTATION
  VERIFICATION
  SUPERVISION
  REGULATORY
  DEPENDENCY
  OTHER
}

model SystemMetadata {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("system_metadata")
}

model Institution {
  id        String       @id @default(cuid())
  code      String       @unique
  name      String
  status    RecordStatus @default(ACTIVE)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  externalAuthorityRelationships InstitutionExternalAuthority[]

  @@map("institutions")
}

model ExternalAuthority {
  id                      String                @id @default(cuid())
  code                    String                @unique
  name                    String
  description             String?
  type                    ExternalAuthorityType
  jurisdictionDescription String?
  status                  RecordStatus          @default(ACTIVE)
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt

  institutionRelationships InstitutionExternalAuthority[]

  @@map("external_authorities")
}

model InstitutionExternalAuthority {
  id                 String                                     @id @default(cuid())
  institutionId      String
  externalAuthorityId String
  relationshipType   InstitutionExternalAuthorityRelationshipType
  description        String?
  status             RecordStatus                               @default(ACTIVE)
  createdAt          DateTime                                   @default(now())
  updatedAt          DateTime                                   @updatedAt

  institution       Institution       @relation(fields: [institutionId], references: [id])
  externalAuthority ExternalAuthority @relation(fields: [externalAuthorityId], references: [id])

  @@index([institutionId])
  @@index([externalAuthorityId])
  @@map("institution_external_authorities")
}

model DecisionCondition {
  id                    String                  @id @default(uuid()) @db.Uuid
  governmentDecisionId  String                  @db.Uuid
  conditionType         DecisionConditionType
  status                DecisionConditionStatus @default(PENDING)
  description           String
  satisfiedAt           DateTime?
  waivedAt              DateTime?
  failedAt              DateTime?
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  governmentDecision    GovernmentDecision      @relation(fields: [governmentDecisionId], references: [id], onDelete: Cascade)
  continuingObligations ContinuingObligation[]

  @@index([governmentDecisionId])
  @@index([conditionType, status])
  @@map("decision_conditions")
}

model InstrumentTypeDefinition {
  id              String                  @id @default(uuid()) @db.Uuid
  code            String                  @unique
  name            String
  kind            OfficialInstrumentKind
  description     String?
  lifecycleStatus CatalogLifecycleStatus  @default(DRAFT)
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  versions        InstrumentTypeVersion[]

  @@map("instrument_type_definitions")
}

model InstrumentTypeVersion {
  id                                String                               @id @default(uuid()) @db.Uuid
  instrumentTypeDefinitionId        String                               @db.Uuid
  versionNumber                     Int
  lifecycleStatus                   CatalogLifecycleStatus               @default(DRAFT)
  issuingInstitutionId              String                               @db.Uuid
  issuanceFunctionAuthorityRecordId String                               @db.Uuid
  requiredAuthorityAction           AuthorityActionType                  @default(ISSUE)
  requiredTemplateVersionId         String?                              @db.Uuid
  signatureRequired                 Boolean                              @default(false)
  sealRequired                      Boolean                              @default(false)
  numberingRuleId                   String                               @db.Uuid
  effectiveDateRule                 Json
  durationExpiryRule                Json?
  verificationMethod                String
  publicationStatus                 String
  deliveryRequirements              Json                                 @default("[]")
  correctionProcedure               Json?
  amendmentProcedure                Json?
  renewalProcedure                  Json?
  suspensionProcedure               Json?
  revocationProcedure               Json?
  redressRoute                      Json?
  recordsClassification             String
  retainedNationalBoundary          Boolean                              @default(false)
  publicVerificationMode            InstrumentTypePublicVerificationMode @default(NOT_PERMITTED)
  holderDisplayPermitted            Boolean                              @default(false)
  scopeSummaryPublic                Boolean                              @default(false)
  restrictedClassification          Boolean                              @default(false)
  permittedDeliveryChannels         InstrumentDeliveryChannel[]
  legalEffectRequiresDelivery       Boolean                              @default(false)
  createdAt                         DateTime                             @default(now())
  updatedAt                         DateTime                             @updatedAt
  instrumentTypeDefinition          InstrumentTypeDefinition             @relation(fields: [instrumentTypeDefinitionId], references: [id])
  issuingInstitution                Institution                          @relation("InstrumentIssuingInstitution", fields: [issuingInstitutionId], references: [id])
  issuanceFunctionAuthorityRecord   FunctionAuthorityRecord              @relation("InstrumentIssuanceFunctionAuthority", fields: [issuanceFunctionAuthorityRecordId], references: [id])
  requiredTemplateVersion           InstrumentTemplateVersion?           @relation("InstrumentTypeRequiredTemplate", fields: [requiredTemplateVersionId], references: [id])
  numberingRule                     InstrumentNumberingRule              @relation(fields: [numberingRuleId], references: [id])
  eligibleDecisionTypes             InstrumentTypeEligibleDecisionType[]
  templates                         InstrumentTemplate[]
  officialInstruments               OfficialInstrument[]
  issuanceReadinessAssessments      IssuanceReadinessAssessment[]

  @@unique([instrumentTypeDefinitionId, versionNumber])
  @@index([instrumentTypeDefinitionId])
  @@index([issuingInstitutionId])
  @@index([numberingRuleId])
  @@map("instrument_type_versions")
}

model InstrumentTypeEligibleDecisionType {
  id                      String                @id @default(uuid()) @db.Uuid
  instrumentTypeVersionId String                @db.Uuid
  decisionTypeVersionId   String                @db.Uuid
  createdAt               DateTime              @default(now())
  instrumentTypeVersion   InstrumentTypeVersion @relation(fields: [instrumentTypeVersionId], references: [id], onDelete: Cascade)
  decisionTypeVersion     DecisionTypeVersion   @relation(fields: [decisionTypeVersionId], references: [id], onDelete: Cascade)

  @@unique([instrumentTypeVersionId, decisionTypeVersionId])
  @@index([decisionTypeVersionId])
  @@map("instrument_type_eligible_decision_types")
}

model InstrumentTemplate {
  id                      String                      @id @default(uuid()) @db.Uuid
  code                    String                      @unique
  name                    String
  instrumentTypeVersionId String                      @db.Uuid
  lifecycleStatus         CatalogLifecycleStatus      @default(DRAFT)
  createdAt               DateTime                    @default(now())
  updatedAt               DateTime                    @updatedAt
  instrumentTypeVersion   InstrumentTypeVersion       @relation(fields: [instrumentTypeVersionId], references: [id])
  versions                InstrumentTemplateVersion[]

  @@index([instrumentTypeVersionId])
  @@map("instrument_templates")
}

model InstrumentTemplateVersion {
  id                         String                      @id @default(uuid()) @db.Uuid
  instrumentTemplateId       String                      @db.Uuid
  versionNumber              Int
  lifecycleStatus            CatalogLifecycleStatus      @default(DRAFT)

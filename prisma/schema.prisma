  deliveryAuditEvents               InstrumentDeliveryAuditEvent[]
  downloadEvents                    InstrumentDownloadEvent[]
  lifecycleEvents                   InstrumentLifecycleEvent[]
  amendmentRecords                  InstrumentAmendmentRecord[]
  renewalRecords                    InstrumentRenewalRecord[]
  suspensionRecords                 InstrumentSuspensionRecord[]
  revocationRecords                 InstrumentRevocationRecord[]
  reinstatementRecords              InstrumentReinstatementRecord[]
  replacementRecords                InstrumentReplacementRecord[]
  surrenderRecords                  InstrumentSurrenderRecord[]
  challengedInReviews               DecisionReviewReference[]
  redressMattersChallenged          RedressMatter[]                   @relation("RedressChallengedInstrument")
  externalReviewReferralsChallenged ExternalReviewReferral[]          @relation("ExternalReviewChallengedInstrument")

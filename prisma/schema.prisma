  currentDriverLicenseRecord    DriverLicenseRecord?        @relation("DriverProfileCurrentLicense", fields: [currentDriverLicenseRecordId], references: [id])
  registryEntry                 TransportationRegistryEntry?
  driverLicenseApplicationProfiles DriverLicenseApplicationProfile[]
  driverLicenseRecords          DriverLicenseRecord[]       @relation("DriverProfileLicenses")

  verifiedAt         DateTime                    @default(now())
  createdAt          DateTime                    @default(now())
  alert              IntelligenceMonitoringAlert @relation(fields: [alertId], references: [id], onDelete: Cascade)
  verifier           Identity                    @relation("IntelligenceAlertVerifier", fields: [verifierIdentityId], references: [id])

  @@index([alertId])
  @@map("intelligence_alert_verifications")
}

model IntelligenceAlertDisposition {
  id                   String                      @id @default(uuid()) @db.Uuid
  alertId              String                      @db.Uuid
  dispositionStatus    IntelligenceAlertStatus
  disposedByIdentityId String                      @db.Uuid
  dispositionNotes     String?
  disposedAt           DateTime                    @default(now())
  createdAt            DateTime                    @default(now())
  alert                IntelligenceMonitoringAlert @relation(fields: [alertId], references: [id], onDelete: Cascade)
  disposedBy           Identity                    @relation("IntelligenceAlertDisposer", fields: [disposedByIdentityId], references: [id])


// ─── Service Pack Deployment Lifecycle ───────────────────────────────────────

enum ServicePackExportRestriction {
  TEMPLATE_PORTABLE
  INSTITUTION_RESTRICTED
}

enum ServicePackJurisdictionBindingKind {
  OPERATIONAL
  TEMPLATE
}

enum ServicePackVersionStatus {
  COMPILED
  ACCEPTED
}

enum ServicePackDeploymentStatus {
  DEPLOYMENT_READY
  DEPLOYED
  OPERATIONALLY_INACTIVE
  ACTIVE
  SUSPENDED
  ROLLED_BACK
  SUPERSEDED
}

enum ServicePackDeploymentBindingDomain {
  SERVICE_CATALOG
  FORMS
  WORKFLOWS
  SERVICE_AUTHORITY_MAPPINGS
  FEE_METADATA
  EVIDENCE_REQUIREMENTS
  OUTPUT_METADATA
  REDRESS_ROUTES
  COMMUNICATION_CONFIGURATION
  INTEGRATION_REFERENCES
  DASHBOARD_CONFIGURATION
}

enum ServicePackDeploymentAuditEventType {
  VERSION_ACCEPTED
  DEPLOYMENT_READY
  DEPLOYED
  ACTIVATION_REQUESTED
  ACTIVATION_BLOCKED
  ACTIVATED
  SUSPENDED
  ROLLBACK_INITIATED
  ROLLBACK_COMPLETED
  SUPERSEDED
  FINGERPRINT_RECORDED
}

model ServicePack {
  id                          String                       @id @default(uuid()) @db.Uuid
  code                        String                       @unique
  name                        String
  description                 String?
  institutionId               String                       @db.Uuid
  jurisdictionId              String?                      @db.Uuid
  departmentCode              String?
  exportRestriction           ServicePackExportRestriction @default(INSTITUTION_RESTRICTED)
  responsibleOwnerIdentityId  String?                      @db.Uuid
  templateSourceServicePackId String?                      @db.Uuid
  createdAt                   DateTime                     @default(now())
  updatedAt                   DateTime                     @updatedAt
  institution                 Institution                  @relation(fields: [institutionId], references: [id])
  jurisdiction                Jurisdiction?                @relation("ServicePackJurisdiction", fields: [jurisdictionId], references: [id])
  responsibleOwner            Identity?                    @relation("ServicePackResponsibleOwner", fields: [responsibleOwnerIdentityId], references: [id])
  templateSource              ServicePack?                 @relation("ServicePackTemplateLineage", fields: [templateSourceServicePackId], references: [id])
  templateClones              ServicePack[]                @relation("ServicePackTemplateLineage")
  versions                    ServicePackVersion[]
  imports                     ServicePackImport[]
  jurisdictionBindings        ServicePackJurisdictionBinding[]
  reviews                     ServicePackReview[]
  reviewChainPolicies         ServicePackReviewChainPolicy[]
  acceptanceRecords           ServicePackAcceptanceRecord[]
  rejectionRecords            ServicePackRejectionRecord[]
  revisionRequests            ServicePackRevisionRequest[]
  governanceAuditRecords      ServicePackGovernanceAuditRecord[]

  @@index([institutionId])
  @@index([jurisdictionId])
  @@index([responsibleOwnerIdentityId])
  @@index([templateSourceServicePackId])
  @@map("service_packs")
}

model ServicePackJurisdictionBinding {
  id                                    String                           @id @default(uuid()) @db.Uuid
  servicePackId                         String                           @db.Uuid
  jurisdictionId                        String                           @db.Uuid
  bindingKind                           ServicePackJurisdictionBindingKind @default(OPERATIONAL)
  authorityMappingsRevalidationRequired Boolean                          @default(true)
  governingSourcesRevalidationRequired  Boolean                          @default(true)
  institutionsRevalidationRequired      Boolean                          @default(true)
  feesRevalidationRequired              Boolean                          @default(true)
  eligibilityRevalidationRequired       Boolean                          @default(true)
  integrationsRevalidationRequired      Boolean                          @default(true)
  createdAt                             DateTime                         @default(now())
  updatedAt                             DateTime                         @updatedAt
  servicePack                           ServicePack                      @relation(fields: [servicePackId], references: [id], onDelete: Cascade)
  jurisdiction                          Jurisdiction                     @relation(fields: [jurisdictionId], references: [id])

  @@unique([servicePackId, jurisdictionId])
  @@index([jurisdictionId])
  @@map("service_pack_jurisdiction_bindings")
}

model ServicePackVersion {
  id                       String                            @id @default(uuid()) @db.Uuid
  servicePackId            String                            @db.Uuid
  version                  String
  status                   ServicePackVersionStatus          @default(COMPILED)
  manifestVersion          String                            @default("heartstone.service-pack/v1")
  manifestValidationStatus ServicePackManifestValidationStatus @default(DRAFT)
  governanceLifecycleStatus ServicePackGovernanceLifecycleStatus @default(NOT_IN_GOVERNANCE)
  compilationFingerprint   String
  manifestChecksum         String?
  manifest                 Json
  immutable                Boolean                           @default(false)
  compiledAt               DateTime                          @default(now())
  acceptedAt               DateTime?
  acceptedByIdentityId     String?                           @db.Uuid
  createdAt                DateTime                          @default(now())
  updatedAt                DateTime                          @updatedAt
  servicePack              ServicePack                       @relation(fields: [servicePackId], references: [id])
  acceptedBy               Identity?                         @relation("ServicePackVersionAccepter", fields: [acceptedByIdentityId], references: [id])
  deployments              ServicePackDeployment[]
  components               ServicePackComponent[]
  dependencies             ServicePackDependency[]
  validationResults        ServicePackValidationResult[]
  imports                  ServicePackImport[]
  reviews                  ServicePackReview[]
  acceptanceRecords        ServicePackAcceptanceRecord[]
  rejectionRecords         ServicePackRejectionRecord[]
  revisionRequests         ServicePackRevisionRequest[]
  governanceAuditRecords   ServicePackGovernanceAuditRecord[]
  governingVitalEvents     VitalEvent[]                    @relation("VitalEventGoverningServicePack")

  @@unique([servicePackId, version])
  @@index([servicePackId])
  @@index([status])
  @@index([manifestValidationStatus])
  @@index([governanceLifecycleStatus])
  @@index([manifestChecksum])
  @@map("service_pack_versions")
}

model ServicePackDeployment {
  id                       String                      @id @default(uuid()) @db.Uuid
  servicePackVersionId     String                      @db.Uuid
  deploymentReference      String                      @unique
  status                   ServicePackDeploymentStatus @default(DEPLOYMENT_READY)
  configurationFingerprint String?
  deployedAt               DateTime?
  rolledBackAt             DateTime?
  supersededByDeploymentId String?                     @db.Uuid
  actorIdentityId          String                      @db.Uuid
  reason                   String?
  createdAt                DateTime                    @default(now())
  updatedAt                DateTime                    @updatedAt
  servicePackVersion       ServicePackVersion          @relation(fields: [servicePackVersionId], references: [id])
  supersededByDeployment   ServicePackDeployment?      @relation("ServicePackDeploymentSupersession", fields: [supersededByDeploymentId], references: [id])
  supersededDeployments    ServicePackDeployment[]     @relation("ServicePackDeploymentSupersession")
  bindings                 ServicePackDeploymentBinding[]
  auditRecords             ServicePackDeploymentAuditRecord[]

  @@index([servicePackVersionId])
  @@index([status])
  @@index([actorIdentityId])
  @@map("service_pack_deployments")
}

model ServicePackDeploymentBinding {
  id                      String                           @id @default(uuid()) @db.Uuid
  servicePackDeploymentId String                           @db.Uuid
  domain                  ServicePackDeploymentBindingDomain
  domainEntityId          String                           @db.Uuid
  domainEntityVersion     String?
  bindingSnapshot         Json                             @default("{}")
  isReversible            Boolean                          @default(true)
  isActivated             Boolean                          @default(false)
  createdAt               DateTime                         @default(now())
  servicePackDeployment   ServicePackDeployment            @relation(fields: [servicePackDeploymentId], references: [id], onDelete: Cascade)

  @@unique([servicePackDeploymentId, domain, domainEntityId])
  @@index([servicePackDeploymentId])
  @@index([domainEntityId])
  @@map("service_pack_deployment_bindings")
}

model ServicePackDeploymentAuditRecord {
  id                      String                            @id @default(uuid()) @db.Uuid
  servicePackDeploymentId String                            @db.Uuid
  eventType               ServicePackDeploymentAuditEventType
  priorStatus             ServicePackDeploymentStatus?
  newStatus               ServicePackDeploymentStatus?
  actorIdentityId         String                            @db.Uuid
  reason                  String?
  metadata                Json                              @default("{}")
  createdAt               DateTime                          @default(now())
  servicePackDeployment   ServicePackDeployment             @relation(fields: [servicePackDeploymentId], references: [id], onDelete: Cascade)

  @@index([servicePackDeploymentId])
  @@index([eventType])
  @@index([createdAt])
  @@map("service_pack_deployment_audit_records")
}

// ─── Service Pack Manifest Validation (additive to deployment lifecycle) ─────

enum ServicePackManifestValidationStatus {
  DRAFT
  DRAFT_IMPORTED
  VALIDATING
  INVALID
  VALIDATED
  PENDING_REVIEW
}

enum ServicePackComponentKind {
  JURISDICTION
  INSTITUTION
  DEPARTMENT
  SERVICE
  AUTHORITY_MAPPING
  FORM
  EVIDENCE_REQUIREMENT
  WORKFLOW
  FEE
  OUTPUT
  SLA_RULE
  COMMUNICATION
  INTEGRATION
  RENEWAL
  COMPLIANCE
  REDRESS
  DASHBOARD_DEFINITION
}

enum ServicePackDependencyKind {
  DEPARTMENT
  EXTERNAL_AUTHORITY
  EXTERNAL_REGISTRY
  PAYMENT_PROVIDER
  IDENTITY_PROVIDER
  INTEGRATION
  PROFESSIONAL
}

enum ServicePackDependencyControlScope {
  HEARTSTONE_CONTROLLED
  EXTERNAL
}

enum ServicePackValidationOutcome {
  PASSED
  FAILED
}

enum ServicePackImportStatus {
  RECEIVED
  DRAFT_IMPORTED
  VALIDATING
  VALIDATED
  REJECTED
}

model ServicePackComponent {
  id                   String                   @id @default(uuid()) @db.Uuid
  servicePackVersionId String                   @db.Uuid
  componentKind        ServicePackComponentKind
  componentCode        String
  manifestPath         String
  targetDomain         String?
  targetReferenceId    String?                  @db.Uuid
  configuration        Json                     @default("{}")
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt
  servicePackVersion   ServicePackVersion       @relation(fields: [servicePackVersionId], references: [id], onDelete: Cascade)

  @@unique([servicePackVersionId, componentKind, componentCode])
  @@index([servicePackVersionId])
  @@map("service_pack_components")
}

model ServicePackDependency {
  id                   String                          @id @default(uuid()) @db.Uuid
  servicePackVersionId String                          @db.Uuid
  dependencyKind       ServicePackDependencyKind
  dependencyCode       String
  referenceKind        String
  referenceId          String?                         @db.Uuid
  referenceCode        String?
  controlScope         ServicePackDependencyControlScope @default(EXTERNAL)
  isRequired           Boolean                         @default(true)
  manifestPath         String
  createdAt            DateTime                        @default(now())
  updatedAt            DateTime                        @updatedAt
  servicePackVersion   ServicePackVersion              @relation(fields: [servicePackVersionId], references: [id], onDelete: Cascade)

  @@unique([servicePackVersionId, dependencyCode])
  @@index([servicePackVersionId])
  @@index([referenceKind, referenceId])
  @@map("service_pack_dependencies")
}

model ServicePackValidationResult {
  id                    String                       @id @default(uuid()) @db.Uuid
  servicePackVersionId  String                       @db.Uuid

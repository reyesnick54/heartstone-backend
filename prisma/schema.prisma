model VitalEvent {
  id                           String                            @id @default(uuid()) @db.Uuid
  eventReference               String                            @unique
  eventType                    VitalEventType
  registrationStatus           VitalEventRegistrationStatus      @default(INTAKE_DRAFT)
  jurisdictionId               String                            @db.Uuid
  institutionId                String                            @db.Uuid
  eventDate                    DateTime?
  eventDatePrecision           String?
  registrationDate             DateTime?
  locationReference            String?
  applicationId                String?                           @db.Uuid
  caseId                       String?                           @db.Uuid
  governmentServiceId          String?                           @db.Uuid
  governingServicePackVersionId String?                          @db.Uuid
  registrarOfficeholderId      String?                           @db.Uuid
  registrarIdentityId          String?                           @db.Uuid
  primarySubjectCivilPersonRecordId String?                      @db.Uuid
  verificationState            CivilRegistryVerificationState    @default(UNVERIFIED)
  accessClassification         CivilRegistryAccessClassification @default(SUBJECT_ACCESS)
  provenanceSummary            Json                              @default("{}")
  createdAt                    DateTime                          @default(now())
  updatedAt                    DateTime                          @updatedAt
  jurisdiction                 Jurisdiction                      @relation(fields: [jurisdictionId], references: [id])
  institution                  Institution                       @relation(fields: [institutionId], references: [id])
  application                  Application?                      @relation(fields: [applicationId], references: [id])
  case                         Case?                             @relation(fields: [caseId], references: [id])
  governmentService            GovernmentService?                @relation(fields: [governmentServiceId], references: [id])
  governingServicePackVersion  ServicePackVersion?               @relation("VitalEventGoverningServicePack", fields: [governingServicePackVersionId], references: [id])
  registrarOfficeholder        Officeholder?                     @relation("VitalEventRegistrarOfficeholder", fields: [registrarOfficeholderId], references: [id])
  registrarIdentity            Identity?                         @relation("VitalEventRegistrarIdentity", fields: [registrarIdentityId], references: [id])
  primarySubject               CivilPersonRecord?                @relation("VitalEventPrimarySubject", fields: [primarySubjectCivilPersonRecordId], references: [id])
  birthEvent                   BirthEvent?
  deathEvent                   DeathEvent?
  marriageEvent                MarriageEvent?
  divorceEvent                 DivorceEvent?
  civilStatusRecords           CivilStatusRecord[]
  relationships                CivilRecordRelationship[]
  evidenceLinks                VitalEventEvidenceLink[]
  sourceReferences             CivilRegistrySourceReference[]
  verifications                CivilRegistryVerification[]
  registryEntry                CivilRegistryEntry?
  auditEvents                  CivilRegistryAuditEvent[]


  sentAt                                      DateTime?
  authenticationStatus                        GovernmentCommunicationAuthenticationStatus @default(UNAUTHENTICATED)
  scope                                       String?
  effectiveFrom                               DateTime?
  effectiveUntil                              DateTime?
  limitations                                 String?
  caseReferralId                              String?                                   @db.Uuid
  retainedDeterminationForExternalAuthorityId String?                                   @db.Uuid
  createdAt                                   DateTime                                  @default(now())
  updatedAt                                   DateTime                                  @updatedAt

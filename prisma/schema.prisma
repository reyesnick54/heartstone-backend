  createdAt            DateTime           @default(now())
  civilRegistryEntry   CivilRegistryEntry @relation(fields: [civilRegistryEntryId], references: [id], onDelete: Restrict)
  creatingAmendment    CivilRecordAmendment? @relation("AmendmentNewVersion")
  previousAmendments   CivilRecordAmendment[] @relation("AmendmentPreviousVersion")
  certificateExtracts  CivilRegistryCertificateExtract[]

  @@unique([civilRegistryEntryId, versionNumber])
  @@index([civilRegistryEntryId])
  @@index([isCurrent])
  @@map("civil_registry_versions")
}

model CivilRecordAmendment {

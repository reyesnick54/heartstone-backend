  @@index([organizationId])
  @@index([shipmentId])
  @@index([status])
  @@map("customs_declarations")
}

model CustomsDeclarationVersion {
  id                    String              @id @default(uuid()) @db.Uuid
  customsDeclarationId  String              @db.Uuid
  versionNumber         Int
  isAmendment           Boolean             @default(false)

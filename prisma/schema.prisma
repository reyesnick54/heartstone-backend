  toDefinitionId      String                      @db.Uuid
  relationshipType    DigitalTwinRelationshipType
  isModeledOnly       Boolean                     @default(true)
  notes               String?
  createdAt           DateTime                    @default(now())
  fromDefinition      DigitalTwinDefinition       @relation("DigitalTwinRelationshipFrom", fields: [fromDefinitionId], references: [id], onDelete: Cascade)
  toDefinition        DigitalTwinDefinition       @relation("DigitalTwinRelationshipTo", fields: [toDefinitionId], references: [id], onDelete: Cascade)

  @@unique([fromDefinitionId, toDefinitionId, relationshipType])
  @@index([fromDefinitionId])
  @@index([toDefinitionId])
  @@map("digital_twin_relationships")
}

model DigitalTwinModeRecord {
  id                    String             @id @default(uuid()) @db.Uuid
  twinVersionId         String             @db.Uuid

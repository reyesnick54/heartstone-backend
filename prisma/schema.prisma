model RiskReview {
  id                 String         @id @default(uuid()) @db.Uuid
  assessmentId       String         @db.Uuid
  reviewerIdentityId String         @db.Uuid
  reviewNotes        String?
  reviewedAt         DateTime       @default(now())
  createdAt          DateTime       @default(now())
  assessment         RiskAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  reviewer           Identity       @relation("RiskReviewer", fields: [reviewerIdentityId], references: [id])

  @@index([assessmentId])
  @@map("risk_reviews")
}


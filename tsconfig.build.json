{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "noEmit": false,
    "declaration": true,
    "declarationMap": true,
    "types": ["node"]
  },
  "include": ["src/**/*.ts"],
  "exclude": [
    "node_modules",
    "dist",
    "test",
    "tests",
    "**/*.spec.ts",
    "**/*.test.ts",
    "src/applications/**",
    "src/workflows/**",
    "src/application-processing/cases/timeline/**",
    "src/application-processing/cases/case-foundation.service.ts"
  ]
}
